/* ===========================================================
   蛋宝宝小程序 · 全局样式
   ===========================================================
   单位换算：设计稿按 375px（iPhone 标准宽度）绘制，微信小程序
   标准设备宽度为 750rpx，因此换算比例固定为 —— 设计 px × 2 = rpx。
   本项目所有 wxss 内的 rpx 数值均已按此比例换算并写死。

   颜色 token 对照表（来自 eggbabe Design System，色值直接写死到
   各组件/页面样式中，此处仅作对照参考，不是可引用的变量）：
     --ink            #002900   主文字 / 主要按钮
     --ink-pressed     #001A00   按钮按下态
     --egg-green       #9DB65B   品牌绿（switch 开启态）
     --egg-yellow      #EDE78E   蛋壳渐变色 1
     --egg-pink        #F4B9AE   蛋壳渐变色 2
     --canvas          #FFFFFF   卡片/页面底色
     --text            #1A1A1A  一级文字
     --text-muted      #5C5C5C  二级文字
     --text-faint      #8C8C88  三级文字/说明
     --hairline        #E5E3DF  分隔线
     --hairline-strong #CFCBC4  强调分隔线
     --ink-surface     #E5EBE5  中性提示底色
     --error           #D9463C  危险色
     --error-surface   #FDECEA  危险底色
     --green-surface   #F5F8ED  绿色提示底色
     --green-on-tint   #54632C  绿色提示文字
     --yellow-surface  #FAFAEF  黄色提示底色
     --yellow-on-tint  #6E6B35  黄色提示文字
     --pink-surface    #FFF6F5  回忆 / 羁绊底色
     --pink-on-tint    #80625D  回忆 / 羁绊文字

   字体：中文统一使用 'PingFang SC'（iOS）/'Microsoft YaHei'（兜底），
   最高字重 600 —— PingFang SC 没有真正的粗体，切勿设置 700。

   按钮形状与尺寸：
     --button-circle-size 112rpx  独立紧凑 / 悬浮入口统一圆形尺寸
     --button-pill-height  96rpx  文字 CTA 统一胶囊高度
     --button-group-item   112rpx 成组胶囊内每个功能区的统一高度 / 宽度
   按钮只使用圆形（50%）或胶囊（999rpx），中圆角仅供卡片、输入框、
   弹窗等非按钮表面使用。
   =========================================================== */

page {
  height: 100%;
  background: #FAFAF8;
  color: #1A1A1A;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  font-family: inherit;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  line-height: normal !important;
  padding-top: 0;
  padding-bottom: 0;
}

/* 统一修正微信原生 button 的文字基线：页面即使遗留 height=line-height，
   也由这里强制转为真正的水平 / 垂直居中。 */
button > text {
  line-height: 1;
}

/* 所有原生文字按钮采用同一套轻按反馈；组件按钮在自身作用域复用相同参数。 */
button {
  transition: transform 0.16s ease-out, opacity 0.16s ease-out;
}

.button-press {
  opacity: 0.9;
  transform: scale(0.98);
}

.button-label {
  display: block;
  line-height: 1;
  transform: translateY(-2rpx);
  text-align: center;
}

.page-safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: #8C8C88;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.pressable--pressed {
  opacity: 0.72;
  transform: scale(0.98);
}

@media (prefers-reduced-motion: reduce) {
  button { transition: none; }
  .button-press { transform: none; }
}
