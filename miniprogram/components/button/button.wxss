/* 自定义组件宿主节点默认不带 display/width，必须显式声明，
   否则在 flex 居中容器里宿主会塌陷成内容宽度，胶囊只剩文字那么宽
   （首页空态「添加蛋宝宝」按钮溢出就是这个原因）。 */
:host {
  display: block;
  width: 100%;
}

.btn {
  width: 100%;
  height: 96rpx; /* 统一文字 CTA：48px */
  border-radius: 999rpx; /* --radius-full */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.16s ease-out, opacity 0.16s ease-out;
}

.btn--pressed {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-icon {
  display: block;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx; /* 15px */
  font-weight: 600;
  line-height: 1;
  transform: translateY(-2rpx);
}

.btn--primary {
  background: #002900; /* --ink */
}
.btn--primary .btn-text {
  color: #FFFFFF;
}

.btn--secondary {
  background: transparent;
  border: 3rpx solid #002900; /* --ink */
}
.btn--secondary .btn-text {
  color: #002900; /* --ink */
}

.btn--danger {
  background: #D9463C; /* --error */
}
.btn--danger .btn-text {
  color: #FFFFFF;
}

.btn--disabled {
  opacity: 0.4;
}

@media (prefers-reduced-motion: reduce) {
  .btn { transition: none; }
  .btn--pressed { transform: none; }
}

/* 邀请信件的小按钮；未指定 size 的原有按钮保持原样。 */
.btn--small { height: 80rpx; padding: 0 36rpx; }
.btn--small .btn-text { font-size: 28rpx; font-weight: 500; letter-spacing: 0; }
.btn--small.btn--text-icon { padding: 0 20rpx; }
.btn-icon--text { display: flex; align-items: center; justify-content: center; font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif; font-size: 36rpx; font-weight: 400; line-height: 1; }
