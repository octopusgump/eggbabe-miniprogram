.companion-roll-number{display:inline-block;font-size:inherit;font-weight:inherit;line-height:inherit;color:inherit;transform-origin:50% 65%;transition:transform 80ms ease-out}
.companion-roll-number--rolling{animation:companion-roll-number-tick 320ms ease-out infinite}
@keyframes companion-roll-number-tick{0%,100%{transform:translate3d(0,0,0)}40%{transform:translate3d(0,-2rpx,0)}}
