:host{display:inline-block;flex:none;line-height:0;vertical-align:middle}
.companion-star{position:relative;z-index:0;pointer-events:none}
.companion-star__body{position:absolute;z-index:1;inset:0}
.companion-star__pose{position:absolute;inset:0;width:100%;height:100%;display:block;transform-origin:50% 50%;backface-visibility:hidden}
.companion-star__pose--squeezed{opacity:0}
.companion-star__halo{position:absolute;z-index:0;left:-50%;top:-50%;width:200%;height:200%;border-radius:50%;opacity:0;background:radial-gradient(circle,rgba(255,221,121,.95) 0,rgba(247,204,110,.5) 34%,rgba(243,187,90,0) 70%)}
.companion-star__spark,.companion-star__dust{position:absolute;z-index:2;border-radius:50%;opacity:0;background:#FFE7A3;box-shadow:0 0 8rpx rgba(255,221,121,.9)}

/* 信件收星：0.1–0.3 秒横向挤压，0.4 秒弹出，0.8 秒落定；两张 PNG 在尺寸相等的帧上硬切，避免重影与跳边。 */
.companion-star--award .companion-star__body{animation:companion-star-enter .8s linear both}
.companion-star--award .companion-star__pose--neutral{animation:companion-star-neutral-shape .8s ease-in-out both,companion-star-neutral-show .8s step-end both}
.companion-star--award .companion-star__pose--squeezed{animation:companion-star-squeezed-shape .8s ease-in-out both,companion-star-squeezed-show .8s step-end both}
.companion-star--award .companion-star__halo{animation:companion-star-award-halo 1.6s ease-out both}
/* 光点按信纸上方 150rpx（20vw）星星布置：7 个、5–8rpx，上浮约 0.25–0.45 倍星宽。 */
.companion-star__spark--1{left:-20rpx;top:70rpx;width:6rpx;height:6rpx;animation:companion-star-rise-l .8s ease-out .26s both}
.companion-star__spark--2{left:30rpx;top:20rpx;width:5rpx;height:5rpx;animation:companion-star-rise-m .7s ease-out .3s both}
.companion-star__spark--3{left:118rpx;top:28rpx;width:6rpx;height:6rpx;animation:companion-star-rise-s .7s ease-out .34s both}
.companion-star__spark--4{left:-8rpx;top:112rpx;width:5rpx;height:5rpx;animation:companion-star-rise-l .8s ease-out .42s both}
.companion-star__spark--5{left:76rpx;top:4rpx;width:8rpx;height:8rpx;animation:companion-star-rise-s .75s ease-out .46s both}
.companion-star__spark--6{left:156rpx;top:84rpx;width:5rpx;height:5rpx;animation:companion-star-rise-m .7s ease-out .52s both}
.companion-star__spark--7{left:46rpx;top:128rpx;width:6rpx;height:6rpx;animation:companion-star-rise-m .8s ease-out .6s both}

/* 房间左上角：常驻极轻呼吸光；关信件时光晕亮一下并落入 3 粒光尘，星体不位移、不放大。 */
/* 视觉 22rpx，占位约等于原 ✦ 字形宽度（≈0.8em），不挤压“陪伴星星”文字。 */
.companion-star--room{margin:0 -2rpx}
.companion-star--room .companion-star__halo{animation:companion-star-breathe 3.8s ease-in-out infinite}
.companion-star--room.companion-star--pulse .companion-star__halo{animation:companion-star-room-pulse 1.2s ease-out both}
.companion-star--room.companion-star--pulse .companion-star__pose--neutral{animation:companion-star-room-brighten 1.2s ease-out both}
.companion-star__dust{width:3rpx;height:3rpx}
.companion-star__dust--1{left:calc(50% + 12rpx);top:calc(50% - 16rpx);animation:companion-star-dust-1 .8s ease-in both}
.companion-star__dust--2{left:calc(50% - 9rpx);top:calc(50% - 17rpx);animation:companion-star-dust-2 .8s ease-in .12s both}
.companion-star__dust--3{left:calc(50% + 17rpx);top:calc(50% - 8rpx);animation:companion-star-dust-3 .8s ease-in .24s both}

.companion-star--reduced .companion-star__body,.companion-star--reduced .companion-star__pose{animation:none!important;opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.companion-star__body,.companion-star__pose,.companion-star__halo,.companion-star__spark,.companion-star__dust{animation:none!important}.companion-star__pose--squeezed,.companion-star__spark,.companion-star__dust,.companion-star__halo{opacity:0}}

@keyframes companion-star-enter{0%{opacity:0}7.5%{opacity:1}100%{opacity:1}}
@keyframes companion-star-neutral-shape{
  0%{transform:translate3d(0,0,0) scale(.9,.9)}
  7.5%{transform:translate3d(0,0,0) scale(1,1)}
  12.5%{transform:translate3d(0,0,0) scale(1,1)}
  16.25%{transform:translate3d(0,0,0) scale(.85,1.02)}
  40%{transform:translate3d(0,0,0) scale(.8,1.03)}
  50%{transform:translate3d(0,-8%,0) scale(1.12,1.07)}
  65%{transform:translate3d(0,0,0) scale(.97,.98)}
  80%{transform:translate3d(0,0,0) scale(1.02,1.01)}
  100%{transform:translate3d(0,0,0) scale(1,1)}
}
@keyframes companion-star-neutral-show{0%{opacity:1}16.25%{opacity:0}40%{opacity:1}100%{opacity:1}}
/* 挤压图宽为自然图 0.724、高为 0.971；换图瞬间两者显示宽高一致（0.85×1.02、0.80×1.03）。 */
@keyframes companion-star-squeezed-shape{
  0%{transform:translate3d(0,0,0) scale(1.174,1.05)}
  16.25%{transform:translate3d(0,0,0) scale(1.174,1.05)}
  25%{transform:translate3d(0,0,0) scale(1,1.071)}
  35%{transform:translate3d(0,0,0) scale(1,1.071)}
  40%{transform:translate3d(0,0,0) scale(1.105,1.061)}
  100%{transform:translate3d(0,0,0) scale(1.105,1.061)}
}
@keyframes companion-star-squeezed-show{0%{opacity:0}16.25%{opacity:1}40%{opacity:0}100%{opacity:0}}
@keyframes companion-star-award-halo{0%{opacity:0;transform:scale(.7)}6%{opacity:.05;transform:scale(.8)}25%{opacity:.22;transform:scale(1)}56%{opacity:.12;transform:scale(1.04)}100%{opacity:0;transform:scale(1.06)}}
@keyframes companion-star-rise-s{0%{opacity:0;transform:translate3d(0,0,0) scale(.6)}25%{opacity:.42;transform:translate3d(0,-10rpx,0) scale(1)}100%{opacity:0;transform:translate3d(4rpx,-38rpx,0) scale(.7)}}
@keyframes companion-star-rise-m{0%{opacity:0;transform:translate3d(0,0,0) scale(.6)}25%{opacity:.38;transform:translate3d(3rpx,-14rpx,0) scale(1)}100%{opacity:0;transform:translate3d(10rpx,-52rpx,0) scale(.7)}}
@keyframes companion-star-rise-l{0%{opacity:0;transform:translate3d(0,0,0) scale(.6)}25%{opacity:.4;transform:translate3d(-3rpx,-18rpx,0) scale(1)}100%{opacity:0;transform:translate3d(-10rpx,-66rpx,0) scale(.7)}}
@keyframes companion-star-breathe{0%{opacity:.05}50%{opacity:.16}100%{opacity:.05}}
@keyframes companion-star-room-pulse{0%{opacity:.05;transform:scale(1)}17%{opacity:.45;transform:scale(1.12)}100%{opacity:.05;transform:scale(1)}}
@keyframes companion-star-room-brighten{0%{filter:brightness(1)}17%{filter:brightness(1.14)}100%{filter:brightness(1)}}
@keyframes companion-star-dust-1{0%{opacity:0;transform:translate3d(0,0,0)}35%{opacity:.35}100%{opacity:0;transform:translate3d(-12rpx,16rpx,0)}}
@keyframes companion-star-dust-2{0%{opacity:0;transform:translate3d(0,0,0)}35%{opacity:.32}100%{opacity:0;transform:translate3d(9rpx,17rpx,0)}}
@keyframes companion-star-dust-3{0%{opacity:0;transform:translate3d(0,0,0)}35%{opacity:.3}100%{opacity:0;transform:translate3d(-17rpx,8rpx,0)}}
