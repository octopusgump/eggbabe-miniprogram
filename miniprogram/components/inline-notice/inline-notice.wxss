.inline-notice { min-height: 64rpx; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid rgba(221,225,214,.96); border-radius: 999rpx; background: rgba(255,255,255,.94); box-shadow: 0 8rpx 24rpx rgba(44,53,39,.12); color: #3D4930; opacity: 0; pointer-events: none; transition: opacity 180ms ease-out; -webkit-backdrop-filter: blur(12rpx); backdrop-filter: blur(12rpx); }
.inline-notice--visible { opacity: 1; }
.inline-notice--warning { border-color: rgba(236,211,186,.96); background: rgba(255,244,232,.96); color: #875A3E; }
.inline-notice__text { font-size: 22rpx; font-weight: 600; line-height: 1.25; white-space: nowrap; }

@media (prefers-reduced-motion: reduce) {
  .inline-notice { transition: none; }
}
