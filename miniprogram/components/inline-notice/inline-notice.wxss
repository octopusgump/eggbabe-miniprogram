.inline-notice { min-height: 64rpx; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.16); border-radius: 999rpx; background: rgba(18,21,18,.72); box-shadow: 0 8rpx 24rpx rgba(0,0,0,.18); color: #FFF; opacity: 0; pointer-events: none; transition: opacity 180ms ease-out; -webkit-backdrop-filter: blur(12rpx); backdrop-filter: blur(12rpx); }
.inline-notice--visible { opacity: 1; }
.inline-notice--warning { border-color: rgba(255,218,196,.3); background: rgba(39,27,23,.78); color: #FFF; }
.inline-notice__text { font-size: 22rpx; font-weight: 600; line-height: 1.25; white-space: nowrap; }
.inline-notice--pill-fill { width: 100%; height: 100%; min-height: 0; min-width: 0; padding: 14rpx 28rpx; border-radius: 999rpx; box-shadow: 0 4rpx 16rpx rgba(54, 71, 61, 0.08); overflow: hidden; }
.inline-notice--pill-fill .inline-notice__text { display: block; width: 100%; font-size: 24rpx; font-weight: 500; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }

@media (prefers-reduced-motion: reduce) {
  .inline-notice { transition: none; }
}
