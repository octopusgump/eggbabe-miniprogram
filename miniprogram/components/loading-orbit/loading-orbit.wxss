.loading-orbit {
  position: relative;
  display: inline-block;
  flex: none;
  vertical-align: middle;
}

.loading-orbit--S {
  width: 60rpx;
  height: 60rpx;
}

.loading-orbit--M {
  width: 96rpx;
  height: 96rpx;
}

.loading-orbit--L {
  width: 168rpx;
  height: 168rpx;
}

.loading-orbit__track,
.loading-orbit__spin {
  position: absolute;
  left: 50%;
  top: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.loading-orbit__track {
  border-style: solid;
  border-radius: 50%;
  background: transparent;
}

.loading-orbit--light .loading-orbit__track {
  border-color: #E5E3DF;
}

.loading-orbit--dark .loading-orbit__track {
  border-color: rgba(255, 255, 255, 0.24);
}

.loading-orbit--S .loading-orbit__track,
.loading-orbit--S .loading-orbit__spin {
  width: 48rpx;
  height: 48rpx;
}

.loading-orbit--S .loading-orbit__track {
  border-width: 4rpx;
}

.loading-orbit--S .loading-orbit__dot {
  width: 12rpx;
  height: 12rpx;
}

.loading-orbit--M .loading-orbit__track,
.loading-orbit--M .loading-orbit__spin {
  width: 80rpx;
  height: 80rpx;
}

.loading-orbit--M .loading-orbit__track {
  border-width: 5rpx;
}

.loading-orbit--M .loading-orbit__dot {
  width: 16rpx;
  height: 16rpx;
}

.loading-orbit--L .loading-orbit__track,
.loading-orbit--L .loading-orbit__spin {
  width: 144rpx;
  height: 144rpx;
}

.loading-orbit--L .loading-orbit__track {
  border-width: 6rpx;
}

.loading-orbit--L .loading-orbit__dot {
  width: 24rpx;
  height: 24rpx;
}

/* Track 固定；仅 Spin 层旋转（点挂在 Spin 顶缘，静帧 12 点）。
   Figma Spin 614:2861 / 614:2866 / 614:2870 导出 2s linear infinite；
   设计师交接周期约 1.1s — 实现以 1.1s 为准。 */
.loading-orbit__spin {
  animation: loading-orbit-spin 1.1s linear infinite;
}

.loading-orbit__dot {
  position: absolute;
  left: 50%;
  top: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.loading-orbit--light .loading-orbit__dot {
  background: #9DB65B;
}

.loading-orbit--dark .loading-orbit__dot {
  background: #FFFFFF;
}

@keyframes loading-orbit-spin {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .loading-orbit__spin {
    animation: none;
  }
}

.loading-orbit--reduced .loading-orbit__spin {
  animation: none;
}
