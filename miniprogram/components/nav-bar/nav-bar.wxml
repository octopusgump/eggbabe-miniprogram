<view class="navbar-root {{surface === 'canvas' ? 'navbar-root--canvas' : ''}}">
  <view class="status-bar" style="height:{{statusBarHeight}}px"></view>
  <view class="nav-row">
    <view wx:if="{{showBack}}" class="nav-side nav-side--back" hover-class="nav-side--back--pressed" aria-role="button" aria-label="返回上一页" bindtap="onBack">
      <image class="nav-back-icon" src="/assets/icons/nav-back-ink.svg" mode="aspectFit" aria-hidden="true"></image>
    </view>
    <view wx:else class="nav-side"></view>
    <view class="nav-title-slot">
      <view wx:if="{{titleInteractive}}" class="nav-title-action" hover-class="nav-title-action--pressed" hover-stay-time="80" aria-role="button" aria-label="{{titleAriaLabel || title}}" bindtap="onTitleTap">
        <text class="nav-title-text">{{title}}</text>
        <view class="nav-title-chevron" aria-hidden="true"></view>
      </view>
      <text wx:else class="nav-title-text">{{title}}</text>
    </view>
    <view class="nav-side"></view>
  </view>
</view>
