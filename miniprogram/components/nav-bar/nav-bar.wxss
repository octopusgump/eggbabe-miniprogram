.navbar-root {
  background: #FFFFFF; /* --canvas */
  flex-shrink: 0;
}

.status-bar {
  width: 100%;
}

.nav-row {
  height: 112rpx; /* 与圆形导航按钮等高 */
  display: flex;
  align-items: center;
  position: relative;
  border-bottom: 1rpx solid #E5E3DF; /* --hairline */
}

.nav-side {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-side--back {
  border-radius: 50%;
  transition: transform 180ms ease-out, background 180ms ease-out;
}

.nav-side--pressed {
  background: #F3F7E7;
  transform: scale(.98);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx; /* 15px */
  font-weight: 600;
  color: #002900; /* --ink */
}

.chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #002900;
  border-right: 3rpx solid #002900;
}

.chevron-back {
  transform: rotate(-135deg);
  margin-left: 8rpx;
}

.demo-chip { padding: 5rpx 10rpx; border-radius: 999rpx; background: #EEF2E3; color: #687548; font-size: 20rpx; font-weight: 600; letter-spacing: 1rpx; }

@media (prefers-reduced-motion: reduce) {
  .nav-side--back { transition: none; }
  .nav-side--pressed { transform: none; }
}
