<block wx:if="{{layout === 'post-hatch'}}">
  <view
    class="pet-mood-tab pet-mood-tab--post-hatch pet-mood-tab--{{roomCardPhase === 'expanded' ? 'expanded' : 'compact'}} pet-mood-tab--room-{{roomCardPhase}} pet-mood-tab--{{mood.tone || 'neutral'}} {{reducedMotion ? 'pet-mood-tab--reduced' : ''}} {{starAwardVisible ? 'pet-mood-tab--star-award' : ''}}"
    aria-role="button"
    aria-label="{{roomCardPhase === 'expanded' ? (petName + '，星星 ' + starRollValue + '，一起 ' + companionDays + ' 天，今日心情，' + mood.moodLabel + '，' + mood.text + '，点击收起') : (roomCardPhase === 'summary' ? (petName + '，星星 ' + starRollValue + '，一起 ' + companionDays + ' 天，今日心情，' + mood.moodLabel + '，点击查看详情') : ('星星 ' + starRollValue + '，一起 ' + companionDays + ' 天，点击查看今日陪伴详情'))}}"
    bindtap="onToggle"
  >
    <view class="pet-mood-tab__room-header {{roomCardPhase === 'minimal' ? 'pet-mood-tab__room-header--minimal' : ''}}">
      <view class="pet-mood-tab__room-stars">
        <companion-star mode="room" size="30" pulse="{{starAwardVisible}}" reduced-motion="{{reducedMotion}}"></companion-star>
        <companion-roll-number class="pet-mood-tab__room-amount" value="{{starRollValue}}" reduced-motion="{{reducedMotion}}"></companion-roll-number>
        <text wx:if="{{starAwardVisible && starGainLabel}}" class="pet-mood-tab__room-gain">{{starGainLabel}}</text>
      </view>
      <text class="pet-mood-tab__room-days">一起 {{companionDays}} 天</text>
    </view>
    <view class="pet-mood-tab__room-detail {{roomCardPhase === 'minimal' ? '' : 'pet-mood-tab__room-detail--open'}}">
      <text class="pet-mood-tab__name">{{petName}}</text>
      <view class="pet-mood-tab__mood-summary pet-mood-tab__mood-summary--post-hatch">
        <text class="pet-mood-tab__eyebrow">今日心情：</text>
        <text class="pet-mood-tab__icon">{{mood.icon}}</text>
        <text class="pet-mood-tab__mood-label">{{mood.moodLabel}}</text>
      </view>
    </view>
    <view wx:if="{{roomCardPhase === 'expanded'}}" class="pet-mood-tab__sentence {{contentVisible ? 'pet-mood-tab__sentence--visible' : ''}}" aria-hidden="{{!contentVisible}}">
      <text class="pet-mood-tab__text">{{mood.text}}</text>
      <text class="pet-mood-tab__ai-label">内容由 AI 生成</text>
    </view>
  </view>
</block>
<view
  wx:else
  class="pet-mood-tab pet-mood-tab--{{expanded ? 'expanded' : 'compact'}} pet-mood-tab--{{mood.tone || 'neutral'}} {{reducedMotion ? 'pet-mood-tab--reduced' : ''}}"
  aria-role="button"
  aria-label="{{todayCompanionEntry ? petName + '，今日心情，' + mood.moodLabel + '，陪伴星星 ' + starBalance + ' 颗，点击查看今日陪伴' : (expanded ? petName + '，今日心情，' + mood.moodLabel + '，陪伴星星 ' + starBalance + ' 颗，' + mood.text + '，点击收起' : petName + '，今日心情，' + mood.moodLabel + '，陪伴星星 ' + starBalance + ' 颗，点击查看详情')}}"
  bindtap="onToggle"
>
  <text wx:if="{{nameInteractive}}" class="pet-mood-tab__name pet-mood-tab__name--interactive" catchtap="onNameTap">{{petName}}</text>
  <text wx:else class="pet-mood-tab__name">{{petName}}</text>
  <view class="pet-mood-tab__mood-summary">
    <text class="pet-mood-tab__eyebrow">今日心情：</text>
    <text class="pet-mood-tab__icon">{{mood.icon}}</text>
    <text class="pet-mood-tab__mood-label">{{mood.moodLabel}}</text>
  </view>
  <view wx:if="{{starBalance >= 0}}" class="pet-mood-tab__star-summary">
    <view class="pet-mood-tab__star-count">
      <companion-star class="pet-mood-tab__star-icon" mode="room" size="22" pulse="{{starAwardVisible}}" reduced-motion="{{reducedMotion}}"></companion-star>
      <text class="pet-mood-tab__star-number">{{starBalance}}</text>
      <text class="pet-mood-tab__star-label">陪伴星星</text>
      <text wx:if="{{starAwardVisible}}" class="pet-mood-tab__star-award">+1</text>
    </view>
    <text class="pet-mood-tab__star-state">{{starClaimed ? '今日已收下' : '今日待收下'}}</text>
  </view>
  <view class="pet-mood-tab__sentence {{contentVisible ? 'pet-mood-tab__sentence--visible' : ''}}" aria-hidden="{{!contentVisible}}">
    <text class="pet-mood-tab__text">{{mood.text}}</text>
    <text class="pet-mood-tab__ai-label">内容由 AI 生成</text>
  </view>
  <text wx:if="{{starBalance >= 0 && contentVisible && starProgressText}}" class="pet-mood-tab__star-progress">{{starProgressText}}</text>
</view>
