.pet-mood-tab{display:inline-flex;width:218rpx;max-width:380rpx;flex-direction:column;align-items:stretch;padding:8rpx 14rpx 9rpx;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.72);border-radius:24rpx;background:rgba(255,253,247,.9);box-shadow:0 6rpx 18rpx rgba(37,46,35,.08),inset 0 1rpx 0 rgba(255,255,255,.58);color:#314238;overflow:hidden;transform:translate3d(0,0,0);transform-origin:0 0;will-change:width;transition:width 420ms cubic-bezier(.16,1,.3,1),padding 360ms cubic-bezier(.16,1,.3,1),border-radius 360ms ease,background 220ms ease}
.pet-mood-tab--expanded{width:380rpx;padding-top:10rpx;padding-bottom:8rpx;border-radius:28rpx}
.pet-mood-tab--compact{width:218rpx}
.pet-mood-tab--bright{background:rgba(255,252,239,.92)}
.pet-mood-tab--subdued{background:rgba(247,250,248,.92)}
.pet-mood-tab__name{display:block;max-width:100%;overflow:hidden;color:#294732;font-size:24rpx;font-weight:600;line-height:1.25;letter-spacing:.5rpx;text-overflow:ellipsis;white-space:nowrap}
.pet-mood-tab__mood-summary{display:flex;max-width:100%;align-items:center;overflow:hidden;margin-top:10rpx;white-space:nowrap}
.pet-mood-tab__eyebrow{flex:none;color:#748078;font-size:20rpx;font-weight:600;letter-spacing:.4rpx}
.pet-mood-tab__icon{flex:none;margin-right:5rpx;font-size:22rpx;line-height:1}
.pet-mood-tab__mood-label{overflow:hidden;color:#31463A;font-size:22rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.pet-mood-tab__star-summary{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-top:8rpx;padding-top:8rpx;border-top:1rpx solid rgba(116,128,120,.12);white-space:nowrap}
.pet-mood-tab__star-count{position:relative;display:flex;min-width:0;align-items:center;gap:5rpx;color:#725D2B}
.pet-mood-tab__star-icon{flex:none;line-height:0}
.pet-mood-tab__star-number{font-size:23rpx;font-weight:700;line-height:1}
.pet-mood-tab__star-label{overflow:hidden;color:#6E745F;font-size:18rpx;text-overflow:ellipsis}
.pet-mood-tab__star-state{flex:none;color:#879087;font-size:17rpx}
.pet-mood-tab__star-award{position:absolute;right:-22rpx;top:-18rpx;padding:2rpx 7rpx;border-radius:999rpx;background:#D6AE4B;color:#FFF;font-size:15rpx;font-weight:700;animation:pet-mood-star-rise .5s ease-out both}
.pet-mood-tab__star-progress{display:block;max-width:100%;margin-top:5rpx;overflow:hidden;color:#7A745F;font-size:17rpx;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}
.pet-mood-tab__sentence{width:0;max-height:0;overflow:hidden;margin-top:0;opacity:0;transform:translate3d(0,-5rpx,0);will-change:max-height,opacity,transform;transition:max-height 280ms cubic-bezier(.16,1,.3,1),margin-top 280ms cubic-bezier(.16,1,.3,1),opacity 140ms ease-out,transform 220ms cubic-bezier(.16,1,.3,1)}
.pet-mood-tab--expanded .pet-mood-tab__sentence{width:auto;max-width:100%}
.pet-mood-tab__sentence--visible{max-height:96rpx;margin-top:5rpx;opacity:1;transform:translate3d(0,0,0)}
.pet-mood-tab__text{display:block;color:#303A32;font-size:20rpx;line-height:1.35;overflow-wrap:anywhere;word-break:break-word}
.pet-mood-tab__ai-label{display:block;margin-top:4rpx;color:#8C8C88;font-size:17rpx;line-height:1.3}
.pet-mood-tab--reduced{transition:none}
.pet-mood-tab--reduced .pet-mood-tab__sentence{transition:none}
@media (max-width:340px){.pet-mood-tab--expanded{width:352rpx}.pet-mood-tab--compact{width:218rpx}.pet-mood-tab__text{font-size:20rpx}}
@media (prefers-reduced-motion:reduce){.pet-mood-tab{transition:none}}
@keyframes pet-mood-star-rise{from{opacity:0;transform:translateY(7rpx) scale(.86)}to{opacity:1;transform:translateY(0) scale(1)}}
.pet-mood-tab--post-hatch{width:auto;min-width:160rpx;max-width:408rpx;padding:22rpx 26rpx;border:1rpx solid rgba(225,229,215,.95);border-radius:28rpx;background:rgba(255,253,247,.92);box-shadow:0 6rpx 18rpx rgba(37,46,35,.08),inset 0 1rpx 0 rgba(255,255,255,.58);transform-origin:left top;overflow:hidden;transition:max-width 480ms cubic-bezier(.16,1,.3,1),padding 480ms cubic-bezier(.16,1,.3,1),border-radius 360ms cubic-bezier(.16,1,.3,1),box-shadow 360ms ease}
.pet-mood-tab--post-hatch.pet-mood-tab--compact{max-width:320rpx}
.pet-mood-tab--post-hatch.pet-mood-tab--expanded{width:408rpx;max-width:408rpx;padding:22rpx 26rpx 20rpx}
.pet-mood-tab--post-hatch.pet-mood-tab--star-award{animation:pet-mood-room-award 520ms ease-out both}
.pet-mood-tab__room-header{margin-bottom:14rpx;transition:margin-bottom 420ms cubic-bezier(.16,1,.3,1)}
.pet-mood-tab__room-header--minimal{margin-bottom:0}
.pet-mood-tab--post-hatch.pet-mood-tab--room-minimal{max-width:220rpx;padding:16rpx 22rpx}
.pet-mood-tab--post-hatch.pet-mood-tab--room-summary{max-width:320rpx}
.pet-mood-tab__room-detail{max-height:0;opacity:0;overflow:hidden;transform:translate3d(0,-10rpx,0);transition:max-height 460ms cubic-bezier(.16,1,.3,1),opacity 340ms cubic-bezier(.16,1,.3,1),transform 460ms cubic-bezier(.16,1,.3,1),margin-top 420ms cubic-bezier(.16,1,.3,1)}
.pet-mood-tab__room-detail--open{max-height:160rpx;opacity:1;transform:translate3d(0,0,0)}
.pet-mood-tab__room-stars{display:flex;align-items:center;gap:12rpx;font-size:42rpx;font-weight:600;color:#35483C}
.pet-mood-tab__room-amount{font-size:42rpx;font-weight:600;color:#35483C}
.pet-mood-tab__room-gain{margin-left:4rpx;font-size:28rpx;font-weight:600;line-height:1;color:#35483C;animation:pet-mood-room-gain-pop .72s ease-out both}
.pet-mood-tab__room-days{display:block;margin-top:8rpx;font-size:23rpx;color:#5A675E}
.pet-mood-tab--post-hatch .pet-mood-tab__name{margin-top:0;font-size:32rpx;color:#002900}
.pet-mood-tab--post-hatch .pet-mood-tab__mood-summary--post-hatch{margin-top:6rpx}
.pet-mood-tab--post-hatch .pet-mood-tab__sentence{width:0;max-height:0;margin-top:0;opacity:0;transform:translate3d(0,-8rpx,0);transition:max-height 420ms cubic-bezier(.16,1,.3,1),margin-top 420ms cubic-bezier(.16,1,.3,1),opacity 320ms cubic-bezier(.16,1,.3,1),transform 420ms cubic-bezier(.16,1,.3,1)}
.pet-mood-tab--post-hatch.pet-mood-tab--expanded .pet-mood-tab__sentence{width:auto;max-width:100%}
.pet-mood-tab--post-hatch .pet-mood-tab__sentence--visible{max-height:140rpx;margin-top:12rpx;opacity:1;transform:translate3d(0,0,0)}
.pet-mood-tab--post-hatch.pet-mood-tab--reduced,.pet-mood-tab--post-hatch.pet-mood-tab--reduced .pet-mood-tab__room-detail,.pet-mood-tab--post-hatch.pet-mood-tab--reduced .pet-mood-tab__room-header,.pet-mood-tab--post-hatch.pet-mood-tab--reduced .pet-mood-tab__sentence{transition:none}
.pet-mood-tab--post-hatch.pet-mood-tab--reduced.scene-status-chip--rebound{animation:none!important}
@keyframes pet-mood-room-gain-pop{0%{opacity:0;transform:translate3d(0,8rpx,0) scale(.88)}40%{opacity:1;transform:translate3d(0,-4rpx,0) scale(1.04)}100%{opacity:1;transform:translate3d(0,0,0) scale(1)}}
@keyframes pet-mood-room-award{0%{transform:scale(1)}35%{transform:scale(1.02)}100%{transform:scale(1)}}
