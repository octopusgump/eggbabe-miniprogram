.toolbox-chest {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  transform-origin: 50% 85%;
}

.toolbox-chest__frame {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
}

.toolbox-chest__frame--active {
  opacity: 1;
}

.toolbox-chest--pop-open {
  animation: toolbox-chest-pop-open 360ms ease-out both;
}

.toolbox-chest--pop-close {
  animation: toolbox-chest-pop-close 300ms ease-out both;
}

@keyframes toolbox-chest-pop-open {
  0% { transform: scale(1); }
  17% { transform: scale(0.94); }
  72% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

@keyframes toolbox-chest-pop-close {
  0% { transform: scale(1); }
  50% { transform: scale(0.97); }
  100% { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .toolbox-chest--pop-open,
  .toolbox-chest--pop-close {
    animation: none;
  }
}
