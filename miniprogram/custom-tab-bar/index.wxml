<view class="tab-bar">
  <view
    wx:for="{{items}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'tab-item--selected' : ''}}"
    data-index="{{index}}"
    aria-role="button"
    aria-label="{{item.text}}"
    bindtap="onSwitch"
  >
    <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit"></image>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
