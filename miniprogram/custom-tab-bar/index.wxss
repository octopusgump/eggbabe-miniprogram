.tab-bar {
  position: fixed;
  z-index: 70;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(136rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 34rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  background: transparent;
}
.tab-bar--elevated { z-index: 130; }
.tab-item {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(225,226,211,.9);
  border-radius: 50%;
  background: #FFF;
  box-shadow: 0 8rpx 24rpx rgba(43,55,39,.12), inset 0 1rpx 0 rgba(255,255,255,.72);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
  pointer-events: auto;
  transition: transform .16s ease, background .16s ease;
}
.tab-hint {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: calc(100% + 10rpx);
  width: 104rpx;
  padding: 9rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(225,226,211,.92);
  border-radius: 999rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 7rpx 20rpx rgba(43,55,39,.14);
  color: rgba(25,30,26,.96);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  opacity: 0;
  transform: translate(-50%, 6rpx);
  transition: opacity 180ms ease-out, transform 180ms ease-out;
  pointer-events: none;
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
}
.tab-hint--visible { opacity: 1; transform: translate(-50%, 0); }
.tab-item--pressed { background: #F7F7F4; opacity: .9; transform: scale(.98); }
.tab-icon { width: 62rpx; height: 62rpx; display: block; }

@media (prefers-reduced-motion: reduce) {
  .tab-item { transition: none; }
  .tab-hint { transition: none; }
  .tab-item--pressed { transform: none; }
}
