.tab-bar {
  position: fixed;
  z-index: 70;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(136rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 34rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  background: transparent;
}
.tab-item {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(226,226,216,.94);
  border-radius: 50%;
  background: rgba(255,253,247,.92);
  box-shadow: 0 8rpx 24rpx rgba(43,55,39,.12), inset 0 1rpx 0 rgba(255,255,255,.72);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
  pointer-events: auto;
  transition: transform .16s ease, background .16s ease;
}
.tab-item--pressed { background: rgba(238,243,228,.96); transform: scale(.96); }
.tab-icon { width: 44rpx; height: 44rpx; display: block; }

@media (prefers-reduced-motion: reduce) {
  .tab-item { transition: none; }
  .tab-item--pressed { transform: none; }
}
