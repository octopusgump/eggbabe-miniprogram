<view class="page">
  <nav-bar title="账号"></nav-bar>
  <view class="system-notice-anchor">
    <inline-notice
      text="{{systemNoticeText}}"
      tone="{{systemNoticeTone}}"
      visible="{{systemNoticeVisible}}"
    ></inline-notice>
  </view>

  <view class="content">

    <view class="panel">
      <list-row
        label="退出登录"
        show-chevron="{{false}}"
        show-border="{{false}}"
        bind:rowtap="onLogout"
      ></list-row>
    </view>

    <block wx:if="{{canClearLocalData}}">
      <view class="panel research-panel">
        <list-row
          label="清除本地数据"
          label-color="#B86B2F"
          show-chevron="{{false}}"
          show-border="{{false}}"
          bind:rowtap="onClearLocalData"
        ></list-row>
      </view>
      <text class="research-note">教研工具：清除后可重新体验绑定与孵化流程，不影响正式服务端数据。</text>
    </block>

    <view class="spacer"></view>

    <view class="panel danger-panel">
      <list-row
        label="注销账号"
        label-color="#D9463C"
        show-chevron="{{false}}"
        show-border="{{false}}"
        bind:rowtap="onDeregister"
      ></list-row>
    </view>

  </view>
</view>
