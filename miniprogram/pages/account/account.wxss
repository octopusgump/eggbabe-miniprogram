.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  background: #FAFAF8;
  box-sizing: border-box;
}

.panel {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid #E5E3DF;
  box-shadow: 0rpx 2rpx 4rpx rgba(0, 41, 0, 0.06), 0rpx 4rpx 8rpx rgba(0, 41, 0, 0.04);
}

.research-panel {
  margin-top: 24rpx;
}

.research-note {
  display: block;
  margin: 14rpx 12rpx 0;
  color: #8C8C88;
  font-size: 21rpx;
  line-height: 1.55;
}

.spacer {
  flex: 1;
}

.danger-panel {
  margin-bottom: 64rpx;
}
