<view class="page">
  <nav-bar title="我的收藏卡"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view class="collection-section">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">MY EGG</text>
          <text class="section-title">实体蛋纪念档案</text>
        </view>
      </view>

      <view wx:if="{{card}}" class="album-card" bindtap="onOpen">
        <view class="baby-mark">{{card.prototype === '锦鲤' || card.prototype === 'KOI' ? '锦' : '兔'}}</view>
        <view class="copy">
          <text class="name">{{card.display_name || card.name || '我的蛋宝宝'}}</text>
          <text class="meta">{{card.prototype}} · {{card.style}}</text>
          <text class="identity-note">一蛋一份 · 身份与纪念</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view wx:else class="identity-empty">
        <view class="identity-empty-mark">蛋</view>
        <view>
          <text class="identity-empty-title">收藏卡会在破壳后出现</text>
          <text class="identity-empty-copy">到达预设时间并完成承接后，这枚实体蛋唯一的纪念档案会保存在这里。</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
