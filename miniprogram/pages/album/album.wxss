.page { height: 100vh; background: #FAFAF8; }
.content { height: calc(100vh - 176rpx); padding: 32rpx 40rpx 60rpx; box-sizing: border-box; }
.collection-section { padding: 30rpx; border: 1rpx solid #E7E8E1; border-radius: 30rpx; background: #FFF; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.section-eyebrow, .section-title { display: block; }
.section-eyebrow { color: #8C8C88; font-size: 20rpx; letter-spacing: 4rpx; }
.section-title { margin-top: 6rpx; color: #1A1A1A; font-size: 31rpx; font-weight: 600; }
.album-card { min-height: 150rpx; display: flex; align-items: center; gap: 20rpx; padding: 22rpx; border-radius: 24rpx; background: linear-gradient(145deg, #F4F7EC, #FFF9EE); }
.baby-mark, .identity-empty-mark { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 50%; background: #E4ECCF; color: #4A6545; font-size: 30rpx; }
.copy { min-width: 0; flex: 1; }
.name, .meta, .identity-note, .identity-empty-title, .identity-empty-copy { display: block; }
.name { color: #1A1A1A; font-size: 29rpx; font-weight: 600; }
.meta, .identity-note { margin-top: 6rpx; color: #7A8279; font-size: 20rpx; }
.arrow { color: #8D948B; font-size: 42rpx; }
.identity-empty { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; border-radius: 24rpx; background: #F7F7F2; }
.identity-empty-title { color: #39453C; font-size: 26rpx; font-weight: 600; }
.identity-empty-copy { margin-top: 8rpx; color: #80857E; font-size: 20rpx; line-height: 1.55; }
