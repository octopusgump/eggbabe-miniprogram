.page{height:100vh;background:#FAFAF8;overflow:hidden}.tabs{display:flex;margin:20rpx 40rpx 0;padding:8rpx;border-radius:999rpx;background:#EBEEE8}.tab{flex:1;height:70rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;font-size:25rpx;color:#657067}.tab--active{background:#fff;color:#3F5A47;font-weight:600;box-shadow:0 6rpx 18rpx rgba(45,69,50,.08)}.content{height:calc(100vh - 250rpx);padding:32rpx 40rpx 0;box-sizing:border-box}.album-card{display:flex;align-items:center;padding:28rpx;border-radius:30rpx;background:linear-gradient(145deg,#FFFDF2,#F9D8D1);box-shadow:0 16rpx 36rpx rgba(0,41,0,.1)}.baby-mark{width:120rpx;height:150rpx;border-radius:52% 48% 48% 52%/61% 59% 41% 39%;background:#3F5A47;color:#F1EC9A;display:flex;align-items:center;justify-content:center;font-size:44rpx}.copy{flex:1;margin-left:26rpx}.name{display:block;font-size:32rpx;font-weight:600}.meta{display:block;margin-top:10rpx;font-size:23rpx;color:#77756E}.serial{display:block;margin-top:18rpx;font-size:18rpx;color:#929087}.arrow{font-size:42rpx;color:#8A8D6F}.scene-grid{display:grid;grid-template-columns:1fr 1fr;gap:26rpx}.scene-card{min-width:0;padding:18rpx 18rpx 22rpx;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 28rpx rgba(42,61,47,.08)}.scene-card--locked{background:#F1F0EA;box-shadow:none}.scene-art{position:relative;height:360rpx;border-radius:22rpx;overflow:hidden;display:flex;align-items:center;justify-content:center}.scene-card-image{width:100%;height:100%}.locked-art{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,#F4F1E7,#E6E9DE)}.locked-number{font-size:18rpx!important;letter-spacing:2rpx;color:#98998F!important}.locked-mark{margin-top:20rpx;font-size:58rpx!important;color:#A7AA9F!important}.collector-chip{position:absolute;left:12rpx;bottom:12rpx;padding:7rpx 11rpx;border-radius:999rpx;background:rgba(255,255,255,.9);font-size:16rpx!important;letter-spacing:1rpx;color:#425448!important}.scene-name{display:block;margin-top:18rpx;font-size:26rpx;color:#1A1A1A;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.scene-meta{display:block;margin-top:8rpx;font-size:20rpx;color:#86877F}.copy-code{display:block;margin-top:8rpx;font-size:15rpx;color:#A09E96;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.set-overview{margin-bottom:30rpx;padding:28rpx;border-radius:30rpx;background:linear-gradient(145deg,#FFFDF4,#EEF1E7);box-shadow:0 12rpx 32rpx rgba(42,61,47,.07)}.set-code{display:block;font-size:18rpx;letter-spacing:3rpx;color:#788078}.set-name{display:block;margin-top:8rpx;font-size:31rpx;font-weight:600;color:#26372C}.set-progress{margin-top:20rpx;color:#3F5A47}.set-progress>text:first-child{font-size:42rpx;font-weight:600}.set-progress-total{font-size:24rpx}.progress-track{height:10rpx;margin-top:13rpx;border-radius:999rpx;background:rgba(63,90,71,.12);overflow:hidden}.progress-value{height:100%;border-radius:999rpx;background:#3F5A47;transition:width .4s ease}.set-note{display:block;margin-top:16rpx;font-size:19rpx;color:#85877F}.empty{display:flex;flex-direction:column;align-items:center;padding-top:150rpx;text-align:center}.empty-card{width:210rpx;height:290rpx;border-radius:28rpx;border:3rpx dashed #CFCBC4;background:#FFF}.empty-card--scene{background:linear-gradient(145deg,#F1EC9A,#FFC5BA)}.empty-title{margin-top:42rpx;font-size:34rpx;font-weight:600}.empty-desc{margin-top:16rpx;width:470rpx;font-size:24rpx;line-height:1.65;color:#8C8C88}.safe-space{height:calc(80rpx + env(safe-area-inset-bottom))}
.card-actions{display:flex;gap:10rpx;margin-top:16rpx}.card-action{flex:1;height:56rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#F2F5EF;color:#3F5A47;font-size:21rpx}.card-share{padding:0;margin:0;line-height:56rpx;border:0}.card-share::after{border:0}.card-share .button-label{font-size:21rpx;font-weight:400}.set-panel{margin-top:34rpx;padding:28rpx;border-radius:28rpx;background:#fff}.set-panel--complete{background:linear-gradient(145deg,#FFFBE6,#EEF1E7)}.set-title{display:block;margin-bottom:12rpx;font-size:28rpx;font-weight:600;color:#253B2D}.complete-copy{font-size:22rpx;line-height:1.6;color:#74766F}.unlock-cta{height:82rpx;margin-top:24rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#3F5A47;color:#fff;font-size:25rpx}
.copy-detail{display:flex;justify-content:space-between;gap:8rpx;margin-top:9rpx;color:#6F7C71;font-size:17rpx;line-height:1.4}
.preview-all{height:76rpx;margin-top:22rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#3F5A47;color:#FFF;font-size:23rpx;font-weight:600}
