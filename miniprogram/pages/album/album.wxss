.page { height: 100vh; overflow: hidden; background: #FAFAF8; }
.content { height: calc(100vh - 180rpx); padding: 28rpx 40rpx 0; box-sizing: border-box; }
.collection-section { margin-bottom: 48rpx; }
.series-section { padding-top: 4rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 22rpx; }
.section-eyebrow { display: block; color: #92978F; font-size: 16rpx; letter-spacing: 3rpx; }
.section-title { display: block; margin-top: 6rpx; color: #26372C; font-size: 31rpx; font-weight: 600; }
.section-count { color: #6F7C71; font-size: 21rpx; }

.album-card { display: flex; align-items: center; padding: 28rpx; border-radius: 30rpx; background: linear-gradient(145deg, #FFFDF2, #F9D8D1); box-shadow: 0 16rpx 36rpx rgba(0, 41, 0, .1); }
.baby-mark { width: 120rpx; height: 150rpx; display: flex; align-items: center; justify-content: center; border-radius: 52% 48% 48% 52% / 61% 59% 41% 39%; background: #3F5A47; color: #F1EC9A; font-size: 44rpx; }
.copy { flex: 1; margin-left: 26rpx; }
.name { display: block; font-size: 32rpx; font-weight: 600; }
.meta { display: block; margin-top: 10rpx; color: #77756E; font-size: 23rpx; }
.identity-note { display: block; margin-top: 15rpx; color: #8B8A82; font-size: 18rpx; }
.arrow { color: #8A8D6F; font-size: 42rpx; }
.identity-empty { display: flex; align-items: center; gap: 24rpx; padding: 26rpx; border-radius: 28rpx; background: #F1F0EA; }
.identity-empty-mark { width: 82rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 50% 50% 46% 46%; background: #FFFDF7; color: #9DA197; font-size: 28rpx; }
.identity-empty-title, .identity-empty-copy { display: block; }
.identity-empty-title { color: #525A53; font-size: 25rpx; }
.identity-empty-copy { max-width: 430rpx; margin-top: 8rpx; color: #8A8E87; font-size: 20rpx; line-height: 1.5; }

.set-overview { margin-bottom: 30rpx; padding: 28rpx; border-radius: 30rpx; background: linear-gradient(145deg, #FFFDF4, #EEF1E7); box-shadow: 0 12rpx 32rpx rgba(42, 61, 47, .07); }
.set-code { display: block; color: #788078; font-size: 18rpx; letter-spacing: 3rpx; }
.set-name { display: block; margin-top: 8rpx; color: #26372C; font-size: 31rpx; font-weight: 600; }
.set-progress { margin-top: 20rpx; color: #3F5A47; }
.set-progress > text:first-child { font-size: 42rpx; font-weight: 600; }
.set-progress-total { font-size: 24rpx; }
.progress-track { height: 10rpx; overflow: hidden; margin-top: 13rpx; border-radius: 999rpx; background: rgba(63, 90, 71, .12); }
.progress-value { height: 100%; border-radius: 999rpx; background: #3F5A47; transition: width .4s ease; }
.set-note { display: block; margin-top: 16rpx; color: #85877F; font-size: 19rpx; }
.preview-all { height: 76rpx; display: flex; align-items: center; justify-content: center; margin-top: 22rpx; border-radius: 999rpx; background: #3F5A47; color: #FFF; font-size: 23rpx; font-weight: 600; }

.scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26rpx; }
.scene-card { min-width: 0; padding: 18rpx 18rpx 22rpx; border-radius: 28rpx; background: #FFF; box-shadow: 0 12rpx 28rpx rgba(42, 61, 47, .08); }
.scene-card--locked { background: #F1F0EA; box-shadow: none; }
.scene-art { position: relative; height: 360rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; }
.scene-card-image { width: 100%; height: 100%; }
.locked-art { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(145deg, #F4F1E7, #E6E9DE); }
.locked-number { color: #98998F !important; font-size: 18rpx !important; letter-spacing: 2rpx; }
.locked-mark { margin-top: 20rpx; color: #A7AA9F !important; font-size: 58rpx !important; }
.collector-chip { position: absolute; left: 12rpx; bottom: 12rpx; padding: 7rpx 11rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .9); color: #425448 !important; font-size: 16rpx !important; letter-spacing: 1rpx; }
.scene-name { display: block; overflow: hidden; margin-top: 18rpx; color: #1A1A1A; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.scene-meta { display: block; margin-top: 8rpx; color: #86877F; font-size: 20rpx; }
.scene-serial { display: block; margin-top: 4rpx; color: #A2A59E; font-size: 18rpx; line-height: 1.35; overflow-wrap: anywhere; }
.copy-detail { display: flex; justify-content: space-between; gap: 8rpx; margin-top: 9rpx; color: #6F7C71; font-size: 17rpx; line-height: 1.4; }
.card-actions { display: flex; gap: 10rpx; margin-top: 16rpx; }
.card-action { height: 56rpx; display: flex; align-items: center; justify-content: center; flex: 1; border-radius: 999rpx; background: #F2F5EF; color: #3F5A47; font-size: 21rpx; }
.card-share { margin: 0; padding: 0; border: 0; line-height: 56rpx; }
.card-share::after { border: 0; }
.card-share .button-label { font-size: 21rpx; font-weight: 400; }

.set-panel { margin-top: 34rpx; padding: 28rpx; border-radius: 28rpx; background: #FFF; }
.set-panel--complete { background: linear-gradient(145deg, #FFFBE6, #EEF1E7); }
.set-title { display: block; margin-bottom: 12rpx; color: #253B2D; font-size: 28rpx; font-weight: 600; }
.complete-copy { color: #74766F; font-size: 22rpx; line-height: 1.6; }
.unlock-cta { height: 82rpx; display: flex; align-items: center; justify-content: center; margin-top: 24rpx; border-radius: 999rpx; background: #3F5A47; color: #FFF; font-size: 25rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding-top: 100rpx; text-align: center; }
.empty-card { width: 210rpx; height: 290rpx; border: 3rpx dashed #CFCBC4; border-radius: 28rpx; background: #FFF; }
.empty-card--scene { background: linear-gradient(145deg, #F1EC9A, #FFC5BA); }
.empty-title { margin-top: 42rpx; font-size: 34rpx; font-weight: 600; }
.empty-desc { width: 470rpx; margin-top: 16rpx; color: #8C8C88; font-size: 24rpx; line-height: 1.65; }
.safe-space { height: calc(80rpx + env(safe-area-inset-bottom)); }
