<view class="page">
  <nav-bar title="我的背包"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view class="summary"><text>已拥有 {{items.length}} 种道具</text><text>{{balance}} 露珠</text></view>
    <view wx:if="{{!items.length}}" class="empty"><view class="empty-icon">◇</view><text class="empty-title">背包还是空的</text><text class="empty-copy">用互动获得的露珠，为蛋宝宝挑一点可爱的东西。</text><button class="shop-button" bindtap="onOpenShop"><text class="button-label">去商店看看</text></button></view>
    <view wx:else class="item-list">
      <view wx:for="{{items}}" wx:key="id" class="item-card">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-copy"><text class="item-category">{{item.categoryLabel}}</text><text class="item-name">{{item.name}}<text wx:if="{{item.quantity > 1}}" class="quantity"> ×{{item.quantity}}</text></text><text class="item-desc">{{item.description}}</text></view>
        <button wx:if="{{item.category === 'snack'}}" class="use-button" data-id="{{item.id}}" bindtap="onUseSnack"><text class="button-label">{{item.actionLabel}}</text></button>
        <view wx:else class="item-action">
          <text wx:if="{{item.statusLabel}}" class="item-status">{{item.statusLabel}}</text>
          <button class="use-button {{item.equipped ? 'use-button--active' : ''}}" data-id="{{item.id}}" data-equipped="{{item.equipped}}" bindtap="onToggle"><text class="button-label">{{item.actionLabel}}</text></button>
        </view>
      </view>
    </view>
    <view class="safe-space"></view>
  </scroll-view>
</view>
