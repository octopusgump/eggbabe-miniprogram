.page { height: 100vh; overflow: hidden; background: #FAFAF8; }
.content { height: calc(100vh - 170rpx); padding: 28rpx 40rpx 0; box-sizing: border-box; }
.summary { display: flex; justify-content: space-between; color: #6F786F; font-size: 21rpx; }
.empty { min-height: 850rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-icon { width: 128rpx; height: 128rpx; display: flex; align-items: center; justify-content: center; border-radius: 42rpx; background: #EEF2EA; color: #78905C; font-size: 54rpx; }
.empty-title { margin-top: 28rpx; color: #2C392F; font-size: 32rpx; font-weight: 600; }
.empty-copy { width: 440rpx; margin-top: 12rpx; color: #858880; font-size: 22rpx; line-height: 1.6; }
.shop-button { width: 320rpx; height: 80rpx; margin-top: 32rpx; border: 0; border-radius: 999rpx; background: #3F5A47; color: #FFF; font-size: 24rpx; line-height: 80rpx; }
.shop-button::after, .use-button::after { border: 0; }
.item-list { display: grid; gap: 22rpx; margin-top: 30rpx; }
.item-card { display: grid; grid-template-columns: 84rpx 1fr auto; align-items: center; gap: 18rpx; padding: 24rpx; border-radius: 28rpx; background: #FFF; }
.item-icon { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 25rpx; background: #F5F1D8; color: #526044; font-size: 36rpx; }
.item-copy { min-width: 0; }
.item-category, .item-name, .item-desc { display: block; }
.item-category { color: #99A092; font-size: 17rpx; }
.item-name { margin-top: 4rpx; color: #25332A; font-size: 25rpx; font-weight: 600; }
.quantity { color: #7E887F; font-size: 20rpx; font-weight: 400; }
.item-desc { max-width: 310rpx; margin-top: 7rpx; color: #7E817A; font-size: 18rpx; line-height: 1.45; }
.use-button { min-width: 94rpx; height: 62rpx; margin: 0; padding: 0 16rpx; border: 1rpx solid #C8D3C5; border-radius: 999rpx; background: #FFF; color: #3F5A47; font-size: 20rpx; line-height: 62rpx; }
.use-button--active { border-color: #3F5A47; background: #3F5A47; color: #FFF; }
.safe-space { height: calc(80rpx + env(safe-area-inset-bottom)); }
