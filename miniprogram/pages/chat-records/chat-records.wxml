<view class="page">
  <nav-bar title="对话记录"></nav-bar>

  <view class="system-notice-anchor">
    <inline-notice text="{{systemNoticeText}}" tone="{{systemNoticeTone}}" visible="{{systemNoticeVisible}}"></inline-notice>
  </view>

  <scroll-view scroll-y class="content">
    <view class="action-card">
      <text class="action-title">导出聊天记录</text>
      <text class="action-desc">将你的全部对话整理成文件，发送到指定邮箱。</text>
      <input
        class="email-input {{emailError ? 'email-input--error' : ''}}"
        value="{{email}}"
        type="text"
        maxlength="254"
        placeholder="请输入接收文件的邮箱"
        placeholder-class="email-placeholder"
        disabled="{{exporting || deleting}}"
        bindinput="onEmailInput"
        aria-label="接收聊天记录的邮箱"
      />
      <text wx:if="{{emailError || exportError}}" class="field-error" aria-role="alert">{{emailError || exportError}}</text>
      <button class="primary-button" hover-class="primary-button--pressed" disabled="{{exporting || deleting}}" bindtap="onExport"><text class="button-label">{{exporting ? '正在导出…' : '导出并发送到邮箱'}}</text></button>
    </view>

    <view class="action-card delete-card">
      <text class="action-title">删除聊天记录</text>
      <text class="action-desc">删除当前账号下的全部聊天记录，删除后无法恢复。建议先导出备份。</text>
      <text wx:if="{{deleteError}}" class="field-error delete-error" aria-role="alert">{{deleteError}}</text>
      <button class="danger-button" hover-class="danger-button--pressed" disabled="{{exporting || deleting}}" bindtap="onDelete"><text class="button-label">{{deleting ? '正在删除…' : '删除全部聊天记录'}}</text></button>
    </view>
  </scroll-view>
</view>
