.page{display:flex;flex-direction:column;height:100vh;background:#fff}.content{flex:1;padding:34rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));background:#fafaf8;box-sizing:border-box}.system-notice-anchor{position:fixed;z-index:120;top:calc(148rpx + env(safe-area-inset-top));left:72rpx;right:72rpx;display:flex;justify-content:center;pointer-events:none}.action-card{padding:52rpx 40rpx 48rpx;border:1rpx solid #e5e3df;border-radius:32rpx;background:#fff;box-shadow:0 2rpx 4rpx rgba(0,41,0,.06),0 4rpx 8rpx rgba(0,41,0,.04);box-sizing:border-box}.delete-card{margin-top:28rpx}.action-title,.action-desc{display:block;font-family:'PingFang SC','Helvetica Neue','Microsoft YaHei',sans-serif}.action-title{color:#1a1a1a;font-size:34rpx;font-weight:600;line-height:1.35}.action-desc{margin-top:22rpx;color:#5c5c5c;font-size:25rpx;line-height:1.6}.email-input{height:104rpx;margin-top:32rpx;padding:0 28rpx;border:1rpx solid #dfddd8;border-radius:26rpx;background:#fff;color:#1a1a1a;font-size:28rpx;box-sizing:border-box}.email-input--error{border-color:#d9463c}.email-placeholder{color:#aaa8a2}.field-error{display:block;margin:14rpx 6rpx 0;color:#d9463c;font-size:22rpx;line-height:1.45}.delete-error{text-align:center}.primary-button,.danger-button{min-height:96rpx;margin:40rpx auto 0;padding:0 42rpx;border-radius:999rpx;font-size:28rpx;font-weight:600;line-height:96rpx;box-sizing:border-box}.primary-button::after,.danger-button::after{border:0}.primary-button{width:78%;background:#002900;color:#fff}.primary-button--pressed{background:#001d00}.danger-button{width:78%;border:2rpx solid #d9463c;background:#fff;color:#d9463c}.danger-button--pressed{background:#fff4f2}.primary-button[disabled],.danger-button[disabled]{opacity:.55}@media (max-width:340px){.action-card{padding-left:30rpx;padding-right:30rpx}.primary-button,.danger-button{width:92%;padding:0 26rpx}}
