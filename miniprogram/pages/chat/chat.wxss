.page{height:100vh;display:flex;flex-direction:column;overflow:hidden;background:linear-gradient(180deg,#FAFAF8 0%,#F4F6EE 100%);color:#1A1A1A}
.chat-header{flex:none;min-height:0;background:rgba(255,255,255,.9)}
.conversation{flex:1;min-height:0}
.message-list{padding:32rpx 28rpx 0;box-sizing:border-box}
.history-loading{padding:0 0 22rpx;color:#8C8C88;font-size:20rpx;line-height:1.5;text-align:center}
.history-complete{padding:0 0 22rpx;color:#8C8C88;font-size:20rpx;line-height:1.5;text-align:center}
.history-error{display:flex;align-items:center;justify-content:center;gap:14rpx;margin:0 0 22rpx;padding:16rpx 18rpx;border:2rpx solid #F0CECA;border-radius:24rpx;background:#FDECEA;color:#C33F36;font-size:22rpx;line-height:1.45;text-align:center}
.history-error__retry{min-width:112rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:0 20rpx;border-radius:999rpx;background:#002900;color:#FFF;font-size:24rpx;font-weight:600}
.message-row{display:flex;margin-bottom:22rpx}
.message-row--assistant{justify-content:flex-start}
.message-row--user{justify-content:flex-end}
.message-stack{max-width:76%;display:flex;flex-direction:column;align-items:flex-start}
.message-stack--user{align-items:flex-end}
.message-bubble{max-width:76%;padding:22rpx 26rpx;border-radius:28rpx;font-size:26rpx;line-height:1.65;word-break:break-word;box-sizing:border-box}
.message-stack .message-bubble{max-width:100%}
.message-date{min-height:96rpx;display:flex;align-items:center;justify-content:center;margin:0 0 18rpx;color:#8C8C88;font-size:20rpx;line-height:1.45;text-align:center}
.message-date--pressed{opacity:.72}
.message-time{margin-top:8rpx;padding:0 8rpx;color:#8C8C88;font-size:20rpx;line-height:1.45}
.message-stack--user .message-time{text-align:right}
.message-bubble--assistant{border:1rpx solid #E2E6D9;border-bottom-left-radius:9rpx;background:#FFF;color:#26362B;box-shadow:0 7rpx 18rpx rgba(42,53,41,.06)}
.message-bubble--user{border-bottom-right-radius:9rpx;background:#002900;color:#FFF;box-shadow:0 8rpx 20rpx rgba(0,41,0,.16)}
.message-status{min-height:34rpx;margin-top:8rpx;padding:0 8rpx;box-sizing:border-box;color:#8C8C88;font-size:20rpx;line-height:34rpx}
.message-status--pending{display:flex;align-items:center;gap:8rpx;line-height:1.5}
.message-status__pending-dot{width:8rpx;height:8rpx;flex:none;border-radius:50%;background:#ACC861;animation:status-pulse 1.1s ease-in-out infinite}
.message-status--failed{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:0 24rpx;border:2rpx solid #F0CECA;border-radius:999rpx;background:#FDECEA;color:#C33F36;font-size:22rpx;font-weight:500;line-height:1.45}
.typing-bubble{min-height:60rpx;display:flex;align-items:center;padding:0 24rpx;border:1rpx solid #E2E6D9;border-radius:24rpx 24rpx 24rpx 8rpx;background:#FFF}
.typing-bubble__dots{display:flex;align-items:center;gap:8rpx}
.typing-bubble__dots view{width:8rpx;height:8rpx;border-radius:50%;background:#819178;animation:typing .5s ease-in-out infinite}
.typing-bubble__dots view:nth-child(2){animation-delay:.08s}.typing-bubble__dots view:nth-child(3){animation-delay:.16s}
.thread-spacer{height:24rpx}
.page-state{min-height:760rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;padding:40rpx;color:#5C5C5C;font-size:25rpx;text-align:center}
.loading-orbit{width:48rpx;height:48rpx;border:4rpx solid #E5E3DF;border-top-color:#002900;border-radius:50%;animation:spin .8s linear infinite}
.retry{min-height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 34rpx;border-radius:999rpx;background:#002900;color:#FFF;font-size:26rpx;font-weight:600}
.composer{flex:none;padding:16rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(70,72,60,.10);background:#FCFCF9;box-shadow:none}
.composer-error{display:block;padding:0 12rpx 12rpx;color:#C33F36;font-size:24rpx;font-weight:500;line-height:1.45}
.composer-notice{display:block;padding:0 12rpx 12rpx;color:#5C5C5C;font-size:23rpx;line-height:1.45}
.composer-row{display:flex;align-items:flex-end;gap:14rpx}
.composer-input{flex:1;min-height:96rpx;max-height:190rpx;padding:28rpx 24rpx;box-sizing:border-box;border:1rpx solid #D8D5CE;border-radius:28rpx;background:#FFF;color:#1A1A1A;font-size:25rpx;line-height:40rpx;transition:border-color .18s ease-out,background-color .18s ease-out}
.composer-input--focused{border-color:#D8D5CE;box-shadow:none}
.composer-input--error{border:4rpx solid #D9463C;background:#FDECEA;box-shadow:none}
.send-button{width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;flex:none;border-radius:50%;background:#002900;box-shadow:0 7rpx 16rpx rgba(0,41,0,.18);transition:transform .18s ease-out,background-color .18s ease-out,opacity .18s ease-out}
.send-button__icon{width:44rpx;height:44rpx;display:block}
.send-button--busy,.send-button--disabled{background:#E5E3DF;box-shadow:none}
.send-button--disabled .send-button__icon{opacity:.42}
.pressable--pressed{opacity:.9;transform:scale(.98);background:#001F00}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes typing{0%,100%{opacity:.35;transform:translateY(0)}50%{opacity:1;transform:translateY(-3rpx)}}
@keyframes status-pulse{0%,100%{opacity:.45;transform:scale(.85)}50%{opacity:1;transform:scale(1)}}
@media (prefers-reduced-motion:reduce){.loading-orbit,.typing-bubble__dots view,.message-status__pending-dot{animation:none}}
.page--reduced .composer-input,.page--reduced .send-button{transition:none}
.page--reduced .loading-orbit,.page--reduced .typing-bubble__dots view{animation:none}
.page--reduced .message-status__pending-dot{animation:none}
