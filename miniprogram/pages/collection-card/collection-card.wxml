<view class="page">
  <nav-bar title="收藏卡"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view wx:if="{{isNew}}" class="new-banner">获得第一张收藏卡 · 已自动收入我的收藏卡</view>
    <view class="card">
      <view class="card-title-section"><view class="card-avatar"><pet-avatar pet-type="{{cardView.prototype_name}}" size="{{42}}"></pet-avatar></view><view class="title-copy"><text class="name">{{cardView.name}}</text><text wx:if="{{isCollectible}}" class="collect-context">{{sceneCard.setName}} · {{sceneCard.name}}</text></view><text wx:if="{{isCollectible}}" class="collect-badge">{{sceneCard.collectorLabel}}</text></view>
      <view class="card-illustration-section"><image wx:if="{{illustration}}" class="illustration" src="{{illustration}}" mode="aspectFill"></image><pet-avatar wx:else pet-type="{{cardView.prototype_name}}" size="{{250}}"></pet-avatar></view>
      <view class="card-data-section">
        <view class="stat-grid">
          <view class="stat-cell"><text class="stat-label">类型</text><text class="stat-value">{{cardView.prototype_name}}</text></view>
          <view class="stat-cell"><text class="stat-label">生日</text><text class="stat-value">{{birthdayLabel}}</text></view>
          <view class="stat-cell"><text class="stat-label">星座</text><text class="stat-value">{{cardView.constellation}} {{zodiacSymbol}}</text></view>
          <view class="stat-cell"><text class="stat-label">性别</text><text class="stat-value">{{genderLabel}}</text></view>
          <view class="stat-cell"><text class="stat-label">血型</text><text class="stat-value">{{cardView.blood_type}} 型</text></view>
          <view class="stat-cell"><text class="stat-label">MBTI</text><text class="stat-value">{{cardView.mbti}}</text></view>
        </view>
        <text class="card-signature {{signatureClass}}">“{{cardView.signature}}”</text>
      </view>
    </view>
    <view wx:if="{{isCollectible}}" class="actions"><button class="primary" disabled="{{savingImage}}" bindtap="onSaveImage"><text class="button-label">保存图片</text></button></view>
    <canvas canvas-id="cardPosterCanvas" class="card-poster-canvas"></canvas>
  </scroll-view>
</view>
