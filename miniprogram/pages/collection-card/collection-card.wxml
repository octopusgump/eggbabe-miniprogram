<view class="page">
  <nav-bar title="收藏卡"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view wx:if="{{isNew}}" class="new-banner">获得第一张收藏卡 · 已自动收入我的收藏卡</view>
    <view class="card">
      <view class="card-title-section"><text class="title-star">★</text><view><text class="card-wordmark">eggbabe</text><text class="name">{{card.name}}</text></view><text class="title-star">★</text></view>
      <view class="card-illustration-section"><image wx:if="{{illustration}}" class="illustration" src="{{illustration}}" mode="aspectFit"></image><pet-avatar wx:else pet-type="{{card.prototype}}" size="{{250}}"></pet-avatar></view>
      <view class="card-data-section">
        <view class="stat-row"><view class="stat-label"><text class="stat-icon stat-icon--mbti">人</text><text>MBTI</text></view><text class="stat-value">{{card.mbti}}</text></view>
        <view class="stat-row"><view class="stat-label"><text class="stat-icon stat-icon--zodiac">★</text><text>星座</text></view><text class="stat-value">{{card.zodiac}} {{zodiacSymbol}}</text></view>
        <view class="stat-row"><view class="stat-label"><text class="stat-icon stat-icon--birthday">礼</text><text>生日</text></view><text class="stat-value">{{birthdayLabel}}</text></view>
      </view>
    </view>
    <view class="actions"><button class="primary" bindtap="onProfile"><text class="button-label">查看它的档案</text></button><view class="action-row"><button class="secondary" disabled="{{!posterReady}}" bindtap="onSave"><text class="button-label">{{posterReady ? '保存图片' : '待接入小程序码'}}</text></button><button class="secondary" open-type="share"><text class="button-label">分享给好友</text></button></view><text wx:if="{{posterUnavailableReason}}" class="poster-note">{{posterUnavailableReason}}</text><button class="text-button" bindtap="onAlbum"><text class="button-label">查看我的收藏卡</text></button></view>
    <canvas canvas-id="shareCanvas" class="share-canvas"></canvas>
  </scroll-view>
</view>
