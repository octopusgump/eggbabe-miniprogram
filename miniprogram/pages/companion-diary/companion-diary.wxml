<view class="diary-page">
  <view class="diary-topbar">
    <nav-bar title="" show-back="{{true}}" fallback-url="/pages/life-scene/life-scene"></nav-bar>
    <view
      wx:if="{{screenState === 'ready'}}"
      class="diary-share-pill"
      hover-class="diary-share-pill--pressed"
      aria-role="button"
      aria-label="分享日记"
      bindtap="onOpenShareSheet"
    >
      <view class="diary-share-pill__icon" aria-hidden="true"></view>
      <text class="diary-share-pill__label">分享</text>
    </view>
  </view>

  <view class="system-notice-anchor">
    <inline-notice
      text="{{systemNoticeText}}"
      tone="{{systemNoticeTone}}"
      visible="{{systemNoticeVisible}}"
    ></inline-notice>
  </view>

  <scroll-view wx:if="{{screenState === 'ready' && detail}}" class="diary-scroll" scroll-y>
    <view class="diary-content">
      <image class="diary-hero" src="{{detail.imageUrl}}" mode="aspectFill"></image>
      <view class="diary-letter">
        <text class="diary-salutation">{{detail.salutation}}</text>
        <text wx:for="{{paragraphs}}" wx:key="*this" class="diary-paragraph">{{item}}</text>
        <text class="diary-signoff">{{detail.signOff}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:elif="{{screenState === 'loading'}}" class="diary-state">
    <view class="diary-state__loader"></view>
    <text class="diary-state__copy">正在翻开这一页…</text>
  </view>

  <view wx:else class="diary-state">
    <text class="diary-state__copy">这一页还没有写好</text>
  </view>

  <view
    wx:if="{{shareSheetVisible && detail}}"
    class="diary-share-overlay"
    aria-role="dialog"
    aria-label="分享日记"
    bindtap="onShareOverlayTap"
  >
    <view class="diary-share-sheet" catchtap="stopOverlayBubble">
      <view class="diary-share-sheet__close" aria-role="button" aria-label="关闭" bindtap="onCloseShareSheet">
        <text>×</text>
      </view>
      <view class="diary-share-card">
        <image class="diary-share-card__hero" src="{{detail.imageUrl}}" mode="aspectFill"></image>
        <view class="diary-share-card__body">
          <text class="diary-salutation">{{detail.salutation}}</text>
          <text class="diary-share-card__excerpt">{{paragraphs[0]}}</text>
          <text class="diary-signoff diary-signoff--card">{{detail.signOff}}</text>
        </view>
        <view class="diary-share-card__footer">
          <view class="diary-share-card__user">
            <pet-avatar pet-type="{{pet.prototype}}" size="{{36}}"></pet-avatar>
            <text class="diary-share-card__name">{{detail.shareFooterName}}</text>
          </view>
          <view class="diary-share-card__qr" aria-label="{{detail.shareQrHint}}">
            <view class="diary-share-card__qr-grid" aria-hidden="true"></view>
            <text class="diary-share-card__qr-hint">{{detail.shareQrHint}}</text>
          </view>
        </view>
      </view>
      <view class="diary-share-actions">
        <button class="diary-share-actions__primary" hover-class="button-press" bindtap="onSaveShareCard">
          <text class="button-label">保存到相册</text>
        </button>
        <button class="diary-share-actions__secondary" hover-class="button-press" open-type="share">
          <text class="button-label">发给好友</text>
        </button>
      </view>
    </view>
  </view>
</view>
