.diary-page {
  min-height: 100vh;
  background: #f6f5ef;
  display: flex;
  flex-direction: column;
}

.system-notice-anchor {
  position: fixed;
  z-index: 220;
  top: calc(148rpx + env(safe-area-inset-top));
  left: 48rpx;
  right: 48rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.diary-scroll {
  flex: 1;
  height: calc(100vh - 112rpx - env(safe-area-inset-top));
}

.diary-scroll--with-dock {
  height: calc(100vh - 112rpx - env(safe-area-inset-top) - 168rpx - env(safe-area-inset-bottom));
}

.diary-content {
  padding: 24rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.diary-hero {
  width: 100%;
  height: 420rpx;
  display: block;
  border-radius: 24rpx;
  background: #f3f5ef;
}

.diary-letter {
  margin-top: 40rpx;
}

.diary-salutation {
  display: block;
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 1.7;
}

.diary-paragraph {
  display: block;
  margin-top: 28rpx;
  color: #303b33;
  font-size: 28rpx;
  line-height: 1.85;
}

.diary-signoff {
  margin-top: 48rpx;
  text-align: right;
}

.diary-signoff--card {
  margin-top: 24rpx;
}

.diary-signoff__line {
  display: block;
  color: #303b33;
  font-size: 28rpx;
  line-height: 1.7;
}

.diary-signoff__name {
  display: block;
  margin-top: 8rpx;
  color: #002900;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.diary-share-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(246, 245, 239, 0) 0%, #f6f5ef 28%);
}

.diary-share-dock__button {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1rpx solid #1a1a1a;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 180ms ease-out, background 180ms ease-out;
}

.diary-share-dock__button--pressed {
  background: #f3f7e7;
  transform: scale(0.99);
}

.diary-share-dock__icon {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  display: block;
}

.diary-share-dock__label {
  color: #002900;
  font-size: 28rpx;
  font-weight: 600;
}

.diary-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 80rpx 48rpx;
}

.diary-state__loader {
  width: 46rpx;
  height: 46rpx;
  border: 4rpx solid #e5e3df;
  border-top-color: #002900;
  border-radius: 50%;
  animation: diary-spin 0.8s linear infinite;
}

.diary-state__copy {
  color: #5c5c5c;
  font-size: 26rpx;
}

.diary-share-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 48rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.6);
}

.diary-share-sheet {
  width: 100%;
  max-width: 686rpx;
  position: relative;
}

.diary-share-sheet__close {
  position: absolute;
  top: -72rpx;
  right: 8rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1;
}

.diary-share-card {
  overflow: hidden;
  border-radius: 40rpx;
  background: #fafaf8;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.18);
}

.diary-share-card__hero {
  width: 100%;
  height: 320rpx;
  display: block;
}

.diary-share-card__body {
  padding: 36rpx 36rpx 0;
}

.diary-share-card__excerpt {
  margin-top: 16rpx;
  color: #303b33;
  font-size: 24rpx;
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
}

.diary-share-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 36rpx 36rpx;
}

.diary-share-card__brand {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.diary-share-card__brand-name {
  color: #002900;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.diary-share-card__brand-hint {
  color: rgba(0, 41, 0, 0.6);
  font-size: 20rpx;
  line-height: 1.35;
}

.diary-share-card__qr-image {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 41, 0, 0.13);
  background: #ffffff;
  box-sizing: border-box;
}

.diary-share-actions {
  margin-top: 24rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

.diary-share-actions__primary,
.diary-share-actions__secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  line-height: 1;
}

.diary-share-actions__primary {
  height: 96rpx;
  border: 0;
  background: #002900;
  color: #ffffff;
}

.diary-share-actions__secondary {
  height: 80rpx;
  border: 3rpx solid #002900;
  background: #ffffff;
  color: #002900;
}

.diary-share-actions__primary .button-label {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx;
  font-weight: 500;
}

.diary-share-actions__secondary .button-label {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  font-weight: 500;
}

.diary-share-actions__primary::after,
.diary-share-actions__secondary::after {
  border: 0;
}

@keyframes diary-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .diary-share-dock__button {
    transition: none;
  }
  .diary-share-dock__button--pressed {
    transform: none;
  }
  .diary-state__loader {
    animation: none;
  }
}
