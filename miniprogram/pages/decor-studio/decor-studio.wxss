.page{height:100vh;background:#FAFAF8;color:#2D3830}.content{height:calc(100vh - 176rpx);padding:28rpx 34rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}.page-state{min-height:700rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:#758074}.loading-orbit{width:44rpx;height:44rpx;border:4rpx solid #DAE1CD;border-top-color:#60784B;border-radius:50%;animation:spin .8s linear infinite}.quota-line{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;color:#778273;font-size:20rpx}.canvas-card{position:relative;height:650rpx;overflow:hidden;border:1rpx solid #E2E5DB;border-radius:34rpx;background:#FFF;box-shadow:0 12rpx 36rpx rgba(48,62,44,.06)}.decor-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:2}.canvas-placeholder{position:absolute;left:60rpx;right:60rpx;top:47%;color:#A0A69E;font-size:23rpx;line-height:1.6;text-align:center}.error-text{display:block;margin:16rpx 6rpx 0;color:#B34A43;font-size:21rpx}.magic-state,.result-card{margin-top:20rpx;padding:26rpx;border-radius:28rpx;background:#F1F5E8;color:#5C6E54;font-size:22rpx;line-height:1.6;text-align:center}.magic-state{display:flex;align-items:center;justify-content:center;gap:18rpx}.magic-orbit{width:38rpx;height:38rpx;border:4rpx dotted #77945E;border-radius:50%;animation:spin 1.2s linear infinite}.result-placeholder{height:190rpx;display:flex;align-items:center;justify-content:center;margin-bottom:16rpx;border-radius:24rpx;background:radial-gradient(circle,#FFF6C8,#DDE9C9);color:#52694A;font-size:28rpx}.toolbar{display:flex;gap:14rpx;margin-top:24rpx}.secondary-action,.primary-action{height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;font-size:24rpx}.secondary-action{flex:2;border:1rpx solid #CDD7C6;background:#FFF;color:#4B6048}.primary-action{flex:3;background:#3F5A47;color:#FFF}.primary-action--busy{opacity:.65}.saved-section{margin-top:34rpx;padding:28rpx;border-radius:28rpx;background:#FFF}.saved-title{display:block;color:#39463D;font-size:27rpx;font-weight:600}.saved-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.saved-item{padding:14rpx 20rpx;border-radius:999rpx;background:#EEF3E4;color:#5A704F;font-size:20rpx}.saved-empty{display:block;margin-top:16rpx;color:#90968E;font-size:21rpx}@keyframes spin{to{transform:rotate(360deg)}}@media (prefers-reduced-motion:reduce){.loading-orbit,.magic-orbit{animation:none}}
