<view class="page page--{{pageTransitionPhase}}">
  <view wx:if="{{companionDrawing && companionStartAwardVisible}}" class="companion-drawing-award" aria-label="获得{{companionStartAward}}星"><companion-star mode="award" size="150" reduced-motion="{{companionReducedMotion}}"></companion-star><text>+{{companionStartAward}}</text></view>
  <view class="doodle-nav">
    <view class="doodle-status-bar" style="height:{{statusBarHeight}}px"></view>
    <view class="doodle-nav-row">
      <view class="doodle-nav-leading" style="min-width: {{navSlotWidthPx}}px;">
        <view class="doodle-back" aria-hidden="true">
          <view class="doodle-chevron"></view>
        </view>
        <text
          wx:if="{{!companionPropMode}}"
          class="save-status save-status--{{saveStatus}}"
          aria-hidden="true"
        >{{companionDrawing ? '画好了' : saveStatusText}}</text>
      </view>
      <text class="doodle-title">{{companionDrawing ? '一起画' : '画我的蛋壳'}}</text>
      <view class="doodle-nav-safe" style="width: {{navSlotWidthPx}}px; min-width: {{navSlotWidthPx}}px;"></view>
    </view>
  </view>

  <root-portal>
    <cover-view class="doodle-nav-cover" style="padding-top: {{statusBarHeight}}px; height: {{navCoverHeightPx}}px;">
      <cover-view class="doodle-nav-cover-row">
        <cover-view class="doodle-back-cover" catchtap="onBack" aria-role="button" aria-label="返回">
          <cover-view class="doodle-chevron-cover"></cover-view>
        </cover-view>
        <cover-view
          wx:if="{{companionDrawing && !companionPropMode}}"
          class="doodle-save-cover"
          catchtap="onManualSave"
          aria-role="button"
          aria-label="画好了"
        >画好了</cover-view>
        <cover-view
          wx:elif="{{saveStatus === 'unsaved' || saveStatus === 'error'}}"
          class="doodle-save-cover doodle-save-cover--{{saveStatus}}"
          catchtap="onManualSave"
          aria-role="button"
          aria-label="{{saveStatusText}}"
        >{{saveStatusText}}</cover-view>
      </cover-view>
    </cover-view>
  </root-portal>

  <view class="preview {{companionPropMode ? 'preview--prop' : ''}}" bindtap="onCanvasBackdropTap">
    <view wx:if="{{companionPropMode && propLookHint}}" class="prop-look-row">
      <view
        class="prop-look-hint {{propSessionLookRemaining === 0 ? 'prop-look-hint--empty' : ''}}"
        bindtap="onPropLookAgain"
        aria-role="button"
        aria-label="{{propLookHint}}"
      >
        <text>{{propLookHint}}</text>
      </view>
    </view>

    <view class="canvas-notice-anchor {{companionPropMode ? 'canvas-notice-anchor--prop' : ''}}">
      <inline-notice
        text="{{canvasNoticeText}}"
        tone="{{canvasNoticeTone}}"
        visible="{{canvasNoticeVisible}}"
      ></inline-notice>
    </view>

    <view class="canvas-action-rail {{companionPropMode && (propDrawingLocked || propTutorialVisible) ? 'prop-chrome--dimmed' : ''}}">
      <view
        class="canvas-action-button {{!canUndo ? 'canvas-action-button--disabled' : ''}}"
        aria-role="button"
        aria-label="撤销一步"
        bindtap="onUndo"
      >
        <image
          class="canvas-action-image"
          src="{{canUndo ? toolbarIcons.undo : toolbarIcons.undoDisabled}}"
          mode="aspectFit"
        ></image>
        <text class="canvas-action-label">撤销</text>
      </view>
      <view
        class="canvas-action-button canvas-action-button--clear {{!canClear ? 'canvas-action-button--disabled' : ''}}"
        aria-role="button"
        aria-label="清空画面"
        bindtap="onClear"
      >
        <image
          class="canvas-action-image"
          src="{{canClear ? toolbarIcons.clear : toolbarIcons.clearDisabled}}"
          mode="aspectFit"
        ></image>
        <text class="canvas-action-label">清空</text>
      </view>
    </view>

    <view wx:if="{{!companionPropMode}}" class="preview-aura"></view>
    <view wx:if="{{companionPropMode}}" class="prop-paper-board">
      <view class="prop-paper-dash"></view>
    </view>
    <view wx:if="{{companionPropMode && propPeekVisible}}" class="prop-sketch-layer {{propPeekAnimating ? 'prop-sketch-layer--flip-out' : ''}}">
      <image class="prop-sketch-image" src="{{propSketchSrc || propSketchPath}}" mode="aspectFit" binderror="onPropSketchError"></image>
    </view>
    <text wx:if="{{companionPropMode && propPeekVisible}}" class="prop-peek-caption">先看一眼，记住它的样子</text>

    <view class="egg-canvas-stack {{companionPropMode ? 'egg-canvas-stack--prop' : ''}}" style="transform:scale({{canvasScale}});">
      <canvas
        type="2d"
        id="eggBaseCanvas"
        class="egg-canvas egg-canvas--base"
        hidden="{{exitConfirmVisible}}"
      ></canvas>
      <canvas
        type="2d"
        id="eggArtCanvas"
        class="egg-canvas egg-canvas--art"
        hidden="{{exitConfirmVisible}}"
        disable-scroll
        catchtouchstart="onCanvasTouchStart"
        catchtouchmove="onCanvasTouchMove"
        catchtouchend="onCanvasTouchEnd"
        catchtouchcancel="onCanvasTouchCancel"
      ></canvas>
    </view>
    <text wx:if="{{!canvasReady}}" class="canvas-loading">{{canvasPreparationError ? '画纸没有准备好，请返回后重试' : (companionDrawing ? '正在准备画纸…' : '正在准备蛋壳…')}}</text>

    <button
      wx:if="{{companionPropMode && propFinishVisible && !propUnlockVisible && !propTutorialVisible}}"
      class="prop-finish-btn"
      bindtap="onManualSave"
      aria-role="button"
      aria-label="画好了"
    >画好了</button>

    <view class="content {{companionPropMode && (propDrawingLocked || propTutorialVisible) ? 'prop-chrome--dimmed' : ''}}" catchtap="onToolPanelTap">
      <view class="tool-section {{!toolPanelOpen ? 'tool-section--compact' : ''}}">
      <view wx:if="{{toolPanelOpen && activeTool === 'brush'}}" class="tool-options brush-options">
        <view class="brush-settings-grid">
          <view class="brush-setting-group">
            <text class="brush-setting-title">粗细</text>
            <view class="brush-size-row">
              <view
                id="brushSizeTrack"
                class="brush-size-track"
                bindtouchstart="onBrushSizeScrub"
                catchtouchmove="onBrushSizeScrub"
              >
                <view
                  wx:for="{{brushSizes}}"
                  wx:key="pixels"
                  class="brush-size-option {{brushSizeIndex === index + 1 ? 'brush-size-option--selected' : ''}}"
                  data-index="{{index}}"
                  aria-role="button"
                  aria-label="{{item.label}}"
                  bindtap="onBrushSize"
                >
                  <view class="brush-size-dot" style="width:{{item.previewRpx}}rpx;height:{{item.previewRpx}}rpx;background:{{selectedBrushColor}};"></view>
                  <text class="brush-size-label">{{item.pixels}} px</text>
                </view>
              </view>
            </view>
          </view>

          <view class="brush-setting-group brush-setting-group--color">
            <text class="brush-setting-title">颜色</text>
            <text
              wx:if="{{colorHintRendered}}"
              class="brush-color-hint {{colorHintVisible ? 'brush-color-hint--visible' : ''}}"
            >点这里选颜色</text>
            <view
              class="brush-color-trigger"
              aria-role="button"
              aria-label="选择画笔颜色，当前{{selectedBrushColorName}}"
              bindtap="onToggleBrushColorPicker"
            >
              <view class="brush-selected-color" style="background:{{selectedBrushColor}};"></view>
            </view>
          </view>
        </view>

        <cover-view wx:if="{{colorPickerOpen}}" class="brush-color-popover" catchtap="onColorPickerTap">
          <cover-view class="brush-color-grid">
            <cover-view
              wx:for="{{brushColors}}"
              wx:key="token"
              class="brush-color-card {{selectedBrushColor === item.value ? 'brush-color-card--selected' : ''}}"
              data-token="{{item.token}}"
              aria-role="button"
              aria-label="{{item.name}}"
              bindtap="onBrushColor"
              style="background:{{item.value}};"
            ></cover-view>
          </cover-view>
        </cover-view>
      </view>

      <view wx:elif="{{toolPanelOpen && activeTool === 'eraser'}}" class="tool-options eraser-options">
        <view class="eraser-size-grid">
          <view
            wx:for="{{eraserSizes}}"
            wx:key="pixels"
            class="eraser-size-option {{eraserSizeIndex === index + 1 ? 'eraser-size-option--selected' : ''}}"
            data-index="{{index}}"
            aria-role="button"
            aria-label="橡皮擦 {{item.label}}"
            bindtap="onEraserSize"
          >
            <view class="eraser-size-dot" style="width:{{item.previewRpx}}rpx;height:{{item.previewRpx}}rpx;"></view>
            <text class="eraser-size-label">{{item.pixels}} px</text>
          </view>
        </view>
      </view>

      <view wx:if="{{toolPanelOpen && activeTool === 'sticker'}}" class="tool-options sticker-options">
        <view class="pattern-row">
          <view
            wx:for="{{patterns}}"
            wx:key="type"
            class="pattern {{selectedPattern === item.type ? 'pattern--selected' : ''}}"
            data-pattern="{{item.type}}"
            aria-role="button"
            aria-label="添加{{item.name}}贴纸"
            bindtap="onPattern"
          >
            <text class="pattern-symbol">{{item.symbol}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="figma-toolbar figma-toolbar--compact {{toolPanelOpen ? 'figma-toolbar--with-options' : ''}}">
        <view class="tool-button {{toolPanelOpen && activeTool === 'brush' ? 'tool-button--selected' : ''}}" data-tool="brush" aria-role="button" aria-label="画笔" bindtap="onTool">
          <view class="toolbar-icon-wrap">
            <image class="toolbar-image-icon" src="{{toolbarIcons.brush}}" mode="aspectFit"></image>
            <view class="brush-current-color" style="background:{{selectedBrushColor}};"></view>
          </view>
        </view>
        <view class="tool-button {{toolPanelOpen && activeTool === 'eraser' ? 'tool-button--selected' : ''}}" data-tool="eraser" aria-role="button" aria-label="橡皮擦" bindtap="onTool">
          <image class="toolbar-image-icon" src="{{toolbarIcons.eraser}}" mode="aspectFit"></image>
        </view>
        <view class="tool-button {{toolPanelOpen && activeTool === 'sticker' ? 'tool-button--selected' : ''}}" data-tool="sticker" aria-role="button" aria-label="贴纸" bindtap="onTool">
          <image class="toolbar-image-icon" src="{{toolbarIcons.sticker}}" mode="aspectFit"></image>
        </view>
      </view>
      </view>
    </view>
  </view>

  <view wx:if="{{companionPropMode && propUnlockVisible}}" class="prop-unlock-layer">
    <image class="prop-unlock-image" src="{{propColoredSrc || propColoredPath}}" mode="aspectFit" binderror="onPropColoredError"></image>
    <text class="prop-unlock-name">{{propDisplayName}}</text>
    <button class="prop-unlock-ok" bindtap="onPropUnlockOk">好的</button>
  </view>

  <view wx:if="{{companionPropMode && propTutorialVisible}}" class="prop-tutorial-scrim" catchtouchmove="true">
    <view class="prop-tutorial-card">
      <view class="prop-tutorial-head">
        <text class="prop-tutorial-title">{{propTutorialSteps[propTutorialStep].title}}</text>
        <view class="prop-tutorial-step-row">
          <text class="prop-tutorial-step">{{propTutorialStep + 1}}/3</text>
          <view class="prop-tutorial-dots">
            <view class="prop-tutorial-dot {{propTutorialStep === 0 ? 'prop-tutorial-dot--active' : ''}}"></view>
            <view class="prop-tutorial-dot {{propTutorialStep === 1 ? 'prop-tutorial-dot--active' : ''}}"></view>
            <view class="prop-tutorial-dot {{propTutorialStep === 2 ? 'prop-tutorial-dot--active' : ''}}"></view>
          </view>
        </view>
      </view>
      <text class="prop-tutorial-body">{{propTutorialSteps[propTutorialStep].body}}</text>
      <view class="prop-tutorial-footer {{propTutorialStep >= 2 ? 'prop-tutorial-footer--final' : ''}}">
        <text wx:if="{{propTutorialStep < 2}}" class="prop-tutorial-skip" bindtap="onPropTutorialSkip">跳过教程</text>
        <button class="prop-tutorial-next" bindtap="onPropTutorialNext">{{propTutorialStep >= 2 ? propTutorialFinalLabel : '下一步'}}</button>
      </view>
    </view>
  </view>

  <root-portal wx:if="{{exitConfirmVisible}}">
    <cover-view
      class="exit-confirm-overlay"
      aria-role="dialog"
      aria-label="当前修改尚未保存"
      catchtap="onExitConfirmTap"
    >
      <cover-view class="exit-confirm-dialog" catchtap="onExitConfirmDialogTap">
        <cover-view class="exit-confirm-title">画画还没有保存</cover-view>
        <cover-view class="exit-confirm-message {{exitConfirmErrorText ? 'exit-confirm-message--error' : ''}}">{{exitConfirmErrorText || (companionDrawing ? '画好后回到陪伴。' : '保存后，蛋宝宝会带着新装饰回到卧室。')}}</cover-view>
        <cover-view class="exit-confirm-actions">
          <cover-view
            class="exit-confirm-button exit-confirm-button--continue {{exitConfirmSaving ? 'exit-confirm-control--disabled' : ''}}"
            aria-role="button"
            aria-label="继续画"
            aria-disabled="{{exitConfirmSaving}}"
            bindtap="onContinueEditing"
          >继续画</cover-view>
          <cover-view
            class="exit-confirm-button exit-confirm-button--save {{exitConfirmSaving ? 'exit-confirm-control--disabled' : ''}}"
            aria-role="button"
            aria-label="{{exitConfirmSaving ? '保存中' : '保存并返回'}}"
            aria-disabled="{{exitConfirmSaving}}"
            bindtap="onSaveAndExit"
          >{{exitConfirmSaving ? '保存中…' : '保存并返回'}}</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>
  </root-portal>
</view>
