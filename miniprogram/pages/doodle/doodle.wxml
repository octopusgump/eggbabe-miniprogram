<view class="page {{expandedCanvas ? 'page--expanded' : ''}}">
  <nav-bar wx:if="{{!expandedCanvas}}" title="画我的蛋壳"></nav-bar>
  <view class="preview">
    <view class="canvas-expand-button" aria-role="button" aria-label="{{expandedCanvas ? '缩小画布' : '放大画布'}}" bindtap="onToggleCanvasSize">
      <image
        class="canvas-expand-icon {{expandedCanvas ? 'canvas-expand-icon--collapse' : ''}}"
        src="/assets/ui/3d-toolbar/runtime/ui_3d_toolbar_canvas_expand_96_v01.webp"
        mode="aspectFit"
      ></image>
    </view>
    <view class="preview-aura"></view>
    <view class="egg-canvas-stack">
      <canvas type="2d" id="eggBaseCanvas" class="egg-canvas egg-canvas--base"></canvas>
      <canvas
        type="2d"
        id="eggArtCanvas"
        class="egg-canvas egg-canvas--art"
        disable-scroll
        catchtouchstart="onCanvasTouchStart"
        catchtouchmove="onCanvasTouchMove"
        catchtouchend="onCanvasTouchEnd"
        catchtouchcancel="onCanvasTouchCancel"
      ></canvas>
    </view>
    <text wx:if="{{!canvasReady}}" class="canvas-loading">正在准备蛋壳…</text>
  </view>

  <scroll-view class="content" scroll-y>
    <view class="section tool-section">
      <view class="figma-toolbar">
        <view class="tool-button {{activeTool === 'brush' ? 'tool-button--selected' : ''}}" data-tool="brush" aria-role="button" aria-label="像素画笔" bindtap="onTool">
          <image class="toolbar-image-icon" src="/assets/ui/3d-toolbar/runtime/ui_3d_toolbar_brush_96_v02.png" mode="aspectFit"></image>
          <text>画笔</text>
        </view>
        <view class="tool-button {{activeTool === 'eraser' ? 'tool-button--selected' : ''}}" data-tool="eraser" aria-role="button" aria-label="橡皮擦" bindtap="onTool">
          <image class="toolbar-image-icon" src="/assets/ui/3d-toolbar/runtime/ui_3d_toolbar_eraser_96_v02.png" mode="aspectFit"></image>
          <text>橡皮擦</text>
        </view>
        <view class="tool-button {{activeTool === 'sticker' ? 'tool-button--selected' : ''}}" data-tool="sticker" aria-role="button" aria-label="贴纸" bindtap="onTool">
          <image class="toolbar-image-icon" src="/assets/ui/3d-toolbar/runtime/ui_3d_toolbar_sticker_96_v02.png" mode="aspectFit"></image>
          <text>贴纸</text>
        </view>
        <view class="tool-button {{!canUndo ? 'tool-button--disabled' : ''}}" aria-role="button" aria-label="撤销一步" bindtap="onUndo">
          <text class="toolbar-symbol">↶</text>
          <text>撤销</text>
        </view>
        <view class="tool-button tool-button--danger {{!canClear ? 'tool-button--disabled' : ''}}" aria-role="button" aria-label="清空画面" bindtap="onClear">
          <text class="toolbar-symbol">⌫</text>
          <text>清空</text>
        </view>
      </view>

      <view wx:if="{{activeTool === 'brush' || activeTool === 'eraser'}}" class="tool-options">
        <view class="size-heading">
          <text class="size-value">{{toolSizeLabel}}</text>
        </view>
        <view class="size-control">
          <view class="size-preview {{activeTool === 'eraser' ? 'size-preview--round' : ''}}" style="--preview-size:{{toolPreviewSize}}rpx;"></view>
          <slider
            class="size-slider"
            min="{{toolSizeMin}}"
            max="{{toolSizeMax}}"
            step="{{toolSizeStep}}"
            value="{{toolSizeValue}}"
            show-value="{{false}}"
            activeColor="#65744B"
            backgroundColor="#DDE2D8"
            block-color="#FFFFFF"
            block-size="20"
            bindchanging="onToolSizeChange"
            bindchange="onToolSizeChange"
          ></slider>
        </view>
      </view>

      <view wx:if="{{activeTool === 'sticker'}}" class="tool-options sticker-options">
        <view class="pattern-row">
          <view
            wx:for="{{patterns}}"
            wx:key="type"
            class="pattern {{selectedPattern === item.type ? 'pattern--selected' : ''}}"
            data-pattern="{{item.type}}"
            aria-role="button"
            aria-label="添加{{item.name}}贴纸"
            bindtap="onPattern"
          >
            <text class="pattern-symbol">{{item.symbol}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!expandedCanvas}}" class="section">
      <text class="label">蛋壳颜色</text>
      <view class="color-grid">
        <view
          wx:for="{{colors}}"
          wx:key="token"
          class="color-item"
          data-token="{{item.token}}"
          aria-role="button"
          aria-label="{{item.name}}"
          bindtap="onColor"
        >
          <view class="swatch {{selectedColor === item.value ? 'swatch--selected' : ''}}" style="background:{{item.value}};"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <button wx:if="{{!expandedCanvas}}" class="primary" hover-class="button-press" disabled="{{saving || !canvasReady}}" bindtap="onSave">
      <text class="button-label">{{saving ? '正在保存…' : '保存我的蛋壳'}}</text>
    </button>
  </scroll-view>
</view>
