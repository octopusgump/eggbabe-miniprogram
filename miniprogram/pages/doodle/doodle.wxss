.prop-sketch-layer { position: absolute; z-index: 5; width: 52vw; height: 52vw; max-width: 420rpx; max-height: 420rpx; top: calc(50% - 168rpx + var(--prop-layout-nudge, 0)); left: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; pointer-events: none; }
/* 简笔只保留这一张 image：教程与看一看只切换 class，避免「开始画」后再解码一次。 */
.prop-peek-anchor { position: absolute; z-index: 36; left: 0; right: 0; top: calc(50% - 168rpx + var(--prop-layout-nudge, 0)); display: flex; flex-direction: column; align-items: center; box-sizing: border-box; pointer-events: none; visibility: hidden; transform: translateY(-50%); }
