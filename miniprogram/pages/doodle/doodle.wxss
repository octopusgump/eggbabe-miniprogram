.save-status--error { background: #8C4F42; color: #FFF; }
.save-status--unsaved:active { transform: scale(.98); }
.save-status--error:active { transform: scale(.98); }
.doodle-title { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); color: #002900; font-size: 30rpx; font-weight: 600; white-space: nowrap; }
.doodle-nav-safe { width: 184rpx; height: 112rpx; margin-left: auto; }

.doodle-nav-cover { position: fixed; left: 0; top: 0; z-index: 10000; width: 100%; box-sizing: border-box; }
.doodle-nav-cover-row { display: flex; align-items: center; height: 112rpx; padding-left: env(safe-area-inset-left); box-sizing: border-box; }
.doodle-back-cover { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; }
.doodle-chevron-cover { width: 16rpx; height: 16rpx; margin-left: 8rpx; border-top: 3rpx solid #002900; border-right: 3rpx solid #002900; transform: rotate(-135deg); }
.doodle-save-cover { min-width: 76rpx; height: 48rpx; margin-left: 4rpx; padding: 0 14rpx; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 20rpx; line-height: 48rpx; text-align: center; box-sizing: border-box; }
.doodle-save-cover--error { background: #8C4F42; }

.preview { position: relative; z-index: 30; isolation: isolate; min-height: 0; flex: 1; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 0; border-radius: 0; background: linear-gradient(180deg, #FFF 0%, #F7F5EE 100%); box-shadow: none; }
.canvas-notice-anchor { position: absolute; z-index: 35; top: 28rpx; left: 132rpx; right: 132rpx; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.canvas-action-button { width: 112rpx; height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border: 0; border-radius: 0; background: transparent; color: #536047; box-shadow: none; transition: transform 180ms ease, opacity 180ms ease, color 180ms ease; }
