.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { min-height: 0; flex: 1; padding: 0 36rpx calc(64rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.preview { position: relative; z-index: 30; height: 360rpx; flex: 0 0 auto; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #ECE9E1; border-radius: 0 0 32rpx 32rpx; background: linear-gradient(180deg, #FFF 0%, #F7F5EE 100%); box-shadow: 0 12rpx 28rpx rgba(53,64,47,.07); }
.canvas-expand-button { position: absolute; z-index: 10; top: 20rpx; left: 20rpx; width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(218,221,212,.9); border-radius: 50%; background: rgba(255,255,255,.9); box-shadow: 0 8rpx 22rpx rgba(45,55,40,.1); color: #4F5E48; font-size: 31rpx; }
.canvas-expand-button:active { transform: scale(.94); }
.preview-aura { position: absolute; width: 330rpx; height: 330rpx; border-radius: 50%; background: radial-gradient(circle, rgba(237,231,142,.3), rgba(237,231,142,0) 68%); }
.egg-canvas-stack { position: relative; width: 300rpx; height: 300rpx; filter: drop-shadow(0 14rpx 16rpx rgba(51,48,35,.14)); transform-origin: center; transition: transform .2s ease; }
.egg-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.egg-canvas--base { z-index: 1; }
.egg-canvas--art { z-index: 2; touch-action: none; }
.canvas-loading { position: absolute; z-index: 3; bottom: 18rpx; color: #77756E; font-size: 19rpx; }
.section { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #E9E7E0; border-radius: 26rpx; background: #FFF; }
.tool-section { padding: 24rpx 20rpx; }
.label { display: block; color: #28332B; font-size: 28rpx; font-weight: 600; }
.color-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24rpx 12rpx; margin-top: 26rpx; }
.color-item { min-width: 0; color: #77756E; font-size: 19rpx; text-align: center; }
.swatch { width: 66rpx; height: 66rpx; margin: 0 auto 10rpx; box-sizing: border-box; border: 6rpx solid #FAFAF8; border-radius: 50%; box-shadow: 0 0 0 2rpx #E1DFD8; }
.swatch--selected { box-shadow: 0 0 0 4rpx #65744B; }
.figma-toolbar { width: 560rpx; height: 112rpx; display: grid; grid-template-columns: repeat(5, 112rpx); gap: 0; margin: 0 auto; padding: 0; overflow: hidden; border: 1rpx solid #E3E5DF; border-radius: 56rpx; background: #F6F7F4; }
.tool-button { position: relative; width: 112rpx; height: 112rpx; min-width: 112rpx; min-height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; border: 0; border-radius: 0; color: #596155; font-size: 17rpx; transition: transform .15s ease, background .15s ease, border-color .15s ease; }
.tool-button + .tool-button::before { position: absolute; left: 0; top: 28rpx; bottom: 28rpx; width: 1rpx; content: ""; background: #E3E5DF; }
.tool-button:active { transform: scale(.95); }
.tool-button--selected { background: #FFF0DD; color: #6A3F2D; }
.tool-button--danger { color: #765C55; }
.tool-button--disabled { color: #B8BAB4; opacity: .48; pointer-events: none; }
.toolbar-symbol { height: 29rpx; font-size: 29rpx; line-height: 29rpx; }
.toolbar-image-icon { width: 58rpx; height: 58rpx; flex: 0 0 58rpx; }
.tool-options { margin-top: 14rpx; padding: 18rpx; border: 1rpx solid #E4E6E0; border-radius: 18rpx; background: #FBFCF9; }
.size-heading { display: flex; align-items: center; justify-content: flex-end; color: #596155; font-size: 19rpx; }
.size-value { color: #65744B; font-variant-numeric: tabular-nums; }
.size-control { display: flex; align-items: center; gap: 14rpx; margin-top: 8rpx; }
.size-preview { position: relative; width: 34rpx; height: 34rpx; flex: 0 0 auto; border: 1rpx solid #DDE2D8; border-radius: 8rpx; background: #FFF; }
.size-preview::after { position: absolute; top: 50%; left: 50%; width: var(--preview-size); height: var(--preview-size); content: ""; background: #536447; transform: translate(-50%, -50%); }
.size-preview--round::after { border-radius: 50%; }
.size-slider { min-width: 0; flex: 1; margin: 0; }
.sticker-options { padding-top: 15rpx; }
.pattern-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 12rpx; }
.pattern { height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; border: 2rpx solid #E1DFD8; border-radius: 999rpx; background: #FFF; color: #526047; font-size: 19rpx; }
.pattern--selected { border-color: #9DB65B; background: #F3F7EA; }
.pattern-symbol { height: 27rpx; color: #536447; font-size: 27rpx; line-height: 27rpx; }
.primary { height: 96rpx; display: flex; align-items: center; justify-content: center; margin-top: 40rpx; padding: 0; border: 0; border-radius: 999rpx; background: #3F5A47; color: #FFF; font-size: 28rpx; line-height: normal; }
.primary[disabled] { background: #AEB9AE; color: rgba(255,255,255,.86); }
.primary::after { border: none; }
.page--expanded .preview { height: 72vh; padding-top: env(safe-area-inset-top); box-sizing: border-box; border-radius: 0; box-shadow: none; }
.page--expanded .canvas-expand-button { top: calc(18rpx + env(safe-area-inset-top)); }
.page--expanded .preview-aura { width: 68vh; height: 68vh; }
.page--expanded .egg-canvas-stack { width: 62vh; max-width: 86vw; height: 62vh; max-height: 86vw; }
.page--expanded .content { padding: 0 20rpx calc(24rpx + env(safe-area-inset-bottom)); }
.page--expanded .tool-section { margin-top: 12rpx; padding: 14rpx 12rpx; }
.page--expanded .tool-options { margin-top: 10rpx; padding: 12rpx 16rpx; }
@media (prefers-reduced-motion: reduce) {
  .egg-canvas-stack, .tool-button { transition: none; }
}
