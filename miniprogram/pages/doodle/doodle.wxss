.prop-peek-anchor .prop-sketch-layer { position: relative; top: auto; left: auto; width: 100%; height: 52vw; max-width: 420rpx; max-height: 420rpx; transform: none; }
.prop-sketch-image { width: 100%; height: 100%; opacity: 1; transform-origin: center center; mix-blend-mode: darken; }
.prop-peek-anchor .prop-peek-caption { position: relative; top: auto; left: auto; right: auto; margin-top: 24rpx; width: 100%; }
.prop-peek-caption { position: absolute; z-index: 12; left: 0; right: 0; top: calc(50% + 72rpx + var(--prop-layout-nudge, 0)); color: rgba(53, 72, 60, 0.6); font-size: 26rpx; line-height: 1.3; text-align: center; pointer-events: none; }

.prop-finish-btn { position: absolute; z-index: 40; left: 50%; bottom: calc(var(--prop-finish-btn-bottom, 210rpx) + env(safe-area-inset-bottom)); width: 560rpx; max-width: calc(100% - 96rpx); height: var(--prop-finish-btn-height, 96rpx); margin: 0; padding: 0; border: 0; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 30rpx; font-weight: 600; line-height: var(--prop-finish-btn-height, 96rpx); text-align: center; transform: translateX(-50%); box-shadow: 0 8rpx 24rpx rgba(0, 41, 0, 0.12); }

.prop-unlock-layer { position: fixed; z-index: 120; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: env(safe-area-inset-top) 48rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #F8F7EF; }
.prop-unlock-stack { display: flex; flex-direction: column; align-items: center; width: 100%; margin: 0 0 56rpx; flex-shrink: 0; }
.prop-unlock-reveal { display: flex; flex-direction: column; align-items: center; width: 100%; flex-shrink: 0; transform: scale(0.52); opacity: 0; }
.prop-unlock-layer--active .prop-unlock-reveal { animation: prop-unlock-pop 0.78s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.prop-unlock-image { width: 52vw; height: 52vw; max-height: 480rpx; }
.prop-unlock-name { margin-top: 28rpx; color: #002900; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.prop-unlock-award { position: relative; width: 150rpx; height: 150rpx; margin: 0 0 32rpx; pointer-events: none; flex-shrink: 0; }
.prop-unlock-award-plus { position: absolute; left: 100%; top: 50%; margin-left: 26rpx; margin-top: -34rpx; color: #FFDD79; font-size: 44rpx; font-weight: 700; line-height: 68rpx; white-space: nowrap; text-shadow: 0 2rpx 8rpx rgba(72, 50, 12, 0.35); transform-origin: 30% 60%; animation: prop-unlock-award-plus 0.85s cubic-bezier(0.2, 0.9, 0.3, 1) 0.88s both; }
.prop-unlock-award--reduced .prop-unlock-award-plus { animation: none; opacity: 1; transform: none; }
.prop-unlock-ok { width: 560rpx; max-width: 100%; height: 96rpx; margin-top: 0; flex-shrink: 0; border: 0; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 30rpx; font-weight: 600; line-height: 96rpx; }

@keyframes prop-unlock-pop {
  0% { opacity: 0; transform: scale(0.52) translateY(48rpx); }
  45% { opacity: 1; transform: scale(1.1) translateY(-12rpx); }
  68% { transform: scale(0.96) translateY(6rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes prop-unlock-award-plus {
  0% { opacity: 0; transform: translate3d(-44rpx, 20rpx, 0) rotate(-160deg) scale(0.5); }
  40% { opacity: 1; transform: translate3d(4rpx, -14rpx, 0) rotate(10deg) scale(1.08); }
  65% { transform: translate3d(0, 4rpx, 0) rotate(-4deg) scale(0.97); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0) scale(1); }
}

.prop-tutorial-scrim { position: fixed; z-index: 130; inset: 0; background: rgba(22, 36, 26, 0.8); display: flex; flex-direction: column; align-items: stretch; justify-content: flex-end; padding: env(safe-area-inset-top) 24rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.prop-tutorial-scrim--step-0 { padding-bottom: calc(110rpx + env(safe-area-inset-bottom)); }
.prop-tutorial-scrim--step-1 { padding-bottom: calc(230rpx + env(safe-area-inset-bottom)); }
.prop-tutorial-bg-sketch { flex: 1 1 auto; min-height: 0; pointer-events: none; }
.prop-tutorial-card { width: 100%; flex: 0 0 auto; display: flex; flex-direction: column; gap: 0; padding: 40rpx 44rpx 36rpx; border-radius: 48rpx; background: #FFFDF6; box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15); box-sizing: border-box; }
.prop-tutorial-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; }
.prop-tutorial-title { flex: 1 1 auto; min-width: 0; white-space: nowrap; color: #002900; font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.prop-tutorial-dots { flex: 0 0 auto; display: flex; align-items: center; gap: 8rpx; }
.prop-tutorial-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: rgba(0, 41, 0, 0.2); }
.prop-tutorial-dot--active { width: 36rpx; background: #002900; }
.prop-tutorial-body { margin-top: 36rpx; color: #3E4C42; font-size: 28rpx; line-height: 44rpx; white-space: pre-line; }
.prop-tutorial-foot { display: flex; align-items: center; justify-content: flex-end; width: 100%; min-height: 76rpx; margin-top: 40rpx; }
.prop-tutorial-skip { margin-right: auto; color: #7A877D; font-size: 28rpx; line-height: 1.4; padding: 8rpx 0; flex-shrink: 0; }
.prop-tutorial-next { display: inline-block; flex: 0 0 auto; width: auto; max-width: none; min-width: 194rpx; height: 76rpx; margin: 0 0 0 auto; padding: 0 52rpx; border: 0; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 30rpx; font-weight: 600; line-height: 76rpx; flex-shrink: 0; box-sizing: border-box; white-space: nowrap; text-align: center; }
.prop-tutorial-next::after { border: none; }
