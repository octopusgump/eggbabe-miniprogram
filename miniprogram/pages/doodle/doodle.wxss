.doodle-chevron { width: 16rpx; height: 16rpx; margin-left: 8rpx; border-top: 3rpx solid #002900; border-right: 3rpx solid #002900; transform: rotate(-135deg); }
.save-status { min-width: 76rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: #687548; font-size: 20rpx; line-height: 1; text-align: center; pointer-events: none; transition: background 180ms ease, color 180ms ease; }
