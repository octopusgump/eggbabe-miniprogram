.preview--prop-tutorial-step-1 .canvas-action-rail { opacity: 0.35; visibility: visible; z-index: 140; }
.preview--prop-tutorial-step-1 .prop-finish-btn { visibility: hidden; }
.prop-finish-btn--tutorial-dim { opacity: 0.35; }
.prop-finish-cover { position: fixed; z-index: 9998; left: 110rpx; width: 560rpx; height: 96rpx; bottom: calc(248rpx + env(safe-area-inset-bottom)); border-radius: 999rpx; background: #002900; color: #FFF; font-size: 30rpx; font-weight: 600; line-height: 96rpx; text-align: center; box-sizing: border-box; box-shadow: 0 8rpx 24rpx rgba(0, 41, 0, 0.12); pointer-events: none; }
.prop-finish-cover--tutorial-spotlight { border: 6rpx solid #f7d774; box-shadow: 0 0 14rpx rgba(247, 215, 116, 0.6), 0 8rpx 24rpx rgba(0, 41, 0, 0.12); }
.preview--prop-preparing .prop-paper-stage,
.preview--prop-preparing .prop-peek-anchor,
.preview--prop-preparing .prop-peek-caption,
.preview--prop-preparing .prop-finish-btn { visibility: hidden; pointer-events: none; }
.prop-prepare-screen { position: fixed; z-index: 280; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28rpx; background: #F8F7EF; pointer-events: auto; }
.prop-prepare-spinner { width: 64rpx; height: 64rpx; border-radius: 50%; border: 6rpx solid rgba(53, 72, 60, 0.12); border-top-color: #35483C; animation: prop-prepare-spin 720ms linear infinite; }
.prop-prepare-text { color: #566155; font-size: 28rpx; line-height: 1.4; }
@keyframes prop-prepare-spin { to { transform: rotate(360deg); } }
.preview--prop-unlock .prop-paper-stage,
.preview--prop-unlock .prop-look-chrome,
.preview--prop-unlock .prop-sketch-layer,
.preview--prop-unlock .prop-peek-anchor,
.preview--prop-unlock .prop-peek-caption,
.preview--prop-unlock .prop-finish-btn,
.preview--prop-unlock .content,
.preview--prop-unlock .canvas-action-rail { visibility: hidden; pointer-events: none; }
.preview--prop .canvas-action-rail { top: auto; bottom: calc(var(--prop-finish-btn-bottom) + var(--prop-finish-btn-height) - var(--canvas-action-rail-height) + env(safe-area-inset-bottom)); transform: none; z-index: 38; }
.egg-canvas-stack--hidden { visibility: hidden; pointer-events: none; height: 0; overflow: hidden; flex: 0 0 0; }
.prop-canvas-slot--hidden { visibility: hidden; pointer-events: none; }

.prop-chrome--dimmed { opacity: 0.35; pointer-events: none; }

.prop-paper-stage { position: absolute; z-index: 0; top: calc(50% - 200rpx + var(--prop-layout-nudge, 0)); left: 50%; width: 88vw; height: 120vw; max-height: 936rpx; transform: translate(-50%, -50%); pointer-events: none; }
.prop-look-chrome { position: relative; z-index: 45; flex: 0 0 auto; display: flex; justify-content: center; padding: 26rpx 24rpx 12rpx; background: #F8F7EF; pointer-events: none; }
.prop-look-hint { pointer-events: auto; padding: 14rpx 28rpx; border-radius: 999rpx; border: 1rpx solid rgba(53, 72, 60, 0.12); background: rgba(255, 255, 255, 0.92); color: #35483C; font-size: 26rpx; font-weight: 500; line-height: 1.2; box-shadow: 0 4rpx 16rpx rgba(54, 71, 61, 0.08); }
.prop-look-hint--empty { opacity: 0.55; }
.canvas-notice-anchor--prop { top: 16rpx; }

.prop-paper-board { position: absolute; z-index: 0; inset: 0; border-radius: 56rpx; border: 1rpx solid rgba(53, 72, 60, 0.08); background: var(--prop-paper-fill, #F7EEE5); box-shadow: 0 8rpx 32rpx rgba(54, 71, 61, 0.06); pointer-events: none; }
.prop-paper-dash { position: absolute; z-index: 3; inset: 30rpx; border: 3rpx dashed rgba(53, 72, 60, 0.2); border-radius: 40rpx; pointer-events: none; }

.prop-canvas-slot { position: absolute; z-index: 2; inset: 30rpx; pointer-events: auto; overflow: visible; }
