.sample-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #eadfce; color: #294732; }
.sample-background { position: absolute; inset: 0; width: 100%; height: 100%; }
.sample-background--current { z-index: 1; }
.sample-background--previous { z-index: 2; animation: sample-background-exit .34s ease-out both; }
.sample-background--switching { animation: sample-background-enter .34s ease-out both; }
.sample-header { position: absolute; z-index: 20; top: calc(24rpx + env(safe-area-inset-top)); left: 24rpx; right: 24rpx; display: flex; align-items: center; gap: 16rpx; }
.sample-back { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(236,232,218,.94); border-radius: 50%; background: rgba(255,253,246,.88); box-shadow: 0 8rpx 22rpx rgba(61,51,35,.12); font-size: 50rpx; line-height: 1; }
.sample-title { min-height: 112rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 22rpx; border: 1rpx solid rgba(236,232,218,.94); border-radius: 999rpx; background: rgba(255,253,246,.88); box-shadow: 0 8rpx 22rpx rgba(61,51,35,.12); font-size: 25rpx; font-weight: 600; }
.sample-tag { padding: 5rpx 9rpx; border-radius: 999rpx; background: #edf2e3; color: #71834f; font-size: 20rpx; letter-spacing: 1rpx; }
.sample-mode-switch { position: absolute; z-index: 20; top: calc(152rpx + env(safe-area-inset-top)); right: 24rpx; width: 224rpx; height: 112rpx; display: flex; align-items: center; gap: 0; padding: 0; overflow: hidden; border: 1rpx solid rgba(236,232,218,.9); border-radius: 56rpx; background: rgba(255,253,246,.84); box-shadow: 0 8rpx 22rpx rgba(61,51,35,.12); backdrop-filter: blur(10rpx); }
.sample-mode-option { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 0; color: #697166; font-size: 20rpx; font-weight: 600; text-align: center; }
.sample-mode-option--active { background: #edf2e3; color: #36513c; box-shadow: inset 0 0 0 1rpx rgba(113,131,79,.18); }
.sample-page--night .sample-mode-option--active { background: #dbe5ef; color: #344b62; box-shadow: inset 0 0 0 1rpx rgba(74,101,129,.18); }
.sample-page--night .sample-tag { background: #dbe5ef; color: #526d86; }
.sample-shadow { position: absolute; pointer-events: none; }
.sample-nest { position: absolute; z-index: 4; top: 50%; left: 50%; width: 700rpx; height: 700rpx; margin: -20rpx 0 0 -350rpx; pointer-events: none; }
.sample-shadow--egg { z-index: 5; top: 50%; left: 50%; width: 620rpx; height: 620rpx; margin: -190rpx 0 0 -310rpx; }
.sample-egg-stage { position: absolute; z-index: 6; top: 50%; left: 50%; width: 620rpx; height: 620rpx; margin: -190rpx 0 0 -310rpx; }
.sample-egg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; transform-origin: 50% 84%; }
.sample-egg--previous { z-index: 1; }
.sample-egg--current { z-index: 2; }
.sample-egg--previous.rotation--left { animation: sample-exit-left .22s ease-out both; }
.sample-egg--previous.rotation--right { animation: sample-exit-right .22s ease-out both; }
.sample-egg--current.sample-egg--rotating.rotation--left { animation: sample-enter-left .22s ease-out both; }
.sample-egg--current.sample-egg--rotating.rotation--right { animation: sample-enter-right .22s ease-out both; }
.sample-egg--previous.rotation--mode { animation: sample-mode-egg-exit .34s ease-out both; }
.sample-egg--current.sample-egg--rotating.rotation--mode { animation: sample-mode-egg-enter .34s ease-out both; }
.sample-hotspot { position: absolute; z-index: 5; top: 16%; bottom: 8%; width: 50%; }
.sample-hotspot--left { left: 0; }
.sample-hotspot--right { right: 0; }
.sample-controls { position: absolute; z-index: 15; left: 50%; bottom: calc(54rpx + env(safe-area-inset-bottom)); min-width: 300rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 18rpx 26rpx; border: 1rpx solid rgba(236,232,218,.94); border-radius: 28rpx; background: rgba(255,253,246,.88); box-shadow: 0 10rpx 30rpx rgba(61,51,35,.14); transform: translateX(-50%); backdrop-filter: blur(10rpx); }
.sample-hint { font-size: 20rpx; color: #667165; }
.sample-orientations { display: flex; align-items: center; gap: 13rpx; }
.sample-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #c7cebd; transition: transform .2s ease, background .2s ease; }
.sample-dot--active { background: #36513c; transform: scale(1.45); }
.sample-orientation-label { color: #36513c; font-size: 22rpx; font-weight: 600; }
.sample-state { position: absolute; z-index: 30; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22rpx; background: rgba(249,246,237,.76); color: #526052; font-size: 24rpx; backdrop-filter: blur(8rpx); }
.sample-state--error { padding: 60rpx; text-align: center; line-height: 1.7; }
.sample-loading-orbit { width: 58rpx; height: 58rpx; border: 5rpx solid rgba(54,81,60,.18); border-top-color: #36513c; border-radius: 50%; animation: sample-spin .9s linear infinite; }
.sample-retry { min-width: 240rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; padding: 0 34rpx; border-radius: 999rpx; background: #36513c; color: #fff; font-weight: 600; }
.sample-home { color: #596959; text-decoration: underline; }
@keyframes sample-spin { to { transform: rotate(360deg); } }
@keyframes sample-exit-left { from { opacity: 1; transform: translateX(0) scale(1); } to { opacity: 0; transform: translateX(-12rpx) scale(.988); } }
@keyframes sample-enter-left { from { opacity: .18; transform: translateX(12rpx) scale(.988); } to { opacity: 1; transform: translateX(0) scale(1); } }
@keyframes sample-exit-right { from { opacity: 1; transform: translateX(0) scale(1); } to { opacity: 0; transform: translateX(12rpx) scale(.988); } }
@keyframes sample-enter-right { from { opacity: .18; transform: translateX(-12rpx) scale(.988); } to { opacity: 1; transform: translateX(0) scale(1); } }
@keyframes sample-background-exit { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(1.018); } }
@keyframes sample-background-enter { from { opacity: .3; transform: scale(1.012); } to { opacity: 1; transform: scale(1); } }
@keyframes sample-mode-egg-exit { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(.975); } }
@keyframes sample-mode-egg-enter { from { opacity: .12; transform: scale(.975); } to { opacity: 1; transform: scale(1); } }
@media (prefers-reduced-motion: reduce) {
  .sample-background, .sample-egg, .sample-dot, .sample-loading-orbit { animation: none !important; transition: none !important; }
}
