<view class="page">
  <!-- 破壳仪式：情感时刻，全程 520ms cubic-bezier(0.34,1.56,0.64,1)，尊重 prefers-reduced-motion -->

  <view wx:if="{{phase === 'blocked'}}" class="stage">
    <view class="egg-pulse" style="background: linear-gradient(160deg, #FFFDF0, {{pet.shell.color}}, #F4B9AE);"></view>
    <text class="headline">我还在准备破壳。</text>
    <text class="gate-message">{{gateMessage}}</text>
    <view class="secondary-link" bindtap="onBackHome">回到主页</view>
  </view>

  <view wx:elif="{{phase === 'error'}}" class="stage">
    <view class="egg-pulse" style="background: linear-gradient(160deg, #FFFDF0, {{pet.shell.color}}, #F4B9AE);"></view>
    <text class="headline">我还在这里。</text>
    <text class="gate-message">{{resultError}}</text>
    <view class="retry-button" bindtap="onRetryHatch">再试一次</view>
    <view class="secondary-link" bindtap="onBackHome">先回到主页</view>
  </view>

  <!-- 阶段一：孵化回顾 -->
  <view wx:if="{{phase === 'confirm'}}" class="stage">
    <view class="egg-pulse" style="background: linear-gradient(160deg, #FFFDF0, {{pet.shell.color}}, #F4B9AE);"></view>
    <text class="sub">破壳前，再看一眼我们一起经历的事</text>
    <text class="headline">这些时刻，我都记得。</text>
    <view wx:if="{{reviewItems.length}}" class="review-list">
      <text wx:for="{{reviewItems}}" wx:key="*this" class="review-item">· {{item}}</text>
    </view>
    <btn text="我记得了，准备破壳" bind:tap="onReveal"></btn>
  </view>

  <!-- 阶段二：破壳 + 粒子迸发 + 收藏卡生成 -->
  <view wx:elif="{{phase === 'reveal'}}" class="stage">
    <view class="burst">
      <view class="particle" wx:for="{{particles}}" wx:key="i"
            style="--tx: {{item.tx}}; --ty: {{item.ty}}; background: {{item.color}};"></view>
      <view class="crack-flash"></view>
      <view class="reveal-card" style="background: linear-gradient(160deg, #FFFDF0, {{pet.shell.color}}, #F4B9AE);"></view>
    </view>
    <text class="gen-text">正在准备这一蛋一份的收藏卡…</text>
  </view>
</view>
