<view class="page">
  <nav-bar title="帮助中心"></nav-bar>

  <view class="search-bar">
    <view class="search-input">
      <view class="search-icon"></view>
      <input class="search-field" value="{{searchQuery}}" placeholder="搜索问题关键词" bindinput="onSearchInput" />
    </view>
  </view>

  <scroll-view scroll-y class="faq-scroll">

    <view wx:if="{{searchQuery}}" class="search-results">
      <view wx:if="{{searchResults.length}}">
        <view wx:for="{{searchResults}}" wx:key="q" class="search-result">
          <text class="search-result-q">{{item.q}}</text>
          <text class="search-result-a">{{item.a}}</text>
        </view>
      </view>
      <view wx:else class="search-empty">没有找到相关问题，试试其他关键词。</view>
    </view>

    <collapse-item wx:if="{{!searchQuery}}"
      title="设备问题"
      variant="category"
      expanded="{{cats.device}}"
      bind:toggle="onToggleCat"
      data-cat="device"
    >
      <view class="qa-group">
        <collapse-item
          wx:for="{{deviceFaqs}}"
          wx:key="q"
          title="{{item.q}}"
          variant="question"
          expanded="{{item.open}}"
          show-border="{{index !== deviceFaqs.length - 1}}"
          bind:toggle="onToggleFaq"
          data-group="deviceFaqs"
          data-index="{{index}}"
        >
          <text>{{item.a}}</text>
        </collapse-item>
      </view>
    </collapse-item>

    <collapse-item wx:if="{{!searchQuery}}"
      title="账号"
      variant="category"
      expanded="{{cats.account}}"
      bind:toggle="onToggleCat"
      data-cat="account"
    >
      <view class="qa-group">
        <collapse-item
          wx:for="{{accountFaqs}}"
          wx:key="q"
          title="{{item.q}}"
          variant="question"
          expanded="{{item.open}}"
          show-border="{{index !== accountFaqs.length - 1}}"
          bind:toggle="onToggleFaq"
          data-group="accountFaqs"
          data-index="{{index}}"
        >
          <text>{{item.a}}</text>
        </collapse-item>
      </view>
    </collapse-item>

    <collapse-item wx:if="{{!searchQuery}}"
      title="对话功能"
      variant="category"
      expanded="{{cats.chat}}"
      bind:toggle="onToggleCat"
      data-cat="chat"
    >
      <view class="qa-group">
        <collapse-item
          wx:for="{{chatFaqs}}"
          wx:key="q"
          title="{{item.q}}"
          variant="question"
          expanded="{{item.open}}"
          show-border="{{index !== chatFaqs.length - 1}}"
          bind:toggle="onToggleFaq"
          data-group="chatFaqs"
          data-index="{{index}}"
        >
          <text>{{item.a}}</text>
        </collapse-item>
      </view>
    </collapse-item>

    <collapse-item wx:if="{{!searchQuery}}"
      title="其他"
      variant="category"
      expanded="{{cats.other}}"
      show-border="{{false}}"
      bind:toggle="onToggleCat"
      data-cat="other"
    >
      <view class="qa-group">
        <collapse-item
          wx:for="{{otherFaqs}}"
          wx:key="q"
          title="{{item.q}}"
          variant="question"
          expanded="{{item.open}}"
          show-border="{{index !== otherFaqs.length - 1}}"
          bind:toggle="onToggleFaq"
          data-group="otherFaqs"
          data-index="{{index}}"
        >
          <text>{{item.a}}</text>
        </collapse-item>
      </view>
    </collapse-item>

    <view class="bottom-space"></view>

  </scroll-view>

  <view class="cs-bar">
    <text class="cs-hint">没找到答案？</text>
    <view class="cs-link" bindtap="onContactCS">
      <text class="cs-link-text">联系客服</text>
      <view class="cs-arrow"></view>
    </view>
  </view>

</view>
