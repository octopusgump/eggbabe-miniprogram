<view class="page">
  <nav-bar title="蛋宝宝" show-back="{{false}}"></nav-bar>

  <scroll-view class="content" scroll-y>
    <view wx:if="{{!pet}}" class="empty-state">
      <view class="empty-orbit"><view class="empty-egg"></view></view>
      <text class="empty-title">添加我的蛋宝宝</text>
      <text class="empty-desc">输入随实体蛋提供的激活码，把这枚蛋宝宝带回家。</text>
      <button class="primary-button" bindtap="onAddDevice"><text class="button-label">添加蛋宝宝</text></button>
      <text class="empty-note">当前版本每个账号只能绑定 1 只</text>
    </view>

    <view wx:else class="pet-view">
      <view class="top-row">
        <view>
          <view class="pet-name-row" bindtap="onPetNameTap">
            <text class="pet-name">{{pet.name || '我的蛋宝宝'}}</text>
            <text wx:if="{{stage === 'hatched'}}" class="pet-name-edit">改名</text>
          </view>
        </view>
      </view>

      <view class="egg-zone {{environment.className}} {{sceneEffect}} {{lampOn ? 'room-lamp-on' : ''}}">
        <view wx:if="{{stage !== 'hatched'}}" class="incubation-scene {{environment.className}}">
          <image class="incubation-scene-image" src="{{environment.backgroundImage}}" mode="aspectFill"></image>
          <view class="scene-color-layer"></view>
          <view wx:if="{{!environment.backgroundImage}}" class="scene-fallback">
            <view class="window-glow"></view>
            <view class="room-floor"></view>
            <view class="room-lamp"></view>
          </view>
          <view class="window-effects">
            <view class="window-light"></view>
            <view class="curtain-light curtain-light--left"></view>
            <view class="curtain-light curtain-light--right"></view>
            <view class="season-atmosphere">
              <view class="season-piece season-piece--one"></view>
              <view class="season-piece season-piece--two"></view>
              <view class="season-piece season-piece--three"></view>
            </view>
            <view wx:if="{{environment.weather === 'cloudy'}}" class="weather-clouds">
              <view class="weather-cloud weather-cloud--one"></view><view class="weather-cloud weather-cloud--two"></view>
            </view>
            <view wx:if="{{environment.weather === 'rain'}}" class="weather-rain">
              <view wx:for="{{weatherParticles}}" wx:key="*this" class="rain-drop rain-drop--{{index}}"></view>
            </view>
            <view wx:if="{{environment.weather === 'snow'}}" class="weather-snow">
              <view wx:for="{{weatherParticles}}" wx:key="*this" class="snow-flake snow-flake--{{index}}">·</view>
            </view>
            <canvas type="2d" id="windowFogCanvas" class="window-fog-canvas" catchtouchstart="onWindowTouchStart" catchtouchmove="onWindowTouchMove" catchtouchend="onWindowTouchEnd" catchtouchcancel="onWindowTouchEnd"></canvas>
          </view>
          <view class="room-light-breathe"></view>
          <view class="room-element-layer">
            <view wx:for="{{roomElements}}" wx:key="key" class="room-element {{item.position}}" data-key="{{item.key}}" aria-role="button" aria-label="{{item.label}}" bindtap="onRoomElementTap">
              <text class="room-element-icon">{{item.icon}}</text>
              <text class="room-element-label">{{item.label}}</text>
              <view wx:if="{{item.key === 'coffee'}}" class="room-coffee-effect" aria-hidden="true">
                <view class="coffee-steam coffee-steam--one"></view>
                <view class="coffee-steam coffee-steam--two"></view>
                <view class="coffee-cup-ring"></view>
              </view>
              <view wx:elif="{{item.key === 'brush'}}" class="room-brush-stroke" aria-hidden="true"></view>
              <view wx:elif="{{item.key === 'scarf'}}" class="room-scarf-weave" aria-hidden="true"></view>
            </view>
          </view>
        </view>

        <view wx:if="{{greeting}}" class="daily-greeting" bindtap="onGreetingTap">{{greeting}}</view>
        <view wx:if="{{feedback}}" class="feedback-bubble">{{feedback}}</view>
        <view wx:if="{{stage !== 'hatched'}}" class="egg-aura {{eggMotion}}"></view>

        <image wx:if="{{stage === 'hatched' && hasScenes}}" class="life-home-scene {{eggMotion}}" src="{{sceneImage}}" mode="aspectFill" bindtap="onRoleTap" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></image>
        <pet-avatar wx:elif="{{stage === 'hatched'}}" pet-type="{{pet.prototype}}" size="{{270}}" bindtap="onRoleTap" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></pet-avatar>
        <view wx:else class="egg-contact-shadow {{eggMotion}}"></view>
        <view wx:if="{{stage !== 'hatched'}}" class="egg egg-shell {{eggMotion}}" catchtap="onEggTap" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
          <image class="egg-shell-preview egg-shell-preview--base" src="{{homeEggBasePreview || environment.eggImage}}" mode="aspectFit" data-layer="base" binderror="onHomeEggPreviewError"></image>
          <image wx:if="{{homeEggArtPreview}}" class="egg-shell-preview egg-shell-preview--art" src="{{homeEggArtPreview}}" mode="aspectFit" data-layer="art" binderror="onHomeEggPreviewError"></image>
          <view class="egg-shell-depth"></view>
          <view class="egg-shell-specular"></view>
        </view>
        <view wx:for="{{tapParticles}}" wx:key="id" class="tap-particles" style="left:{{item.x}}px;top:{{item.y}}px;">
          <view class="tap-particle tap-particle--one">✦</view>
          <view class="tap-particle tap-particle--two">•</view>
          <view class="tap-particle tap-particle--three">✧</view>
        </view>
      </view>

      <view class="state-card">
        <view class="state-dot"></view>
        <text class="state-title">{{stageText}}</text>
      </view>

      <view wx:if="{{stage === 'hatched' && dailyStatus}}" class="status-daily">
        <text class="status-meta">此刻 · {{dailyStatus.mood}}</text>
        <text class="status-line">{{dailyStatus.line}}</text>
      </view>

      <view wx:if="{{stage !== 'hatched' && stage !== 'ready'}}" class="companion-section">
        <text class="section-title">一起待一会儿</text>
        <view class="companion-grid">
          <view wx:for="{{companionActions}}" wx:key="key" class="companion-item" hover-class="companion-item--pressed" data-key="{{item.key}}" aria-role="button" aria-label="{{item.title}}" bindtap="onCompanionTap">
            <view class="companion-icon-wrap"><image class="companion-icon" src="{{item.icon}}" mode="aspectFit"></image></view>
            <view class="companion-copy"><text class="companion-title">{{item.title}}</text><text class="companion-desc">{{item.desc}}</text></view>
          </view>
        </view>
      </view>

      <view wx:if="{{stage !== 'hatched' && stage !== 'ready'}}" class="talk-panel">
        <text class="section-title">跟我说说话</text>
        <view class="talk-composer">
          <input class="talk-input" value="{{talkDraft}}" focus="{{talkFocused}}" maxlength="50" placeholder="{{talkPlaceholder}}" confirm-type="send" bindinput="onTalkInput" bindconfirm="onTalkSubmit" />
          <view class="talk-send" hover-class="talk-send--pressed" aria-role="button" aria-label="发送" bindtap="onTalkSubmit">
            <image class="talk-send-icon" src="/assets/icons/send.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <view wx:if="{{syncPending > 0}}" class="sync-note">{{syncPending}} 项记录正在等待网络同步</view>

      <view wx:if="{{stage === 'prepared' || stage === 'soon' || stage === 'ready' || stage === 'hatched'}}" class="home-actions">
        <button class="primary-button home-actions__chat" disabled="{{stage === 'prepared' || stage === 'soon'}}" bindtap="onPrimaryAction"><text class="button-label">{{actionLabel}}</text></button>
        <button wx:if="{{stage === 'hatched' && hasScenes}}" class="primary-button home-actions__scene" bindtap="onChangeScene"><text class="button-label">更换场景</text></button>
      </view>
    </view>
  </scroll-view>

  <canvas wx:if="{{pet && stage !== 'hatched'}}" type="2d" id="homeEggBaseCanvas" class="egg-render-cache egg-render-cache--base"></canvas>
  <canvas wx:if="{{pet && stage !== 'hatched'}}" type="2d" id="homeEggArtCanvas" class="egg-render-cache egg-render-cache--art"></canvas>

  <view wx:if="{{showNameSheet}}" class="name-mask" catchtouchmove="noop">
    <view class="name-sheet">
      <view class="name-handle"></view>
      <text class="name-sheet-title">我还没有名字</text>
      <text class="name-sheet-copy">给我起一个昵称吧，也可以以后再决定。</text>
      <view class="name-input-wrap">
        <input class="name-input" value="{{nameDraft}}" maxlength="10" placeholder="最多 10 个字" bindinput="onNameInput" focus />
        <text class="name-count">{{nameCount}}/10</text>
      </view>
      <text wx:if="{{nameError}}" class="name-error">{{nameError}}</text>
      <button class="name-save" disabled="{{savingName}}" bindtap="onSaveName"><text class="button-label">{{savingName ? '正在保存…' : '记住这个名字'}}</text></button>
      <button class="name-skip" bindtap="onSkipName"><text class="button-label">暂不命名</text></button>
    </view>
  </view>
</view>
