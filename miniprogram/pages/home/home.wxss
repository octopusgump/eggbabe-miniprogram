.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; padding: 30rpx 40rpx 48rpx; box-sizing: border-box; }
.empty-state { min-height: 1040rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-orbit { width: 300rpx; height: 300rpx; border: 2rpx dashed #D8D6C8; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 50rpx; background: radial-gradient(circle, rgba(237,231,142,.22), transparent 68%); }
.empty-egg { width: 150rpx; height: 184rpx; border: 4rpx solid #D7D4CA; border-radius: 52% 48% 48% 52% / 61% 59% 41% 39%; background: #FFF; }
.empty-title { font-size: 42rpx; font-weight: 600; color: #002900; }
.empty-desc { width: 520rpx; margin: 22rpx 0 48rpx; font-size: 27rpx; line-height: 1.75; color: #6D6B65; }
.empty-note { margin-top: 22rpx; font-size: 22rpx; line-height: 1.6; color: #9A9890; text-align: center; }
.primary-button { width: 100%; height: 94rpx; line-height: 94rpx; padding: 0; border: none; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 29rpx; font-weight: 600; }
.primary-button::after { border: none; }
.pet-view { padding-bottom: 30rpx; }
.top-row { position: relative; z-index: 8; display: flex; align-items: center; justify-content: space-between; }
.eyebrow { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: #829047; }
.pet-name-row { display: flex; align-items: center; gap: 14rpx; margin-top: 10rpx; }
.pet-name { display: block; font-size: 42rpx; font-weight: 600; color: #1A1A1A; }
.pet-name-edit { padding: 6rpx 12rpx; border-radius: 999rpx; background: #EEF3E6; color: #60703B; font-size: 19rpx; }
.progress-wrap { position: relative; }
.progress-ring { width: 94rpx; height: 94rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #54632C; font-size: 23rpx; font-weight: 600; box-shadow: 0 8rpx 24rpx rgba(45,72,42,.12); }
.progress-ring-core { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.94); }
.progress-tip { position: absolute; z-index: 20; top: 104rpx; right: 0; width: 220rpx; padding: 14rpx 18rpx; border-radius: 16rpx 4rpx 16rpx 16rpx; background: #26372C; color: #FFF; font-size: 20rpx; text-align: center; }

.egg-zone { position: relative; height: 650rpx; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 20rpx; border-radius: 42rpx; }
.incubation-scene { position: absolute; z-index: 0; inset: 0; overflow: hidden; background-position: center; background-size: cover; transition: filter .4s ease, background .4s ease; }
.incubation-scene::before { position: absolute; inset: 0; content: ""; background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,250,232,.18) 55%, rgba(103,82,58,.12)); }
.season-spring { background: linear-gradient(155deg, #DDECD7 0%, #F8F0D8 52%, #DDBF9C 100%); }
.season-summer { background: linear-gradient(155deg, #BFDCCB 0%, #F5EFCB 50%, #D7B48A 100%); }
.season-autumn { background: linear-gradient(155deg, #DFC897 0%, #F4E2C5 52%, #B98D6B 100%); }
.season-winter { background: linear-gradient(155deg, #D9E7EA 0%, #F2EEE3 54%, #B7C1C3 100%); }
.period-night { filter: brightness(.72) saturate(.9); }
.period-night::after { position: absolute; inset: 0; content: ""; background: radial-gradient(circle at 72% 42%, rgba(255,218,134,.34), transparent 30%), linear-gradient(180deg, rgba(29,42,67,.28), rgba(75,54,42,.08)); }
.window-glow { position: absolute; top: 56rpx; left: 72rpx; width: 210rpx; height: 220rpx; border: 12rpx solid rgba(117,91,65,.22); border-radius: 10rpx; background: linear-gradient(180deg, rgba(255,255,255,.52), rgba(219,235,218,.3)); box-shadow: inset 0 0 50rpx rgba(255,255,255,.6); }
.window-glow::before, .window-glow::after { position: absolute; content: ""; background: rgba(117,91,65,.18); }
.window-glow::before { left: 50%; top: 0; width: 6rpx; height: 100%; }
.window-glow::after { top: 50%; left: 0; width: 100%; height: 6rpx; }
.room-floor { position: absolute; left: -10%; right: -10%; bottom: -80rpx; height: 270rpx; border-radius: 50% 50% 0 0; background: repeating-linear-gradient(100deg, rgba(147,105,73,.18) 0 4rpx, rgba(226,199,166,.5) 4rpx 70rpx); transform: perspective(260rpx) rotateX(18deg); }
.room-lamp { position: absolute; right: 70rpx; bottom: 150rpx; width: 60rpx; height: 110rpx; border-radius: 50% 50% 10rpx 10rpx; background: radial-gradient(circle at 50% 30%, #FFF5B8, #D9B867 70%); box-shadow: 0 0 70rpx rgba(255,224,133,.45); }
.weather-cloud { position: absolute; height: 38rpx; border-radius: 999rpx; background: rgba(222,229,229,.8); filter: blur(2rpx); animation: cloud-drift-room 12s linear infinite; }
.weather-cloud--one { top: 92rpx; left: 80rpx; width: 150rpx; }
.weather-cloud--two { top: 150rpx; left: 150rpx; width: 100rpx; animation-delay: -5s; }
.weather-rain, .weather-snow { position: absolute; inset: 0; overflow: hidden; }
.rain-drop, .snow-flake { position: absolute; top: -40rpx; animation: weather-fall 1.4s linear infinite; }
.rain-drop { width: 3rpx; height: 42rpx; border-radius: 999rpx; background: rgba(115,151,167,.55); transform: rotate(10deg); }
.snow-flake { color: rgba(255,255,255,.9); font-size: 34rpx; animation-duration: 4.2s; }
.rain-drop--0,.snow-flake--0{left:6%}.rain-drop--1,.snow-flake--1{left:14%;animation-delay:-.3s}.rain-drop--2,.snow-flake--2{left:22%;animation-delay:-.8s}.rain-drop--3,.snow-flake--3{left:31%;animation-delay:-1.1s}.rain-drop--4,.snow-flake--4{left:39%;animation-delay:-.5s}.rain-drop--5,.snow-flake--5{left:48%;animation-delay:-1.3s}.rain-drop--6,.snow-flake--6{left:57%;animation-delay:-.2s}.rain-drop--7,.snow-flake--7{left:65%;animation-delay:-.9s}.rain-drop--8,.snow-flake--8{left:73%;animation-delay:-1.2s}.rain-drop--9,.snow-flake--9{left:81%;animation-delay:-.4s}.rain-drop--10,.snow-flake--10{left:89%;animation-delay:-1s}.rain-drop--11,.snow-flake--11{left:96%;animation-delay:-.6s}

.egg-aura { position: absolute; z-index: 1; width: 390rpx; height: 390rpx; border-radius: 50%; background: radial-gradient(circle, rgba(237,231,142,.55), rgba(237,231,142,0) 68%); animation: aura 3s ease-in-out infinite; }
.egg { position: relative; z-index: 3; width: 268rpx; height: 330rpx; border-radius: 52% 48% 47% 53% / 61% 58% 42% 39%; box-shadow: inset -20rpx -26rpx 36rpx rgba(105,105,40,.15), 0 34rpx 56rpx rgba(0,41,0,.15); animation: breathe 3.4s ease-in-out infinite; }
.life-home-scene { position: relative; z-index: 3; width: 430rpx; height: 450rpx; border-radius: 42rpx; box-shadow: 0 26rpx 50rpx rgba(0,41,0,.16); }
.egg-shine { position: absolute; top: 64rpx; left: 54rpx; width: 52rpx; height: 124rpx; border-radius: 50%; background: rgba(255,255,255,.56); transform: rotate(17deg); }
.egg-pattern { position: absolute; border-radius: 50%; background: rgba(0,41,0,.10); }
.egg-pattern--one { top: 112rpx; right: 62rpx; width: 16rpx; height: 16rpx; }
.egg-pattern--two { left: 78rpx; bottom: 84rpx; width: 10rpx; height: 10rpx; }
.egg-shadow { position: relative; z-index: 2; width: 250rpx; height: 42rpx; margin-top: -2rpx; border-radius: 50%; background: rgba(0,41,0,.14); filter: blur(12rpx); }
.feedback-bubble, .daily-greeting { position: absolute; z-index: 8; max-width: 480rpx; padding: 18rpx 26rpx; border-radius: 28rpx 28rpx 28rpx 8rpx; background: #FFF; box-shadow: 0 12rpx 36rpx rgba(0,41,0,.10); color: #3D4930; font-size: 25rpx; animation: bubble-in .25s ease-out; }
.feedback-bubble { top: 92rpx; }
.daily-greeting { top: 26rpx; border: 2rpx solid rgba(157,182,91,.28); }
.cuddle-track { position: absolute; z-index: 8; bottom: 62rpx; width: 280rpx; height: 8rpx; overflow: hidden; border-radius: 999rpx; background: #E8E6DF; }
.cuddle-fill { height: 100%; border-radius: 999rpx; background: #9DB65B; transition: width .1s linear; }
.tap-particles { position: absolute; z-index: 12; width: 1rpx; height: 1rpx; pointer-events: none; }
.tap-particle { position: absolute; color: #FFF6A3; font-size: 30rpx; text-shadow: 0 2rpx 8rpx rgba(89,83,35,.25); animation: tap-burst .55s ease-out forwards; }
.tap-particle--one { --px:-42rpx; --py:-48rpx; }.tap-particle--two { --px:38rpx; --py:-26rpx; animation-delay:.04s }.tap-particle--three { --px:8rpx; --py:46rpx; animation-delay:.08s }
.egg--wobble { animation: wobble .55s ease-in-out; }
.egg--warming, .egg--warm, .egg--talk-glow { filter: drop-shadow(0 0 28rpx rgba(237,231,142,.95)); }
.egg--warming { animation: warm 1s ease-in-out infinite; }
.egg--warm { animation: warm-done .8s ease-out; }
.egg--talk-soft { animation: wobble .8s ease-in-out; }
.egg--talk-happy { animation: happy-wobble .8s ease-out; }
.egg--talk-glow { animation: warm-done .85s ease-out; }
.egg--talk-color { filter: hue-rotate(18deg) saturate(1.12); }
.egg--talk-knock { animation: knock .7s ease-in-out; }

.state-card { display: flex; align-items: center; margin: 24rpx 0; padding: 26rpx 30rpx; border: 1rpx solid #E8E6E0; border-radius: 28rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(0,41,0,.04); }
.state-dot { width: 16rpx; height: 16rpx; flex: 0 0 auto; margin: 0 28rpx 0 8rpx; border-radius: 50%; background: #9DB65B; box-shadow: 0 0 0 10rpx #F1F5E7; }
.state-title { font-size: 28rpx; font-weight: 600; color: #273020; }
.status-daily { margin: 0 0 28rpx; padding: 0 30rpx; text-align: center; }
.status-meta { display: block; color: #718044; font-size: 21rpx; line-height: 1.5; }
.status-line { display: block; margin-top: 10rpx; color: #35352F; font-size: 28rpx; line-height: 1.55; }
.section-title { display: block; margin-bottom: 18rpx; color: #26372C; font-size: 28rpx; font-weight: 600; }
.task-section, .talk-panel { margin-top: 26rpx; }
.task-list { overflow: hidden; border: 1rpx solid #E5E8E0; border-radius: 28rpx; background: #FFF; }
.task-row { min-height: 108rpx; display: flex; align-items: center; gap: 20rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #ECEDE8; }
.task-row:last-child { border-bottom: 0; }
.task-row--done { opacity: .62; }
.task-check { width: 46rpx; height: 46rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #EEF3E6; color: #526844; font-size: 21rpx; }
.task-copy { flex: 1; min-width: 0; }
.task-title, .task-desc { display: block; }
.task-title { color: #28332B; font-size: 25rpx; font-weight: 600; }
.task-desc { margin-top: 7rpx; color: #8A8C85; font-size: 20rpx; }
.task-reward { color: #718044; font-size: 21rpx; }
.talk-panel { padding: 24rpx; border-radius: 28rpx; background: #EEF2E9; }
.talk-composer { width: 100%; height: 86rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 10rpx 0 22rpx; box-sizing: border-box; border-radius: 24rpx; background: #FFF; }
.talk-input { min-width: 0; height: 86rpx; flex: 1; color: #26372C; font-size: 24rpx; }
.talk-send { width: 58rpx; height: 58rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #3F5A47; }
.talk-send--pressed { opacity: .86; transform: scale(.96); }
.talk-send-icon { width: 30rpx; height: 30rpx; display: block; }
.sync-note { margin-top: 16rpx; color: #976A28; font-size: 21rpx; text-align: center; }
.home-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 26rpx; }
.home-actions .primary-button { width: auto; min-width: 0; margin: 0; }
.home-actions__chat { flex: 7 1 0; }
.home-actions__scene { flex: 3 1 0; border: 1rpx solid #D9E3C2; background: #F5F8ED; color: #002900; }

.name-mask { position: fixed; z-index: 80; inset: 0; display: flex; align-items: flex-end; background: rgba(15,24,17,.42); }
.name-sheet { width: 100%; padding: 18rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 42rpx 42rpx 0 0; background: #FFFDF8; }
.name-handle { width: 72rpx; height: 8rpx; margin: 0 auto 30rpx; border-radius: 999rpx; background: #D8D8D1; }
.name-sheet-title { display: block; color: #26372C; font-size: 38rpx; font-weight: 600; text-align: center; }
.name-sheet-copy { display: block; margin: 16rpx auto 28rpx; color: #777B75; font-size: 23rpx; line-height: 1.6; text-align: center; }
.name-input-wrap { position: relative; }
.name-input { height: 94rpx; padding: 0 100rpx 0 26rpx; border: 2rpx solid #DDE4D7; border-radius: 22rpx; background: #FFF; color: #26372C; font-size: 30rpx; }
.name-count { position: absolute; top: 34rpx; right: 24rpx; color: #9A9C96; font-size: 20rpx; }
.name-error { display: block; margin-top: 14rpx; color: #B84B45; font-size: 21rpx; }
.name-save, .name-skip { width: 100%; height: 88rpx; margin: 22rpx 0 0; padding: 0; border-radius: 999rpx; font-size: 26rpx; line-height: 88rpx; }
.name-save { background: #3F5A47; color: #FFF; }
.name-skip { margin-top: 8rpx; background: transparent; color: #777B75; }
.name-save::after, .name-skip::after { border: 0; }

@keyframes breathe { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-10rpx) rotate(1deg); } }
@keyframes aura { 0%,100% { transform: scale(.95); opacity: .65; } 50% { transform: scale(1.08); opacity: 1; } }
@keyframes wobble { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-6deg); } 70% { transform: rotate(5deg); } }
@keyframes warm { 0%,100% { transform: scale(1); } 50% { transform: scale(1.025); } }
@keyframes warm-done { 0% { transform: scale(1); } 45% { transform: scale(1.07); } 100% { transform: scale(1); } }
@keyframes happy-wobble { 0%,100% { transform: translateY(0) rotate(0); } 30% { transform: translateY(-14rpx) rotate(-4deg); } 65% { transform: translateY(-4rpx) rotate(5deg); } }
@keyframes knock { 0%,100% { transform: translateX(0); } 30% { transform: translateX(-7rpx); } 60% { transform: translateX(7rpx); } }
@keyframes bubble-in { from { transform: translateY(8rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes tap-burst { from { transform: translate(0,0) scale(.7); opacity: 1; } to { transform: translate(var(--px),var(--py)) scale(1.15); opacity: 0; } }
@keyframes weather-fall { from { transform: translateY(-40rpx) rotate(8deg); opacity: 0; } 15% { opacity: 1; } to { transform: translateY(720rpx) rotate(12deg); opacity: .15; } }
@keyframes cloud-drift-room { from { transform: translateX(-80rpx); } to { transform: translateX(240rpx); } }

@media (prefers-reduced-motion: reduce) {
  .egg, .egg-aura, .weather-cloud, .rain-drop, .snow-flake { animation: none; }
  .tap-particle--two, .tap-particle--three { display: none; }
  .tap-particle--one { animation: tap-fade .45s ease-out forwards; }
}
@keyframes tap-fade { from { opacity: 1; } to { opacity: 0; } }
