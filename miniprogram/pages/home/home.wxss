.feedback-bubble { position: absolute; z-index: 8; max-width: 480rpx; padding: 18rpx 26rpx; border-radius: 28rpx 28rpx 28rpx 8rpx; background: rgba(255,255,255,.80); box-shadow: 0 12rpx 36rpx rgba(0,41,0,.10); color: #3D4930; font-size: 25rpx; animation: bubble-in .25s ease-out; }
.feedback-bubble { top: 122rpx; }
.tap-particles { position: absolute; z-index: 12; width: 1rpx; height: 1rpx; pointer-events: none; }
.tap-particle { position: absolute; color: #FFF6A3; font-size: 30rpx; text-shadow: 0 2rpx 8rpx rgba(89,83,35,.25); animation: tap-burst .55s ease-out forwards; }
.tap-particle--one { --px:-42rpx; --py:-48rpx; }.tap-particle--two { --px:38rpx; --py:-26rpx; animation-delay:.04s }.tap-particle--three { --px:8rpx; --py:46rpx; animation-delay:.08s }
.egg.egg--wobble { animation: wobble .76s ease-in-out; }
.egg.egg--wobble .egg-shell-specular { animation: shell-glint-touch .76s ease-out; }
.egg.egg--wobble .egg-shell-depth { animation: shell-depth-touch .76s ease-out; }
.egg.egg--warming, .egg.egg--warm, .egg.egg--talk-glow { filter: drop-shadow(0 0 24rpx rgba(255,235,150,.72)); }
.egg.egg--warming { animation: warm-lean 1.2s ease-in-out infinite; }
.egg.egg--warming .egg-shell-specular { animation: shell-glint-cuddle 1.2s ease-in-out infinite; }
.egg.egg--warm { animation: warm-done .8s ease-out; }
.egg.egg--warm .egg-shell-specular, .egg.egg--talk-glow .egg-shell-specular { animation: shell-glint-warm .85s ease-out; }
.egg.egg--talk-soft { animation: wobble .8s ease-in-out; }
.egg.egg--talk-soft .egg-shell-specular, .egg.egg--talk-knock .egg-shell-specular { animation: shell-glint-touch .8s ease-out; }
.egg.egg--talk-happy { animation: happy-settle .8s ease-out; }
.egg.egg--talk-glow { animation: warm-done .85s ease-out; }
.egg.egg--talk-color { filter: sepia(.08) saturate(1.08) drop-shadow(0 0 18rpx rgba(255,221,151,.4)); }
.egg.egg--talk-knock { animation: knock .7s ease-in-out; }
.egg.egg--quiet { animation: quiet-breathe 6.8s ease-in-out infinite; }
.egg.egg--window { animation: window-lean 3.6s ease-in-out both; }
.scene--quiet .room-light-breathe { animation: room-breathe 6.8s ease-in-out infinite; }
.scene--window .window-light { animation: window-look 3.6s ease-in-out both; }
.scene--listening .egg-aura, .scene--secret .egg-aura, .scene--cuddle .egg-aura, .scene--wish .egg-aura, .scene--learn .egg-aura, .scene--draw .egg-aura { animation: aura-listen 1.1s ease-in-out infinite; }
.scene--touch .egg-aura { animation: aura-touch .76s ease-out both; }
.scene--draw .egg-aura::after { position: absolute; top: 30%; right: 16%; content: "✦"; color: rgba(255,241,151,.84); font-size: 34rpx; animation: draw-star .52s ease-out both; }

.section-title { display: block; margin-bottom: 18rpx; color: #26372C; font-size: 28rpx; font-weight: 600; }
.section-kicker { display: block; margin-bottom: 7rpx; color: #879553; font-size: 20rpx; letter-spacing: 3rpx; }
.companion-section { margin-top: 26rpx; }
.companion-section--incubating { position: absolute; z-index: 22; right: 162rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); margin: 0; }
.companion-grid { position: relative; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 0; }
.companion-icon-hint { position: absolute; z-index: 3; left: 0; bottom: calc(100% + 10rpx); width: 104rpx; padding: 9rpx 12rpx; box-sizing: border-box; border: 1rpx solid rgba(225,226,211,.92); border-radius: 999rpx; background: rgba(255,255,255,.96); box-shadow: 0 7rpx 20rpx rgba(43,55,39,.14); color: rgba(25,30,26,.96); font-size: 21rpx; font-weight: 600; line-height: 1.2; text-align: center; white-space: nowrap; opacity: 0; transform: translate(-50%, 6rpx); transition: opacity 180ms ease-out, transform 180ms ease-out; pointer-events: none; -webkit-backdrop-filter: blur(8rpx); backdrop-filter: blur(8rpx); }
.companion-icon-hint--wish { left: 71rpx; }
.companion-icon-hint--learn { left: 183rpx; }
.companion-icon-hint--draw { left: 295rpx; }
.companion-icon-hint--visible { opacity: 1; transform: translate(-50%, 0); }
.companion-primary-dock { width: 368rpx; min-width: 0; height: 112rpx; flex: 0 0 368rpx; display: flex; flex-direction: row; align-items: stretch; overflow: hidden; padding: 0 15rpx; box-sizing: border-box; border: 1rpx solid rgba(225,226,211,.9); border-radius: 56rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(43,55,39,.1), inset 0 1rpx 0 rgba(255,255,255,.72); -webkit-backdrop-filter: blur(14rpx); backdrop-filter: blur(14rpx); }
.companion-item { position: relative; min-width: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; transition: transform .16s ease, background .16s ease, opacity .16s ease; }
.companion-primary-dock .companion-item { width: 112rpx; height: 112rpx; min-height: 112rpx; flex: 0 0 112rpx; padding: 25rpx; }
.companion-item--learn::before, .companion-item--draw::before { position: absolute; left: 0; top: 22rpx; bottom: 22rpx; width: 1rpx; content: ""; background: rgba(64,82,57,.12); }
.companion-item--card { background: transparent; }
.companion-item--pressed { opacity: .9; transform: scale(.98); }
.companion-primary-dock .companion-item--pressed { background: #F7F7F4; }
.companion-item--locked { opacity: 1; }
.companion-icon-wrap { position: relative; width: 62rpx; height: 62rpx; flex: 0 0 62rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: transparent; }
.companion-icon { width: 62rpx; height: 62rpx; display: block; }
.companion-item--draw .companion-icon-wrap { overflow: visible; }
.companion-item--locked .companion-icon { filter: grayscale(1); opacity: .62; }
.companion-item--locked .companion-icon-wrap::after { position: absolute; inset: 0; border-radius: 50%; content: ""; background: rgba(112,117,108,.24); pointer-events: none; }
.draw-action-spark { position: absolute; right: -4rpx; top: -7rpx; color: #E1B24D; font-size: 25rpx; text-shadow: 0 2rpx 4rpx rgba(74,59,25,.12); transform: rotate(12deg); }
.sync-note { margin-top: 16rpx; color: #976A28; font-size: 21rpx; text-align: center; }
.home-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 26rpx; }
.pet-view--incubating .home-actions { position: absolute; z-index: 24; left: 34rpx; right: 34rpx; bottom: calc(196rpx + env(safe-area-inset-bottom)); margin: 0; }
.home-actions .primary-button { width: auto; min-width: 0; margin: 0; }
.home-actions__chat { flex: 7 1 0; }

.name-mask { position: fixed; z-index: 120; inset: 0; display: flex; align-items: flex-end; background: linear-gradient(180deg, rgba(22,31,24,.08), rgba(22,31,24,.34)); }
.name-sheet { width: 100%; max-height: 78vh; min-height: 0; display: flex; flex-direction: column; overflow-y: auto; padding: 28rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 42rpx 42rpx 0 0; background: #FFFDF8; box-shadow: 0 -18rpx 48rpx rgba(20,31,22,.16); animation: name-sheet-rise .32s cubic-bezier(.22,.61,.36,1) both; }
.name-handle { width: 72rpx; height: 8rpx; flex: 0 0 auto; margin: 0 auto 30rpx; border-radius: 999rpx; background: #D8D8D1; }
.name-sheet-content { width: 100%; margin: 0; }
.name-sheet-title { display: block; color: #26372C; font-size: 38rpx; font-weight: 600; text-align: center; }
.name-sheet-copy { display: block; margin: 16rpx auto 28rpx; color: #777B75; font-size: 23rpx; line-height: 1.6; text-align: center; }
.name-input-wrap { position: relative; }
.name-input { height: 94rpx; padding: 0 100rpx 0 26rpx; border: 2rpx solid #DDE4D7; border-radius: 22rpx; background: #FFF; color: #26372C; font-size: 30rpx; }
.name-count { position: absolute; top: 34rpx; right: 24rpx; color: #9A9C96; font-size: 20rpx; }
.name-error { display: block; margin-top: 14rpx; color: #B84B45; font-size: 21rpx; }
.name-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; }
.name-save, .name-skip { height: 96rpx; margin: 0; padding: 0; border-radius: 999rpx; font-size: 26rpx; line-height: 96rpx; }
.name-save { flex: 1 1 62%; background: #002900; color: #FFF; }
.name-skip { flex: 0 0 30%; background: transparent; color: #777B75; }
.name-save::after, .name-skip::after { border: 0; }

@keyframes name-sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }

@keyframes egg-breathe { 0%,100% { transform: scale(1); } 50% { transform: translateY(2rpx) scale(1.008,.986); } }
@keyframes egg-breathe-night { 0%,100% { transform: scale(1); } 50% { transform: translateY(1rpx) scale(1.004,.992); } }
@keyframes morning-egg-wake { 0% { transform: translateY(3rpx) scale(1,.982); } 48% { transform: translateY(-2rpx) scale(1.012,1.006); } 100% { transform: translateY(0) scale(1); } }
@keyframes aura { 0%,100% { transform: scale(.96); opacity: .42; } 50% { transform: scale(1.035); opacity: .7; } }
@keyframes wobble { 0%,100% { transform: translateY(0) rotate(0) scale(1); } 24% { transform: translateY(2rpx) rotate(-4deg) scale(.992,1.005); } 52% { transform: translateY(4rpx) rotate(2deg) scale(1.012,.982); } 72% { transform: translateY(1rpx) rotate(3.5deg) scale(.998,1.002); } }
@keyframes warm-lean { 0%,100% { transform: translateY(1rpx) rotate(0) scale(1); } 50% { transform: translateY(5rpx) rotate(1.4deg) scale(.99,.975); } }
@keyframes warm-done { 0% { transform: scale(1); } 45% { transform: translateY(3rpx) scale(1.025,.98); } 100% { transform: scale(1); } }
@keyframes happy-settle { 0%,100% { transform: translateY(0) rotate(0); } 30% { transform: translateY(-4rpx) rotate(-3deg); } 68% { transform: translateY(2rpx) rotate(3deg); } }
@keyframes knock { 0%,100% { transform: translateX(0); } 30% { transform: translateX(-4rpx) scaleX(.992); } 60% { transform: translateX(4rpx) scaleX(1.006); } }
@keyframes quiet-breathe { 0%,100% { transform: translateY(2rpx) scale(1,.99); } 50% { transform: translateY(5rpx) scale(1.008,.978); } }
@keyframes window-lean { 0%,100% { transform: rotate(0); } 30%,76% { transform: rotate(-2.2deg) translateY(2rpx); } }
@keyframes shell-glint-touch { 0%,100% { transform: translate(0,0) scale(1); opacity: 0; } 32% { transform: translate(-7%,6%) scale(1.03); opacity: .34; } 68% { transform: translate(6%,-4%) scale(1.06); opacity: .26; } }
@keyframes shell-depth-touch { 0%,100% { transform: translate(0,0) scale(1); opacity: 0; } 38% { transform: translate(-4%,2%) scale(.98,1.06); opacity: .34; } 70% { transform: translate(4%,0) scale(1.04,.96); opacity: .27; } }
@keyframes shell-glint-cuddle { 0%,100% { transform: translate(0,0) scale(1); opacity: .08; } 50% { transform: translate(2%,5%) scale(1.08,.94); opacity: .28; } }
@keyframes shell-glint-warm { 0%,100% { transform: translate(0,0) scale(1); opacity: 0; } 46% { transform: translate(-2%,4%) scale(1.16); opacity: .42; } }
@keyframes morning-shell-light { 0%,100% { transform: translate(-5%,-2%) scale(.92); opacity: .07; } 50% { transform: translate(3%,3%) scale(1); opacity: .15; } }
@keyframes sunset-shell-sweep { 0% { transform: translate(-16%,7%) scale(.9); opacity: 0; } 48% { transform: translate(14%,4%) scale(1.18); opacity: .27; } 100% { transform: translate(27%,7%) scale(1.08); opacity: .1; } }
@keyframes aura-listen { 0%,100% { transform: scale(.96); opacity: .46; } 50% { transform: scale(1.04); opacity: .74; } }
@keyframes aura-touch { 0% { transform: scale(.92); opacity: .3; } 45% { transform: scale(1.08); opacity: .74; } 100% { transform: scale(1); opacity: .45; } }
@keyframes room-breathe { 0%,100% { opacity: .08; } 50% { opacity: .8; } }
@keyframes window-light-drift { 0%,100% { transform: translateX(-10rpx) rotate(5deg); opacity: .26; } 50% { transform: translateX(18rpx) rotate(5deg); opacity: .5; } }
@keyframes window-look { 0% { transform: translateX(-70rpx) rotate(5deg); opacity: 0; } 42%,76% { transform: translateX(24rpx) rotate(5deg); opacity: .65; } 100% { transform: translateX(70rpx) rotate(5deg); opacity: 0; } }
@keyframes time-beam-morning { 0%,100% { transform: translateX(-12rpx) rotate(7deg); opacity: .08; } 50% { transform: translateX(14rpx) rotate(7deg); opacity: .24; } }
@keyframes time-beam-midday { 0%,100% { transform: translateX(-3rpx) rotate(3deg); opacity: .07; } 50% { transform: translateX(4rpx) rotate(3deg); opacity: .14; } }
@keyframes time-beam-afternoon { 0%,100% { transform: translate(-12rpx,-3rpx) rotate(10deg); opacity: .07; } 50% { transform: translate(18rpx,10rpx) rotate(10deg); opacity: .19; } }
@keyframes time-beam-sunset { 0%,100% { transform: translate(-16rpx,-4rpx) rotate(12deg); opacity: .09; } 50% { transform: translate(20rpx,12rpx) rotate(12deg); opacity: .24; } }
@keyframes time-mote-rise { 0%,100% { transform: translate(0,10rpx) scale(.75); opacity: 0; } 35% { opacity: .3; } 68% { opacity: .18; } 85% { transform: translate(5rpx,-24rpx) scale(1); opacity: 0; } }
@keyframes time-mote-midday { 0%,100% { transform: translate(0,0) scale(.8); opacity: .05; } 50% { transform: translate(3rpx,-6rpx) scale(1); opacity: .2; } }
@keyframes time-mote-afternoon { 0%,100% { transform: translate(-5rpx,4rpx) scale(.8); opacity: 0; } 35% { opacity: .24; } 78% { transform: translate(18rpx,-12rpx) scale(1); opacity: .12; } }
@keyframes time-mote-sunset { 0%,100% { transform: translate(-7rpx,5rpx) scale(.8); opacity: 0; } 38% { opacity: .3; } 76% { transform: translate(21rpx,-8rpx) scale(1.08); opacity: .14; } }
@keyframes time-night-glint { 0%,72%,100% { transform: scale(.7); opacity: 0; } 82% { transform: scale(1.15); opacity: .34; } 90% { transform: scale(.9); opacity: .08; } }
@keyframes time-sunset-glint { 0%,72%,100% { transform: translateX(0) rotate(9deg); opacity: 0; } 78% { opacity: .1; } 91% { transform: translateX(420%) rotate(9deg); opacity: .2; } 96% { opacity: 0; } }
@keyframes spring-leaf-sway { 0%,100% { transform: translate(0,0) rotate(-12deg); opacity: .08; } 50% { transform: translate(10rpx,5rpx) rotate(10deg); opacity: .3; } }
@keyframes spring-curtain-sway { 0%,100% { transform: skewX(0deg); opacity: .07; } 50% { transform: skewX(2.2deg) translateX(4rpx); opacity: .2; } }
@keyframes summer-leaf-parallax { 0%,100% { transform: translate(0,0) rotate(-12deg) scale(.92); opacity: .08; } 50% { transform: translate(18rpx,-7rpx) rotate(10deg) scale(1.08); opacity: .28; } }
@keyframes autumn-room-warmth { 0%,100% { opacity: .28; } 50% { opacity: .78; } }
@keyframes window-clear-glint { 0% { transform: translateX(-100%); opacity: 0; } 35% { opacity: .55; } 100% { transform: translateX(100%); opacity: 0; } }
@keyframes draw-star { from { transform: translateY(18rpx) scale(.6); opacity: 0; } 55% { opacity: 1; } to { transform: translateY(-12rpx) scale(1.15); opacity: 0; } }
@keyframes bubble-in { from { transform: translateY(8rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes tap-burst { from { transform: translate(0,0) scale(.7); opacity: 1; } to { transform: translate(var(--px),var(--py)) scale(1.15); opacity: 0; } }
@keyframes scene-expand-to-screen {
  from { opacity: 1; }
  to { left: 0; top: 0; width: 100vw; height: 100vh; border-radius: 0; opacity: 1; }
}
@keyframes loading-spin { to { transform:rotate(360deg); } }
@keyframes scene-loading-glow { 0%,100% { transform: translateX(-38%); opacity: .32; } 50% { transform: translateX(38%); opacity: .72; } }
@keyframes time-scene-crossfade { from { opacity: 0; } to { opacity: 1; } }
@keyframes home-stage-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes home-stage-fade-out { from { opacity: 1; } to { opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  .egg, .egg-shell-specular, .egg-shell-depth, .egg-aura, .window-light, .curtain-light, .room-light-breathe, .season-piece, .season-atmosphere, .incubation-scene-loading-glow, .time-beam, .time-mote, .time-night-glint, .time-sunset-glint { animation: none; }
  .incubation-full-scene-image--revealing { animation-duration: 20ms; }
  .home-stage--entering, .home-stage--exiting { animation-duration: 20ms; }
  .room-clock { transition: none; }
  .companion-icon-hint { transition: none; }
  .name-sheet { animation: none; }
  .companion-item { transition: none; }
  .companion-item--pressed { transform: none; }
  .tap-particle--two, .tap-particle--three { display: none; }
  .tap-particle--one { animation: tap-fade .45s ease-out forwards; }
}
@keyframes tap-fade { from { opacity: 1; } to { opacity: 0; } }
