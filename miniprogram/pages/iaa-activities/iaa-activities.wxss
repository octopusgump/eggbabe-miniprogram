.activities-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAFAF8;
  color: #002900;
}

.activities-page .navbar-root {
  background: #FAFAF8;
  border-bottom: none;
}

.system-notice-anchor {
  position: fixed;
  /* 高于 nav-bar（z-index: 200），toast 须完整露在导航下方 */
  z-index: 220;
  top: calc(env(safe-area-inset-top) + 112rpx + 20rpx);
  left: 72rpx;
  right: 72rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.activities-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.activities-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 48rpx 32rpx;
}

.activities-balance {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.activities-balance__star {
  width: 80rpx;
  height: 80rpx;
}

.activities-balance__count {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  color: #002900;
}

.activities-balance__label {
  font-size: 26rpx;
  line-height: 1.2;
  color: #6B6B66;
}

.activities-section {
  padding: 8rpx 32rpx 0;
}

.activities-section__title {
  display: block;
  padding: 8rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #374039;
}

.activities-card {
  border: 1rpx solid #E5E3DF;
  border-radius: 32rpx;
  background: #FFF;
  overflow: hidden;
}

.activities-card__divider {
  height: 1rpx;
  background: #E8E8E4;
  margin: 0 2rpx;
}

.activities-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.activities-row--coming-soon {
  padding-right: 24rpx;
}

.activities-row__wish {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: -24rpx 0 -24rpx -32rpx;
  padding: 24rpx 8rpx 24rpx 32rpx;
  border-radius: 32rpx 0 0 32rpx;
  box-sizing: border-box;
  transition: background 120ms ease-out;
}

.activities-row__wish--active {
  background: #E6EED0;
}

.activities-wish-float {
  position: absolute;
  z-index: 4;
  left: 58%;
  top: 8rpx;
  width: 96rpx;
  height: 96rpx;
  pointer-events: none;
  animation: activities-wish-float 800ms ease-out both;
}

.activities-wish-float__plus {
  position: absolute;
  left: 50%;
  top: 50%;
  color: #FFDD79;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 2rpx 10rpx rgba(72, 50, 12, 0.32);
  transform: translate(-50%, -50%);
  animation: activities-wish-plus-pop 800ms cubic-bezier(0.2, 0.9, 0.3, 1) both,
    activities-wish-plus-flash 800ms ease-in-out both;
}

.activities-wish-float__spark {
  position: absolute;
  border-radius: 50%;
  background: #FFE7A3;
  box-shadow: 0 0 8rpx rgba(255, 221, 121, 0.8);
  opacity: 0;
  animation: activities-wish-spark 800ms ease-out both;
}

.activities-wish-float__spark--1 {
  left: 8rpx;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
}

.activities-wish-float__spark--2 {
  left: 72rpx;
  top: 10rpx;
  width: 6rpx;
  height: 6rpx;
  animation-delay: 40ms;
}

.activities-wish-float__spark--3 {
  left: 44rpx;
  top: 2rpx;
  width: 10rpx;
  height: 10rpx;
  animation-delay: 80ms;
}

.activities-wish-float__spark--4 {
  left: 86rpx;
  top: 36rpx;
  width: 6rpx;
  height: 6rpx;
  animation-delay: 120ms;
}

@keyframes activities-wish-float {
  0% {
    transform: translateY(0);
    opacity: 1;
  }
  100% {
    transform: translateY(-96rpx);
    opacity: 0;
  }
}

@keyframes activities-wish-plus-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.45);
  }
  10% {
    opacity: 1;
    transform: translate(-50%, -58%) scale(1.14);
  }
  18% {
    transform: translate(-50%, -52%) scale(0.96);
  }
  24% {
    transform: translate(-50%, -54%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -154%) scale(1);
  }
}

@keyframes activities-wish-plus-flash {
  0%,
  18%,
  100% {
    opacity: 1;
  }
  28%,
  48%,
  68% {
    opacity: 0.32;
  }
  38%,
  58%,
  78% {
    opacity: 1;
  }
}

@keyframes activities-wish-spark {
  0% {
    opacity: 0;
    transform: translateY(12rpx) scale(0.6);
  }
  12% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateY(-88rpx) scale(0.8);
  }
}

@media (prefers-reduced-motion: reduce) {
  .activities-wish-float {
    animation-duration: 20ms;
  }
  .activities-wish-float__plus,
  .activities-wish-float__spark {
    animation: none;
    opacity: 0;
  }
}

.activities-row__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.activities-row__icon--dimmed {
  opacity: 0.5;
}

.activities-row__title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #002900;
}

.activities-row__title--dimmed {
  opacity: 0.55;
}

.activities-cta {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 160rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #002900;
  box-sizing: border-box;
}

.activities-cta--wide {
  min-width: 184rpx;
}

.activities-cta--disabled {
  background: #AEB9AE;
}

.activities-cta__text {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
  color: #FFF;
}

.activities-cta--disabled .activities-cta__text {
  opacity: 0.86;
}

.activities-cta__star {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFDD79;
}

.activities-coming-soon-overlay {
  position: fixed;
  z-index: 500;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.32);
}

.activities-coming-soon-dialog {
  width: 622rpx;
  max-width: 100%;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5E3DF;
  border-radius: 32rpx;
  background: #FFF;
  box-shadow: 0 20rpx 48rpx rgba(0, 41, 0, 0.12);
}

.activities-coming-soon-icon {
  display: block;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 32rpx;
  border-radius: 16rpx;
}

.activities-coming-soon-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.activities-coming-soon-title {
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.25;
}

.activities-coming-soon-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #E9E8E4;
  color: #6F6F6A;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
}

.activities-coming-soon-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 36rpx;
}

.activities-coming-soon-line {
  color: #5C5C5C;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.activities-coming-soon-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #002900;
  color: #FFF;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

.activities-coming-soon-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}
