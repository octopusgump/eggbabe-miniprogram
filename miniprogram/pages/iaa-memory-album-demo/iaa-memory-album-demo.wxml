<view class="memory-page">
  <nav-bar title="纪念册"></nav-bar>
  <scroll-view class="memory-scroll" scroll-y>
    <view class="album-tabs"><view class="album-tab {{section === 'memories' ? 'album-tab--active' : ''}}" data-section="memories" bindtap="onSelectSection">回忆</view><view class="album-tab {{section === 'activities' ? 'album-tab--active' : ''}}" data-section="activities" bindtap="onSelectSection">活动</view></view>
    <view wx:if="{{section === 'activities'}}" class="album-activities"><view wx:for="{{activities}}" wx:key="key" class="album-activity" data-key="{{item.key}}" bindtap="onOpenActivity"><text>{{item.title}}</text><text class="album-activity__cost">{{item.key === 'tea' && firstActivityFree ? '首次免费' : item.cost + ' 星'}}</text></view></view>
    <block wx:else>
    <view wx:if="{{mode === modes.LOADING}}" class="state-panel" aria-live="polite">
      <view class="state-illustration">…</view>
      <text class="state-title">正在打开纪念册</text>
    </view>

    <view wx:elif="{{mode === modes.EMPTY}}" class="state-panel" aria-live="polite">
      <view class="state-illustration state-illustration--empty">✦</view>
      <text class="state-title">还没有共同纪念</text>
      <text class="state-copy">以后一起经历的小事，会慢慢留在这里。</text>
    </view>

    <view wx:elif="{{mode === modes.ERROR}}" class="state-panel state-panel--error" aria-live="polite">
      <view class="state-illustration state-illustration--error">!</view>
      <text class="state-title">纪念册暂时打不开</text>
      <text class="state-copy">请稍后再试。</text>
      <view class="state-button" aria-role="button" bindtap="onRetry">重新试试</view>
    </view>

    <block wx:else>
      <view class="memory-grid" aria-label="回忆方格">
        <view wx:for="{{gridItems}}" wx:key="listKey" class="memory-grid__slot">
          <view
            class="memory-grid__cell {{selectedGridKey === item.listKey ? 'memory-grid__cell--selected' : ''}} {{item.locked ? 'memory-grid__cell--locked' : ''}}"
            data-key="{{item.listKey}}"
            bindtap="onTapGridCell"
            aria-role="button"
            aria-label="{{item.locked ? '暗格，待解锁' : '打开回忆'}}"
          >
            <view class="memory-grid__inner">
              <view wx:if="{{item.cellKind === 'polaroid'}}" class="memory-cell memory-cell--polaroid">
                <image class="memory-cell__photo" src="{{item.image}}" mode="aspectFill"></image>
              </view>
              <view wx:elif="{{item.cellKind === 'keepsake'}}" class="memory-cell memory-cell--keepsake">
                <image class="memory-cell__photo" src="{{item.image}}" mode="aspectFit"></image>
              </view>
              <view wx:elif="{{item.cellKind === 'drawing'}}" class="memory-cell memory-cell--drawing">
                <image class="memory-cell__photo" src="{{item.image}}" mode="aspectFill"></image>
              </view>
              <view wx:elif="{{item.cellKind === 'postcard_locked'}}" class="memory-cell memory-cell--postcard-locked">
                <image class="memory-cell__photo memory-cell__photo--locked-blur" src="{{item.image}}" mode="aspectFill"></image>
                <view class="memory-cell__locked-dim"></view>
                <view class="memory-cell__lock" aria-hidden="true">
                  <view class="memory-cell__lock-shackle"></view>
                  <view class="memory-cell__lock-body"></view>
                </view>
              </view>
              <view wx:elif="{{item.cellKind === 'postcard'}}" class="memory-cell memory-cell--postcard">
                <view class="memory-cell__postcard-frame">
                  <image class="memory-cell__photo" src="{{item.image}}" mode="aspectFill"></image>
                </view>
              </view>
            </view>
          </view>
          <text wx:if="{{item.locked}}" class="memory-grid__caption">暗格 · 待解锁</text>
        </view>
      </view>

      <view wx:if="{{selectedMemory}}" class="memory-grid-expand" aria-live="polite">
        <view class="memory-grid-expand__hero">
          <view wx:if="{{selectedMemory.cellKind === 'polaroid'}}" class="memory-cell memory-cell--polaroid memory-cell--expand">
            <image wx:if="{{!selectedPhotoFailed}}" class="memory-cell__photo" src="{{selectedMemory.image}}" mode="aspectFit" bindload="onSelectedPhotoLoad" binderror="onSelectedPhotoError" bindtap="onPreviewMemory"></image>
            <view wx:else class="memory-grid-expand__retry" bindtap="onRetrySelectedPhoto">重试</view>
          </view>
          <view wx:elif="{{selectedMemory.cellKind === 'keepsake'}}" class="memory-cell memory-cell--keepsake memory-cell--expand">
            <image class="memory-cell__photo" src="{{selectedMemory.image}}" mode="aspectFit" bindtap="onPreviewMemory"></image>
          </view>
          <view wx:elif="{{selectedMemory.cellKind === 'drawing'}}" class="memory-cell memory-cell--drawing memory-cell--expand">
            <image class="memory-cell__photo" src="{{selectedMemory.image}}" mode="aspectFit" bindtap="onPreviewMemory"></image>
          </view>
          <view wx:elif="{{selectedMemory.cellKind === 'postcard'}}" class="memory-cell memory-cell--postcard memory-cell--expand">
            <view class="memory-cell__postcard-frame memory-cell__postcard-frame--expand">
              <image class="memory-cell__photo" src="{{selectedMemory.image}}" mode="aspectFit" bindtap="onPreviewMemory"></image>
            </view>
          </view>
        </view>
        <view wx:if="{{selectedMemory.metaPill}}" class="memory-grid-expand__notice">
          <inline-notice text="{{selectedMemory.metaPill}}" tone="info" visible="{{true}}"></inline-notice>
        </view>
        <view wx:if="{{selectedMemory.pending && !selectedMemory.collected}}" class="memory-grid-expand__actions">
          <button class="memory-grid-expand__secondary tea-confirm" disabled="{{!selectedPhotoReady}}" bindtap="onCollectPendingPhoto"><text class="button-label">收下</text></button>
        </view>
        <view wx:elif="{{selectedMemory.source === 'paper' || selectedMemory.source === 'exchange' || selectedMemory.cellKind === 'polaroid'}}" class="memory-grid-expand__actions">
          <view wx:if="{{selectedPhotoReady && !selectedPhotoFailed}}" class="memory-grid-expand__secondary" bindtap="onSaveMemory">保存</view>
        </view>
        <view class="memory-grid-expand__close" aria-role="button" bindtap="onCloseDetail">关闭</view>
      </view>
    </block>

    </block>
    <view wx:if="{{isDemo && !roomEntry}}" class="demo-switcher">
      <view class="demo-switcher__heading">
        <text class="demo-switcher__title">开发态页面状态</text>
        <text class="demo-switcher__version">{{contractVersion}}</text>
      </view>
      <view class="demo-switcher__grid">
        <view wx:for="{{modeOptions}}" wx:key="value" class="demo-chip {{mode === item.value ? 'demo-chip--active' : ''}}" aria-role="button" data-mode="{{item.value}}" bindtap="onSelectMode">{{item.label}}</view>
      </view>
      <text class="demo-switcher__note">LOCAL FIXTURE · 无网络 · 无账户写入</text>
    </view>
    <view class="safe-space"></view>
    <view wx:if="{{selectedActivity}}" class="album-detail-mask" bindtap="onCloseDetail"><view class="album-detail" catchtap="noop"><view class="album-detail__close" bindtap="onCloseDetail">×</view><block><text>{{selectedActivity.title}}</text><block wx:if="{{selectedActivity.key === 'exchange' && exchange}}"><text class="memory-card__line">{{exchange.line}}</text><text class="memory-card__line">10 星</text><text wx:if="{{exchangeInsufficient && !exchange.owned}}" class="memory-card__line">星星还不够</text><text wx:if="{{exchangeFailed}}" class="memory-card__line">照片暂时打不开</text><button class="album-detail__save tea-confirm" disabled="{{exchangeLoading || (exchangeInsufficient && !exchange.owned)}}" bindtap="onExchangePhoto"><text class="button-label">{{exchange.owned ? '已拥有' : exchangeFailed ? '重试' : '确认兑换'}}</text></button></block><text wx:else class="memory-card__line">{{selectedActivity.key === 'tea' && firstActivityFree ? '首次免费' : '需花费 ' + selectedActivity.cost + ' 星'}}</text><view wx:if="{{selectedActivity.key === 'tea'}}" class="album-detail__save" bindtap="onStartTea">{{tea ? '继续' : '开始'}}</view></block></view></view>
    <view wx:if="{{teaVisible && tea}}" class="album-detail-mask" bindtap="onCloseTea"><view class="album-detail tea-detail" catchtap="noop">
      <view class="album-detail__close" bindtap="onCloseTea">×</view>
      <text>窗边茶会</text>
      <image wx:if="{{!teaPhotoFailed}}" class="tea-photo {{tea.phase !== 'result' ? 'tea-photo--preload' : ''}}" src="{{tea.photo.image}}" mode="aspectFit" bindload="onTeaPhotoLoad" binderror="onTeaPhotoError"></image>
      <block wx:if="{{teaPhotoFailed}}"><text class="memory-card__line">照片暂时打不开</text><view class="album-detail__save" bindtap="onRetryTeaPhoto">重试</view></block>
      <block wx:elif="{{tea.phase === 'result'}}"><text class="memory-card__line">{{tea.photo.line}}</text><view class="album-detail__save" bindtap="onCollectTea">收下</view></block>
      <block wx:else>
        <view class="tea-options"><view wx:for="{{teaOptions}}" wx:key="key" class="tea-option {{tea.choice === item.key ? 'tea-option--selected' : ''}}" data-key="{{item.key}}" bindtap="onChooseTea">{{item.label}}</view></view>
        <text wx:if="{{teaReply}}" class="memory-card__line tea-reply">{{teaReply}}</text>
        <button wx:if="{{tea.phase === 'confirming'}}" class="album-detail__save tea-confirm" disabled="{{!teaPhotoReady}}" bindtap="onConfirmTea"><text class="button-label">{{tea.cost ? '确认 · 需花费 20 星' : '确认 · 免费'}}</text></button>
      </block>
    </view></view>
  </scroll-view><canvas type="2d" id="polaroid-canvas" class="polaroid-canvas"></canvas>
</view>
