@import "../../styles/iaa-memory-demo.wxss";

.memory-list { margin-top: 32rpx; }
.memory-card { overflow: hidden; margin-top: 20rpx; border-radius: 30rpx; background: #FFFDF8; }
.memory-card:first-child { margin-top: 0; }
.memory-card__image { display: block; width: 100%; height: 320rpx; background: #DDE3D6; }
.memory-card__copy { padding: 26rpx 28rpx 30rpx; }
.memory-card__date, .memory-card__title, .memory-card__line { display: block; }
.memory-card__date { color: #8A9089; font-size: 19rpx; }
.memory-card__title { margin-top: 10rpx; color: #29402F; font-size: 29rpx; line-height: 1.35; font-weight: 600; }
.memory-card__line { margin-top: 10rpx; color: #727A73; font-size: 22rpx; line-height: 1.6; }
.demo-switcher { margin-top: 32rpx; padding: 26rpx; border: 1rpx dashed #B8BBB2; border-radius: 30rpx; background: rgba(255, 255, 255, 0.52); }
.demo-switcher__heading { display: flex; justify-content: space-between; gap: 20rpx; }
.demo-switcher__title { color: #49564C; font-size: 23rpx; font-weight: 600; }
.demo-switcher__version { color: #8C8F88; font-size: 17rpx; }
.demo-switcher__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-top: 20rpx; }
.demo-chip { min-height: 76rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #DFDFD7; border-radius: 999rpx; background: #FFF; color: #697168; font-size: 21rpx; }
.demo-chip--active { border-color: #76876A; background: #E9EFDF; color: #314D35; font-weight: 600; }
.demo-switcher__note { display: block; margin-top: 18rpx; color: #92948D; font-size: 17rpx; text-align: center; letter-spacing: 0.6rpx; }

.album-tabs{display:flex;gap:40rpx}.album-tab{font-size:28rpx;min-height:88rpx;display:flex;align-items:center;color:#5C5C5C}.album-tab--active{color:#002900;text-decoration:underline;text-underline-offset:12rpx}.album-activity{margin-top:24rpx;min-height:112rpx;border:1rpx solid #E5E3DF;border-radius:24rpx;background:#FFFDF8;padding:28rpx;display:flex;justify-content:space-between;color:#35483C;font-size:28rpx}.album-activity__cost{color:#5C5C5C;font-size:24rpx}.album-detail-mask{position:fixed;inset:0;z-index:300;background:rgba(29,34,30,.38);display:flex;align-items:center;justify-content:center;padding:36rpx}.album-detail{position:relative;width:100%;padding:60rpx 36rpx 36rpx;background:#FFFDF8;border-radius:24rpx;color:#35483C;font-size:28rpx}.album-detail image{display:block;width:100%;height:480rpx;background:#FFF}.album-detail__close{position:absolute;top:8rpx;right:8rpx;width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx}.album-detail__save{margin-top:28rpx;min-height:88rpx;border-radius:999rpx;background:#002900;color:#FFF;display:flex;align-items:center;justify-content:center}

.tea-options{display:flex;gap:20rpx;margin-top:32rpx}.tea-option{flex:1;min-height:96rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #E5E3DF;border-radius:24rpx;background:#FFFDF8}.tea-option--selected{border-color:#5C765B;background:#EDF2E6}.tea-reply{min-height:72rpx}.tea-confirm{font-size:26rpx;padding:0;border:0}.tea-confirm::after{border:0}.tea-confirm[disabled]{background:#B5BCB0;color:#FFF}.album-detail .tea-photo--preload{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}.tea-detail{max-height:80vh;overflow-y:auto}

.memory-card .polaroid-photo, .album-detail .polaroid-photo { box-sizing:border-box; padding:16rpx 16rpx 48rpx; background:#FFF; height:auto; }
.polaroid-canvas { position:fixed; left:-2000px; top:-2000px; width:1024px; height:1200px; pointer-events:none; }
