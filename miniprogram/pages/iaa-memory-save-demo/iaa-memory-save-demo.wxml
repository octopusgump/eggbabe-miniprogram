<view class="memory-page save-page">
  <nav-bar title="保存这一刻"></nav-bar>
  <scroll-view class="memory-scroll" scroll-y>
    <view wx:if="{{loading}}" class="state-panel state-panel--detail" aria-live="polite">
      <view class="state-illustration state-illustration--loading"><view class="loading-ring"></view></view>
      <text class="state-title">正在整理这一刻</text>
      <text class="state-copy">只生成本地静态预览，不访问系统相册。</text>
    </view>

    <view wx:elif="{{error}}" class="state-panel state-panel--error" aria-live="polite">
      <view class="state-illustration state-illustration--error">!</view>
      <text class="state-title">暂时不能预览</text>
      <text class="state-copy">{{error}}</text>
      <view class="state-button" aria-role="button" bindtap="onRetry">重新试试</view>
    </view>

    <view wx:else class="save-wrap">
      <view class="save-intro">
        <text class="page-eyebrow">STATIC CARD PREVIEW</text>
        <text class="page-title">把这一刻轻轻放好</text>
        <text class="page-subtitle">没有拉新奖励、二维码或分享任务。</text>
      </view>

      <view class="keepsake-card">
        <image class="keepsake-card__scene" src="{{card.sceneImage}}" mode="aspectFill"></image>
        <view class="keepsake-card__shade"></view>
        <view class="keepsake-card__top">
          <text class="keepsake-card__brand">{{card.brand}}</text>
          <text class="keepsake-card__mock">MOCK</text>
        </view>
        <view class="keepsake-card__copy">
          <text class="keepsake-card__date">{{card.date}}</text>
          <text class="keepsake-card__title">{{card.title}}</text>
          <text class="keepsake-card__quote">{{card.quote}}</text>
          <view class="keepsake-card__rule"></view>
          <text class="keepsake-card__signature">和玉兔一起记住的事</text>
        </view>
      </view>

      <view class="preview-button" aria-role="button" bindtap="onPreviewSave">预览保存反馈</view>
      <text wx:if="{{previewNotice}}" class="preview-notice" aria-live="polite">{{previewNotice}}</text>
      <text class="detail-footnote">LOCAL FIXTURE · 不保存图片 · 不唤起分享 · 不写入账户</text>
    </view>
    <view class="safe-space"></view>
  </scroll-view>
</view>
