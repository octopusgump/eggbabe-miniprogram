page{height:100%;background:#F5F0E5}
.star-page{position:relative;min-height:100vh;overflow:hidden;background:linear-gradient(180deg,#E9EFE3 0%,#F5F0E5 52%,#EFE7DB 100%);color:#304137;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.star-topbar{position:fixed;z-index:30;left:24rpx;right:24rpx;display:flex;align-items:center;justify-content:space-between;pointer-events:none}
.round-action,.dev-entry,.topbar-spacer{width:88rpx;height:88rpx;box-sizing:border-box}
.round-action,.dev-entry{display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.72);border-radius:999rpx;background:rgba(255,255,255,.84);box-shadow:0 12rpx 28rpx rgba(58,66,55,.12);backdrop-filter:blur(18rpx);pointer-events:auto}
.round-action text{margin-top:-6rpx;font-family:Arial,sans-serif;font-size:58rpx;font-weight:300;line-height:1}
.dev-entry{font-size:22rpx;font-weight:650;letter-spacing:2rpx}.dev-entry--active{background:#314D3B;color:#FFF}
.star-wordmark{display:flex;flex-direction:column;align-items:center}.star-wordmark__main{font-size:30rpx;font-weight:650;letter-spacing:3rpx}.star-wordmark__sub{margin-top:4rpx;color:#748176;font-size:19rpx;letter-spacing:2rpx}
.dev-panel{position:fixed;z-index:29;left:24rpx;right:24rpx;padding:24rpx;border:1rpx solid rgba(255,255,255,.72);border-radius:30rpx;background:rgba(250,249,245,.95);box-shadow:0 18rpx 52rpx rgba(41,55,46,.18);backdrop-filter:blur(20rpx)}
.dev-panel__head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;font-size:25rpx;font-weight:650}.dev-panel__source{padding:7rpx 12rpx;border-radius:999rpx;background:#EDF0E7;color:#647064;font-size:18rpx;font-weight:500}.dev-options{display:flex;gap:10rpx}.dev-chip{min-width:110rpx;height:66rpx;display:flex;flex:1;align-items:center;justify-content:center;box-sizing:border-box;padding:0 14rpx;border-radius:999rpx;background:#EEECE4;color:#687369;font-size:21rpx}.dev-chip--active{background:#314D3B;color:#FFF}
.ambient{position:absolute;border-radius:50%;filter:blur(4rpx);opacity:.55}.ambient--one{top:110rpx;right:-130rpx;width:420rpx;height:420rpx;background:radial-gradient(circle,#FFF6C9 0%,rgba(255,246,201,0) 70%)}.ambient--two{left:-170rpx;bottom:80rpx;width:460rpx;height:460rpx;background:radial-gradient(circle,#D3E2D2 0%,rgba(211,226,210,0) 70%)}
.star-content{position:relative;z-index:2;min-height:100vh;box-sizing:border-box;padding:190rpx 38rpx calc(38rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column}
.star-hero{display:flex;align-items:center;flex-direction:column;text-align:center}.star-hero__eyebrow{color:#738074;font-size:22rpx;letter-spacing:3rpx}.star-count{height:156rpx;display:flex;align-items:center;justify-content:center;margin-top:8rpx}.star-count__symbol{margin-right:10rpx;color:#DBAE54;font-size:74rpx;text-shadow:0 8rpx 24rpx rgba(194,143,43,.18)}.star-count__number{color:#2D4135;font-family:Georgia,serif;font-size:126rpx;line-height:1}.star-hero__label{margin-top:2rpx;color:#778178;font-size:22rpx}.star-gain{display:flex;align-items:center;gap:12rpx;margin-top:16rpx;padding:11rpx 19rpx;border-radius:999rpx;background:#FFF8D9;color:#7D6228;font-size:21rpx;animation:gain-in .45s cubic-bezier(.2,.9,.25,1.15)}.star-gain text:first-child{font-size:29rpx;font-weight:700}
.progress-card{margin-top:38rpx;padding:30rpx;border:1rpx solid rgba(101,112,96,.10);border-radius:34rpx;background:rgba(255,255,255,.76);box-shadow:0 20rpx 46rpx rgba(64,69,59,.08);backdrop-filter:blur(16rpx)}.progress-card__head{display:flex;align-items:flex-start;justify-content:space-between}.progress-card__head>view{display:flex;flex-direction:column}.progress-card__kicker{color:#879087;font-size:20rpx;letter-spacing:2rpx}.progress-card__title{margin-top:5rpx;color:#34463B;font-size:31rpx;font-weight:650}.progress-card__count{color:#7C876D;font-family:Georgia,serif;font-size:28rpx}.progress-track{height:16rpx;overflow:hidden;margin-top:26rpx;border-radius:999rpx;background:#E7E7DC}.progress-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#8CAB82,#D7B563);transition:width .5s cubic-bezier(.2,.8,.2,1)}.progress-card__hint{display:block;margin-top:16rpx;color:#727D74;font-size:21rpx;line-height:1.5;overflow-wrap:anywhere}
.rule-note{display:flex;align-items:flex-start;gap:13rpx;margin-top:22rpx;padding:0 10rpx;color:#768078;font-size:21rpx;line-height:1.55}.rule-note__icon{flex:none;width:26rpx;height:26rpx;display:flex;align-items:center;justify-content:center;margin-top:2rpx;border:2rpx solid #8D9B8C;border-radius:50%;font-size:0}
.error-card{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:22rpx;padding:22rpx 24rpx;border:1rpx solid rgba(145,101,79,.13);border-radius:26rpx;background:#F8EBE3}.error-card>view:first-child{display:flex;min-width:0;flex:1;flex-direction:column}.error-card__title{color:#765747;font-size:24rpx;font-weight:650}.error-card__copy{margin-top:4rpx;color:#8D7466;font-size:20rpx;line-height:1.45}.error-card__retry{flex:none;min-width:146rpx;height:80rpx;display:flex;align-items:center;justify-content:center;padding:0 18rpx;border-radius:999rpx;background:#715B4E;color:#FFF;font-size:21rpx}.duplicate-feedback{display:block;margin-top:18rpx;color:#617263;font-size:22rpx;line-height:1.5;text-align:center}
.companion-action{min-height:96rpx;display:flex;align-items:center;justify-content:center;gap:14rpx;box-sizing:border-box;margin-top:auto;padding:18rpx 28rpx;border-radius:999rpx;background:#314D3B;color:#FFF;font-size:26rpx;font-weight:650;box-shadow:0 15rpx 30rpx rgba(49,77,59,.18)}.companion-action--soft{background:#D9E4D6;color:#456048;box-shadow:none}.companion-action--busy{opacity:.68}.companion-action__icon{font-size:30rpx}.mock-note{display:block;margin-top:13rpx;color:#9A9A92;font-size:18rpx;text-align:center}
.loading-state{height:100vh;display:flex;align-items:center;justify-content:center;gap:18rpx;flex-direction:column;color:#748076;font-size:24rpx}.loading-star{color:#D2A850;font-size:70rpx;animation:star-breathe 1.4s ease-in-out infinite}
.unlock-backdrop{position:fixed;z-index:50;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:26rpx;box-sizing:border-box;background:rgba(29,36,31,.38);backdrop-filter:blur(10rpx)}.unlock-sheet{position:relative;width:100%;box-sizing:border-box;padding:28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));overflow:hidden;border-radius:42rpx;background:#FFFCF4;text-align:center;box-shadow:0 30rpx 80rpx rgba(23,30,25,.25);animation:unlock-rise .55s cubic-bezier(.18,.9,.26,1.08)}.unlock-sheet__eyebrow{display:block;color:#9A8050;font-size:21rpx;letter-spacing:3rpx}.unlock-sheet__image{width:100%;height:320rpx;display:block;margin-top:22rpx;border-radius:28rpx}.unlock-sheet__title{display:block;margin-top:25rpx;color:#33443A;font-size:38rpx;font-weight:650}.unlock-sheet__copy{display:block;margin:11rpx auto 0;max-width:540rpx;color:#738077;font-size:24rpx;line-height:1.65;overflow-wrap:anywhere}.unlock-sheet__action{height:96rpx;display:flex;align-items:center;justify-content:center;margin-top:25rpx;border-radius:999rpx;background:#314D3B;color:#FFF;font-size:25rpx;font-weight:650}.unlock-spark{position:absolute;color:#DBB55D;font-size:34rpx;animation:spark-float 1.8s ease-in-out infinite}.unlock-spark--one{top:34rpx;left:46rpx}.unlock-spark--two{top:72rpx;right:48rpx;animation-delay:.3s}.unlock-spark--three{top:112rpx;left:22rpx;font-size:22rpx;animation-delay:.6s}
@keyframes gain-in{from{opacity:0;transform:translateY(10rpx) scale(.88)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes star-breathe{0%,100%{opacity:.45;transform:scale(.88) rotate(-6deg)}50%{opacity:1;transform:scale(1.08) rotate(4deg)}}@keyframes unlock-rise{from{opacity:0;transform:translateY(80rpx) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes spark-float{0%,100%{opacity:.35;transform:translateY(4rpx) rotate(-5deg)}50%{opacity:1;transform:translateY(-7rpx) rotate(6deg)}}
@media (prefers-reduced-motion:reduce){.star-gain,.loading-star,.unlock-sheet,.unlock-spark{animation:none}.progress-fill{transition:none}}
