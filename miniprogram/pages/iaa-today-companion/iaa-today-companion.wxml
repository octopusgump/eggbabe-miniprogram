<view class="today-page today-page--{{view ? view.today.accent : 'sage'}}">
  <view class="today-topbar" style="top:{{topInset}}px;">
    <view class="round-action" aria-role="button" aria-label="返回" bindtap="onBack"><text>‹</text></view>
    <view class="today-wordmark"><text class="today-wordmark__main">今日陪伴</text></view>
    <view wx:if="{{isDev}}" class="dev-entry {{devPanelOpen ? 'dev-entry--active' : ''}}" aria-role="button" aria-label="{{devPanelOpen ? '收起验收状态' : '展开验收状态'}}" bindtap="onToggleDevPanel"><text>验收</text></view>
    <view wx:else class="topbar-spacer"></view>
  </view>

  <view wx:if="{{isDev && devPanelOpen}}" class="dev-sheet-backdrop" aria-role="button" aria-label="关闭开发验收" bindtap="onToggleDevPanel"></view>
  <view wx:if="{{isDev && devPanelOpen}}" class="dev-panel">
    <view class="dev-panel__head"><text>开发验收</text><view class="dev-panel__close" aria-role="button" bindtap="onToggleDevPanel"><text>收起</text></view></view>
    <view class="dev-facts">
      <view class="dev-fact"><text class="dev-fact__label">当前状态</text><text class="dev-fact__value">{{screenState}}</text></view>
      <view class="dev-fact"><text class="dev-fact__label">数据来源</text><text class="dev-fact__value">本地 fixture</text></view>
      <view class="dev-fact"><text class="dev-fact__label">用户正式可见</text><text class="dev-fact__value">否（仅开发版）</text></view>
      <view class="dev-fact"><text class="dev-fact__label">正式接口</text><text class="dev-fact__value">尚未接入</text></view>
    </view>
    <view class="dev-row">
      <text class="dev-row__label">场景</text>
      <view class="dev-options">
        <view wx:for="{{scenarioOptions}}" wx:key="key" class="dev-chip {{selectedScenario === item.key ? 'dev-chip--active' : ''}}" data-key="{{item.key}}" aria-role="button" bindtap="onScenarioSelect"><text>{{item.label}}</text></view>
      </view>
    </view>
    <view class="dev-row">
      <text class="dev-row__label">页面</text>
      <view class="dev-options">
        <view wx:for="{{viewStateOptions}}" wx:key="key" class="dev-chip {{selectedViewState === item.key ? 'dev-chip--active' : ''}}" data-key="{{item.key}}" aria-role="button" bindtap="onViewStateSelect"><text>{{item.label}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{screenState === 'loading'}}" class="state-stage">
    <view class="soft-loader"><view class="soft-loader__dot soft-loader__dot--one"></view><view class="soft-loader__dot soft-loader__dot--two"></view><view class="soft-loader__dot soft-loader__dot--three"></view></view>
    <text class="state-stage__title">正在推开今天的门</text>
    <text class="state-stage__copy">看看玉兔现在在做什么。</text>
  </view>

  <view wx:elif="{{screenState === 'empty'}}" class="state-stage">
    <view class="empty-window"><view class="empty-window__sun"></view><view class="empty-window__sill"></view></view>
    <text class="state-stage__title">今天的房间还没准备好</text>
    <text class="state-stage__copy">这里会放下玉兔今天的一小段生活。</text>
    <view class="state-stage__action" aria-role="button" bindtap="onRetry"><text>再看一下</text></view>
  </view>

  <view wx:elif="{{screenState === 'error'}}" class="state-stage state-stage--error">
    <view class="error-leaf"><text>⌁</text></view>
    <text class="state-stage__title">刚才没有看清</text>
    <text class="state-stage__copy">{{errorMessage}}</text>
    <view class="state-stage__action" aria-role="button" bindtap="onRetry"><text>重新看看</text></view>
  </view>

  <view wx:elif="{{screenState === 'unavailable'}}" class="state-stage">
    <view class="empty-window"><view class="empty-window__sun"></view><view class="empty-window__sill"></view></view>
    <text class="state-stage__title">今天的陪伴还在准备</text>
    <text class="state-stage__copy">等准备好以后，你就能在这里陪玉兔待一会儿。</text>
  </view>

  <block wx:elif="{{screenState === 'ready' && view}}">
    <view class="scene-frame">
      <image class="scene-image" src="{{view.today.sceneImage}}" mode="aspectFill"></image>
      <view class="scene-wash"></view>
      <view class="scene-meta">
        <text class="scene-meta__date">{{view.displayDate}}</text>
        <text class="scene-meta__eyebrow">{{view.today.eyebrow}}</text>
      </view>
      <view wx:if="{{view.today.scenarioKey === 'away'}}" class="paper-note"><text class="paper-note__pin">●</text><text>{{view.today.line}}</text></view>
    </view>

    <view class="letter-stage">
      <view class="letter-paper">
        <text class="letter-title">{{view.today.title}}</text>
        <text wx:if="{{view.today.scenarioKey !== 'away'}}" class="letter-line">“{{view.today.line}}”</text>

        <view class="interaction-area">
          <view wx:if="{{!interactionDone}}" class="companion-action {{interactionPending ? 'companion-action--pending' : ''}}" aria-role="button" aria-label="{{view.today.interactionLabel}}" bindtap="onInteract">
            <text class="companion-action__copy">{{interactionPending ? '正在收好这一会儿' : view.today.interactionLabel}}</text>
          </view>
          <text wx:if="{{interactionDone}}" class="interaction-feedback">{{interactionFeedback}}</text>
          <text wx:if="{{interactionError}}" class="interaction-error">{{interactionError}}</text>
          <view wx:if="{{starAwardVisible}}" class="star-return-feedback">
            <text class="star-return-feedback__gain">✦ +{{awardedStars}}</text>
          </view>
        </view>

        <view class="tomorrow-section">
          <text wx:if="{{isDev && devPanelOpen}}" class="dev-region-marker">03</text>
          <view class="tomorrow-question {{tomorrowHintVisible ? 'tomorrow-question--open' : ''}}" aria-role="button" aria-label="{{tomorrowHintVisible ? '明日内容已展开' : '看看明天'}}" bindtap="onRevealTomorrow"><text>明天呢？</text></view>
          <text wx:if="{{tomorrowHintVisible}}" class="tomorrow-hint">{{view.today.tomorrowHint}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
