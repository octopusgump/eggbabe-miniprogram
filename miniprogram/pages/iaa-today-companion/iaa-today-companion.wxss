page{height:100%;background:#F4F1E9}
.today-page{position:relative;min-height:100vh;overflow-x:hidden;background:#F4F1E9;color:#28372D;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.today-topbar{position:fixed;z-index:30;left:24rpx;right:24rpx;display:flex;align-items:center;justify-content:space-between;pointer-events:none}
.round-action,.dev-entry,.topbar-spacer{width:88rpx;height:88rpx;box-sizing:border-box}
.round-action,.dev-entry{display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.68);border-radius:999rpx;background:rgba(255,255,255,.82);box-shadow:0 12rpx 30rpx rgba(54,62,50,.13);backdrop-filter:blur(18rpx);pointer-events:auto}
.round-action text{margin-top:-6rpx;font-family:Arial,sans-serif;font-size:58rpx;font-weight:300;line-height:1}
.dev-entry{font-size:22rpx;font-weight:650;letter-spacing:2rpx}
.dev-entry--active{background:#294736;color:#FFF}
.today-wordmark{display:flex;flex-direction:column;align-items:center;color:#26372D;text-shadow:0 1rpx 12rpx rgba(255,255,255,.72)}
.today-wordmark__main{font-size:30rpx;font-weight:650;letter-spacing:3rpx}
.dev-sheet-backdrop{position:fixed;z-index:39;inset:0;background:rgba(26,34,29,.3)}
.dev-panel{position:fixed;z-index:40;left:0;right:0;bottom:0;max-height:70vh;overflow-y:auto;padding:28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:rgba(250,249,245,.98);box-shadow:0 -18rpx 52rpx rgba(41,55,46,.2);backdrop-filter:blur(20rpx)}
.dev-panel__head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;font-size:25rpx;font-weight:650}
.dev-panel__close{padding:10rpx 18rpx;border-radius:999rpx;background:#E7E9E1;color:#647064;font-size:19rpx;font-weight:500}
.dev-facts{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;margin-bottom:20rpx}
.dev-fact{display:flex;min-width:0;flex-direction:column;padding:16rpx;border-radius:18rpx;background:#EEECE4}
.dev-fact__label{color:#7C857D;font-size:17rpx;line-height:1.4}
.dev-fact__value{margin-top:5rpx;color:#35463A;font-size:20rpx;font-weight:600;line-height:1.4}
.dev-row{display:flex;align-items:center;margin-top:14rpx}
.dev-row__label{flex:0 0 72rpx;color:#718076;font-size:21rpx}
.dev-options{display:flex;flex:1;gap:10rpx}
.dev-chip{min-width:78rpx;height:64rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:0 16rpx;border-radius:999rpx;background:#EEECE4;color:#687369;font-size:21rpx}
.dev-chip--active{background:#294736;color:#FFF}
.scene-frame{position:relative;height:64vh;min-height:720rpx;overflow:hidden;background:#D9D8CC}
.scene-image{width:100%;height:100%;display:block}
.scene-wash{position:absolute;inset:0;background:linear-gradient(180deg,rgba(247,244,234,.12) 0%,rgba(247,244,234,0) 54%,rgba(34,41,35,.24) 100%)}
.scene-meta{position:absolute;left:40rpx;bottom:118rpx;display:flex;flex-direction:column;color:#FFF;text-shadow:0 3rpx 18rpx rgba(28,32,27,.42)}
.scene-meta__date,.scene-meta__eyebrow{font-size:27rpx;line-height:1.55;letter-spacing:1rpx}
.scene-meta__date{opacity:.86}
.scene-meta__eyebrow{margin-top:2rpx;font-weight:500}
.paper-note{position:absolute;left:50%;top:55%;width:430rpx;min-height:150rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:36rpx 38rpx;transform:translate(-50%,-50%) rotate(-2deg);background:#FBF2D8;color:#655B49;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55;box-shadow:0 20rpx 44rpx rgba(52,49,42,.20)}
.paper-note__pin{position:absolute;top:7rpx;left:50%;transform:translateX(-50%);color:#B88858;font-size:20rpx}
.letter-stage{position:relative;z-index:5;box-sizing:border-box;margin-top:-88rpx;padding:0 28rpx calc(44rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(228,220,205,0) 0,rgba(228,220,205,.94) 110rpx,#E4DCCD 100%)}
.letter-paper{position:relative;min-height:500rpx;box-sizing:border-box;padding:40rpx 42rpx 36rpx 68rpx;overflow:hidden;border:1rpx solid rgba(126,103,73,.18);border-radius:7rpx 13rpx 10rpx 6rpx;transform:rotate(-.35deg);background:linear-gradient(90deg,transparent 0,transparent 44rpx,rgba(184,105,84,.15) 45rpx,rgba(184,105,84,.15) 47rpx,transparent 48rpx),#FFF9EB;box-shadow:0 26rpx 56rpx rgba(68,57,42,.2),0 3rpx 7rpx rgba(68,57,42,.12)}
.letter-paper::after{content:"";position:absolute;right:-1rpx;top:-1rpx;width:52rpx;height:52rpx;background:linear-gradient(225deg,#E5D8BD 0,#E5D8BD 49%,rgba(128,105,75,.18) 50%,rgba(128,105,75,.08) 55%,transparent 56%)}
.letter-title{display:block;color:#35483C;font-family:"Kaiti SC","STKaiti",serif;font-size:42rpx;font-weight:600;line-height:1.3;overflow-wrap:anywhere}
.letter-line{display:block;margin-top:18rpx;color:#5A675E;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55;overflow-wrap:anywhere}
.tomorrow-section{position:relative;margin-top:0}
.dev-region-marker{position:absolute;right:-10rpx;top:-12rpx;min-width:38rpx;height:38rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#294736;color:#FFF;font-size:16rpx;box-shadow:0 5rpx 14rpx rgba(41,71,54,.2)}
.tomorrow-question{min-height:72rpx;display:flex;align-items:center;color:#506757;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55}
.tomorrow-question text{padding-bottom:4rpx;border-bottom:2rpx solid currentColor}
.tomorrow-question--open{min-height:54rpx;align-items:flex-start}
.tomorrow-hint{display:block;padding:0 0 8rpx;color:#526056;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55;overflow-wrap:anywhere}
.interaction-area{margin-top:12rpx;text-align:left}
.companion-action{min-height:72rpx;display:flex;align-items:center;justify-content:flex-start;box-sizing:border-box;color:#355A43;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55}
.companion-action--pending{opacity:.72}
.companion-action__copy{flex:1;line-height:inherit}
.interaction-feedback{display:block;color:#657567;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55}
.interaction-error{display:block;color:#946E64;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55}
.star-return-feedback{display:flex;align-items:center;margin-top:6rpx;color:#706346;font-family:"Kaiti SC","STKaiti",serif;font-size:27rpx;line-height:1.55}
.star-return-feedback__gain{color:#9A782C;font-weight:700}
.state-stage{height:100vh;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:0 72rpx;flex-direction:column;text-align:center;background:radial-gradient(circle at 50% 38%,#FFFDF7 0%,#F3EFE5 58%,#E8E5D9 100%)}
.state-stage--error{background:radial-gradient(circle at 50% 38%,#FFFDF9 0%,#F2ECE6 62%,#E8E0DA 100%)}
.state-stage__title{margin-top:34rpx;color:#304136;font-size:36rpx;font-weight:650}
.state-stage__copy{max-width:520rpx;margin-top:14rpx;color:#778078;font-size:25rpx;line-height:1.65}
.state-stage__action{min-width:248rpx;height:96rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;margin-top:36rpx;padding:0 36rpx;border-radius:999rpx;background:#294736;color:#FFF;font-size:25rpx;font-weight:600}
.soft-loader{height:72rpx;display:flex;align-items:center;gap:15rpx}
.soft-loader__dot{width:17rpx;height:17rpx;border-radius:50%;background:#839381;animation:soft-rise 1.2s ease-in-out infinite}
.soft-loader__dot--two{animation-delay:.15s}.soft-loader__dot--three{animation-delay:.3s}
.empty-window{position:relative;width:186rpx;height:156rpx;overflow:hidden;border:10rpx solid #D8D2C2;border-bottom-width:19rpx;border-radius:14rpx;background:linear-gradient(180deg,#CADCE1,#F5E4C2)}
.empty-window::after{content:"";position:absolute;top:0;bottom:0;left:50%;width:8rpx;transform:translateX(-50%);background:#D8D2C2}
.empty-window__sun{position:absolute;right:22rpx;top:25rpx;width:38rpx;height:38rpx;border-radius:50%;background:#F4C875}
.empty-window__sill{position:absolute;left:-10rpx;right:-10rpx;bottom:-2rpx;height:34rpx;background:#EAE4D6}
.error-leaf{width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border-radius:40% 60% 42% 58%;transform:rotate(-16deg);background:#E5D7C7;color:#846E5D;font-size:58rpx}
.error-leaf text{transform:rotate(16deg)}
.today-page--amber .letter-paper{background:linear-gradient(90deg,transparent 0,transparent 44rpx,rgba(184,105,84,.15) 45rpx,rgba(184,105,84,.15) 47rpx,transparent 48rpx),#FFF5E5}
.today-page--sky .letter-paper{background:linear-gradient(90deg,transparent 0,transparent 44rpx,rgba(184,105,84,.13) 45rpx,rgba(184,105,84,.13) 47rpx,transparent 48rpx),#F7FBF7}
.today-page--rose .letter-paper{background:linear-gradient(90deg,transparent 0,transparent 44rpx,rgba(166,92,91,.14) 45rpx,rgba(166,92,91,.14) 47rpx,transparent 48rpx),#FFF7F1}
@keyframes soft-rise{0%,100%{opacity:.35;transform:translateY(5rpx)}50%{opacity:1;transform:translateY(-7rpx)}}
@media (prefers-reduced-motion:reduce){.soft-loader__dot{animation:none}}
