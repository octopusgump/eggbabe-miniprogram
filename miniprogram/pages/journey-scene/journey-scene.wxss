.page{position:relative;width:100vw;height:100vh;overflow:hidden;background:#171712;color:#FFF}
.journey-stage{position:absolute;inset:0;width:100vw;height:100vh}
.journey-scene{position:relative;width:100%;height:100%;overflow:hidden;background:#171712}
.journey-scene__backdrop{position:absolute;inset:-42rpx;width:calc(100% + 84rpx);height:calc(100% + 84rpx);opacity:.52;filter:blur(34rpx) saturate(.82);transform:scale(1.08)}
.journey-scene__veil{position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,rgba(12,15,11,.48) 0%,rgba(12,15,11,.04) 24%,rgba(12,15,11,.08) 61%,rgba(12,15,11,.78) 100%)}
.journey-scene__image{position:absolute;z-index:2;inset:0;width:100%;height:100%;display:block}
.journey-topbar{position:absolute;z-index:10;left:env(safe-area-inset-left);right:env(safe-area-inset-right);top:0;display:flex;align-items:center;box-sizing:border-box;pointer-events:none}
.journey-back,.journey-topbar__side{width:112rpx;height:112rpx;flex:0 0 112rpx}
.journey-back{display:flex;align-items:center;justify-content:center;pointer-events:auto;transition:transform .16s ease,opacity .16s ease}
.journey-back--pressed{opacity:.78;transform:scale(.98)}
.journey-back__icon{width:20rpx;height:20rpx;margin-left:8rpx;border-left:4rpx solid #FFF;border-bottom:4rpx solid #FFF;filter:drop-shadow(0 2rpx 5rpx rgba(0,0,0,.42));transform:rotate(45deg)}
.journey-title{min-width:0;flex:1;overflow:hidden;color:#FFF;font-size:30rpx;font-weight:600;text-align:center;text-overflow:ellipsis;text-shadow:0 2rpx 8rpx rgba(0,0,0,.52);white-space:nowrap}
.journey-caption{position:absolute;z-index:10;left:calc(32rpx + env(safe-area-inset-left));right:calc(32rpx + env(safe-area-inset-right));bottom:calc(34rpx + env(safe-area-inset-bottom));padding:25rpx 28rpx 27rpx;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.24);border-radius:30rpx;background:rgba(20,24,19,.56);box-shadow:0 14rpx 40rpx rgba(0,0,0,.18);backdrop-filter:blur(16rpx)}
.journey-caption__scene,.journey-caption__action,.journey-caption__line{display:block}
.journey-caption__scene{color:rgba(255,255,255,.68);font-size:20rpx;letter-spacing:1rpx}
.journey-caption__action{margin-top:7rpx;color:#FFF;font-size:29rpx;font-weight:600}
.journey-caption__line{margin-top:13rpx;color:rgba(255,255,255,.88);font-size:23rpx;line-height:1.65}
.journey-state{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:calc(80rpx + env(safe-area-inset-top)) calc(80rpx + env(safe-area-inset-right)) calc(80rpx + env(safe-area-inset-bottom)) calc(80rpx + env(safe-area-inset-left));box-sizing:border-box;background:#FAFAF8;color:#5C5C5C;font-size:23rpx;text-align:center}
.journey-state--loading{background:#171712;color:rgba(255,255,255,.84)}
.journey-loader{width:50rpx;height:50rpx;border:5rpx solid rgba(255,255,255,.24);border-top-color:#FFF;border-radius:50%;animation:journey-loading-spin .8s linear infinite}
.journey-state__title{color:#1A1A1A;font-size:31rpx;font-weight:600}
.journey-state__retry{height:96rpx;display:flex;align-items:center;justify-content:center;margin-top:10rpx;padding:0 30rpx;border-radius:999rpx;background:#002900;color:#FFF;font-size:24rpx}
.journey-state__back{height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 30rpx;border-radius:999rpx;color:#5C5C5C;font-size:24rpx}
@media (prefers-reduced-motion:reduce){.journey-back{transition:none}.journey-scene__backdrop{filter:none}}
.page--reduced .journey-loader{animation:none}
.page--reduced .journey-back{transition:none}
@keyframes journey-loading-spin{to{transform:rotate(360deg)}}
