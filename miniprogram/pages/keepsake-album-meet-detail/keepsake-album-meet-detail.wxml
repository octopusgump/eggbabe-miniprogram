<view class="meet-detail-page">
  <nav-bar title="{{detail.title || '遇见'}}" surface="canvas"></nav-bar>

  <scroll-view wx:if="{{screenState === 'ready' && detail}}" class="meet-detail-scroll" scroll-y>
    <view class="meet-detail-content">
      <image class="meet-detail-hero" src="{{detail.image}}" mode="aspectFill"></image>
      <view class="meet-detail-copy">
        <text wx:for="{{bodyLines}}" wx:key="*this" class="meet-detail-line">{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:else class="meet-detail-state">
    <text class="meet-detail-state__copy">这一页还没有准备好</text>
  </view>
</view>
