.meet-detail-page {
  min-height: 100vh;
  background: #FAFAF8;
  display: flex;
  flex-direction: column;
}

.meet-detail-scroll {
  flex: 1;
  min-height: 0;
  height: calc(100vh - 112rpx - env(safe-area-inset-top));
}

.meet-detail-content {
  padding: 16rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.meet-detail-hero {
  width: 100%;
  height: 654rpx;
  display: block;
  border-radius: 32rpx;
  background: #F0F0EA;
}

.meet-detail-copy {
  margin-top: 40rpx;
}

.meet-detail-line {
  display: block;
  color: #002900;
  font-size: 28rpx;
  line-height: 1.75;
}

.meet-detail-line + .meet-detail-line {
  margin-top: 8rpx;
}

.meet-detail-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: #5C5C5C;
  font-size: 26rpx;
}

.meet-detail-state__copy {
  display: block;
}
