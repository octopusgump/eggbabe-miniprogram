<view class="postcard-detail-page">
  <nav-bar title="{{detail.title || '明信片'}}" surface="canvas"></nav-bar>

  <scroll-view wx:if="{{screenState === 'ready' && detail}}" class="postcard-detail-scroll" scroll-y>
    <view class="postcard-detail-content">
      <image class="postcard-detail-hero" src="{{detail.image}}" mode="aspectFill"></image>
      <view class="postcard-detail-copy">
        <block wx:for="{{paragraphs}}" wx:key="index" wx:for-item="paragraph">
          <view class="postcard-detail-paragraph">
            <text wx:for="{{paragraph}}" wx:key="*this" class="postcard-detail-line">{{item}}</text>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <view wx:else class="postcard-detail-state">
    <text class="postcard-detail-state__copy">这一页还没有准备好</text>
  </view>
</view>
