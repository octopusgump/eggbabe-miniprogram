.keepsake-album-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #FAFAF8;
}

.keepsake-album-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.keepsake-tabs {
  flex: none;
  padding: 8rpx 0 28rpx;
}

.keepsake-tabs__track {
  display: flex;
  align-items: stretch;
  min-height: 72rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #E6E8E1;
  box-sizing: border-box;
}

.keepsake-tabs__item {
  flex: 1;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 28rpx;
  font-weight: 500;
}

.keepsake-tabs__item--active {
  background: #FFF;
  color: #002900;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(0, 41, 0, 0.08);
}

.keepsake-scroll {
  flex: 1;
  min-height: 0;
  height: calc(100vh - 112rpx - env(safe-area-inset-top) - 108rpx);
}

.meet-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.meet-grid__cell {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFF;
}

.meet-grid__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.postcard-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.postcard-grid__cell {
  position: relative;
  width: 100%;
  padding-bottom: 132.075%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 41, 0, 0.06);
}

.postcard-grid__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.keepsake-empty {
  min-height: calc(100vh - 112rpx - env(safe-area-inset-top) - 220rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  text-align: center;
}

.keepsake-empty__ring {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #002900;
  border-radius: 50%;
  box-sizing: border-box;
}

.keepsake-empty__title {
  display: block;
  margin-top: 36rpx;
  color: #002900;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.keepsake-empty__copy {
  display: block;
  max-width: 520rpx;
  margin-top: 16rpx;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1.55;
}

.demo-switcher {
  flex: none;
  margin: 0 48rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 24rpx;
  border: 1rpx dashed #B8BBB2;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.52);
}

.demo-switcher__title {
  display: block;
  color: #49564C;
  font-size: 22rpx;
  font-weight: 600;
}

.demo-switcher__grid {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.demo-chip {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #DFDFD7;
  border-radius: 999rpx;
  background: #FFF;
  color: #697168;
  font-size: 22rpx;
}

.demo-chip--active {
  border-color: #76876A;
  background: #E9EFDF;
  color: #314D35;
  font-weight: 600;
}

@media (prefers-reduced-motion: reduce) {
  .keepsake-tabs__item--active {
    box-shadow: none;
  }
}
