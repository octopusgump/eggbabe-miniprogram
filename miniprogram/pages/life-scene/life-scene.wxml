<view class="page {{loading ? 'page--loading' : ''}} {{reducedMotion ? 'page--reduced' : ''}}">
  <view class="topbar" style="padding-top:{{statusBarHeight}}px;">
    <view class="round-btn" aria-role="button" aria-label="返回" bindtap="onBack"><view class="back-icon"></view></view>
  </view>

  <view wx:if="{{loading}}" class="state-layer">
    <view class="loading-orbit"></view><text>正在看看 ta 此刻在哪里…</text>
  </view>
  <view wx:elif="{{error}}" class="state-layer state-layer--error">
    <text class="state-error-title">暂时没看见 ta 此刻的状态</text><text>{{error}}</text>
    <view class="state-action" bindtap="onRetry">重新看看</view><view class="state-secondary" bindtap="onBack">返回主页</view>
  </view>

  <block wx:elif="{{currentState}}">
    <scroll-view class="world-scroll" scroll-x enhanced paging-enabled show-scrollbar="{{false}}" scroll-left="{{scrollLeft}}" scroll-into-view="{{scrollIntoView}}" bindscroll="onScroll">
      <view class="world-track">
        <view id="world-panel-0" class="world-panel world-panel--living">
          <image wx:if="{{panelImages[0]}}" class="panel-bg" src="{{panelImages[0]}}" mode="aspectFill"></image>
          <image wx:else class="panel-bg panel-bg--panorama panel-bg--left" src="{{panoramaFallback}}" mode="aspectFill"></image>
          <view class="panel-tone" style="{{playedActionKind === 'lamp' ? 'background:rgba(23,29,38,.5);' : ''}}"></view>
          <view wx:if="{{currentState.atHome}}" class="scene-character scene-character--sleep {{characterWarming ? 'scene-character--warming' : ''}}" aria-role="button" aria-label="轻触蛋宝宝" bindtap="onCharacterTap" bindtouchstart="onCharacterTouchStart" bindtouchend="onCharacterTouchEnd" bindtouchcancel="onCharacterTouchEnd">
            <view class="scene-character__floor-shadow" aria-hidden="true"></view>
            <image class="scene-character__sleep-image" src="{{jadeRabbitSleepImage}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{currentState.atHome && currentState.action.screen === 0}}" class="action-glow action-glow--{{currentState.action.kind}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
        </view>
        <view id="world-panel-1" class="world-panel world-panel--desk">
          <image wx:if="{{panelImages[1]}}" class="panel-bg" src="{{panelImages[1]}}" mode="aspectFill"></image>
          <image wx:else class="panel-bg panel-bg--panorama panel-bg--center" src="{{panoramaFallback}}" mode="aspectFill"></image>
          <view class="panel-tone"></view>
          <view class="daily-window-hotspot daily-window-hotspot--panel-1" data-window-panel="1" aria-role="button" aria-label="查看窗外景色" catchtap="onDailyWindowTap"></view>
          <view wx:if="{{currentState.action.kind === 'cup'}}" style="position:absolute;z-index:4;right:16%;bottom:29%;width:54rpx;height:48rpx;border:7rpx solid #F4EEE2;border-radius:8rpx 8rpx 18rpx 18rpx;background:#A8BEA0;transform:{{playedActionKind === 'cup' ? 'translateX(-34rpx)' : 'none'}};transition:transform .35s ease;"></view>
          <view wx:if="{{currentState.action.kind === 'paper'}}" style="position:absolute;z-index:4;left:39%;bottom:20%;width:132rpx;height:86rpx;border-radius:8rpx;background:{{playedActionKind === 'paper' ? '#FFF9D8' : '#F6F4EB'}};box-shadow:0 8rpx 20rpx rgba(56,45,35,.16);transform:{{playedActionKind === 'paper' ? 'rotate(-8deg) scale(1.08)' : 'rotate(5deg)'}};transition:transform .35s ease;"></view>
          <view wx:if="{{currentState.action.kind === 'screen'}}" style="position:absolute;z-index:4;left:24%;bottom:27%;width:116rpx;height:74rpx;border:10rpx solid #534C45;border-radius:14rpx;background:{{playedActionKind === 'screen' ? '#D9F0AD' : '#879586'}};box-shadow:{{playedActionKind === 'screen' ? '0 0 34rpx rgba(220,244,159,.8)' : 'none'}};transition:all .25s ease;"></view>
          <view wx:if="{{currentState.atHome && currentState.action.screen === 1}}" class="action-glow action-glow--{{currentState.action.kind}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
          <view wx:if="{{!currentState.atHome}}" class="away-note"><text class="away-kicker">{{currentState.majorLabel}} · {{currentState.label}}</text><text class="away-line">{{currentState.line}}</text></view>
        </view>
        <view id="world-panel-2" class="world-panel world-panel--decor">
          <image wx:if="{{panelImages[2]}}" class="panel-bg" src="{{panelImages[2]}}" mode="aspectFill"></image>
          <image wx:else class="panel-bg panel-bg--panorama panel-bg--right" src="{{panoramaFallback}}" mode="aspectFill"></image>
          <view class="panel-tone"></view>
          <view class="daily-window-hotspot daily-window-hotspot--panel-2" data-window-panel="2" aria-role="button" aria-label="查看窗外景色" catchtap="onDailyWindowTap"></view>
          <view wx:if="{{currentState.atHome && currentState.action.screen === 2 && currentState.action.kind !== 'window'}}" class="action-glow action-glow--{{currentState.action.kind}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
        </view>
      </view>
    </scroll-view>

    <view class="screen-dots"><view wx:for="{{screens}}" wx:key="*this" class="screen-dot {{currentScreen === item ? 'screen-dot--active' : ''}}"></view></view>
    <view wx:if="{{feedback}}" class="feedback-bubble">{{feedback}}</view>

    <view wx:if="{{composerVisible && currentState.atHome && currentState.canTalk}}" class="scene-composer">
      <view class="composer-close" aria-role="button" aria-label="收起对话输入" bindtap="onCloseComposer">×</view>
      <text wx:if="{{talkReply}}" class="inline-reply">{{talkReply}}</text><text wx:if="{{talkError}}" class="composer-error">{{talkError}}</text>
      <view class="composer-row"><input class="composer-input" value="{{talkDraft}}" maxlength="120" focus="{{composerVisible}}" placeholder="在这里说一句…" bindinput="onTalkInput" bindconfirm="onSendTalk" confirm-type="send" /><view class="composer-send {{talkBusy ? 'composer-send--busy' : ''}}" bindtap="onSendTalk">{{talkBusy ? '…' : '说'}}</view></view>
    </view>
    <view wx:elif="{{composerVisible && !currentState.atHome}}" class="scene-composer">
      <view class="composer-close" aria-role="button" aria-label="收起写信输入" bindtap="onCloseComposer">×</view>
      <text wx:if="{{letterError}}" class="composer-error">{{letterError}}</text>
      <view wx:if="{{currentState.letterSent}}" class="letter-sent">信已经在路上了</view>
      <view wx:else class="composer-row"><input class="composer-input" value="{{letterDraft}}" maxlength="120" focus="{{composerVisible}}" placeholder="给远方的 ta 写一句…" bindinput="onLetterInput" bindconfirm="onSendLetter" confirm-type="send" /><view class="composer-send {{letterBusy ? 'composer-send--busy' : ''}}" bindtap="onSendLetter">{{letterBusy ? '…' : '寄'}}</view></view>
    </view>

    <view wx:if="{{toolboxVisible}}" class="toolbox-mask" catchtap="onCloseToolbox" catchtouchmove="noop"></view>
    <view wx:if="{{toolboxVisible}}" class="toolbox-sheet">
      <text class="toolbox-title">百宝箱</text>
      <view class="toolbox-grid">
        <view class="toolbox-item" data-target="my" bindtap="onToolboxItemTap">
          <image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_settings_gear_96_v02.webp" mode="aspectFit"></image>
          <text>我的 / 设置</text>
        </view>
        <view class="toolbox-item" data-target="card" bindtap="onToolboxItemTap"><image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_collection_card_front_96_v02.webp" mode="aspectFit"></image><text>收藏卡</text></view>
        <view class="toolbox-item" data-target="postcards" bindtap="onToolboxItemTap"><image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_postcard_two_color_front_96_v02.webp" mode="aspectFit"></image><text>明信片</text></view>
        <view class="toolbox-item" data-target="keepsakes" bindtap="onToolboxItemTap"><image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_keepsake_box_96_v01.png" mode="aspectFit"></image><text>ta 带回来的东西</text></view>
      </view>
    </view>

    <view wx:if="{{!composerVisible && currentState.atHome}}" class="scene-dialogue-entry">
      <view class="scene-action-button" hover-class="scene-action-button--pressed" aria-role="button" aria-label="和蛋宝宝对话" bindtap="onContextActionTap">
        <image class="scene-action-icon-image" src="/assets/ui/3d-scene-actions/runtime/ui_3d_scene_message_envelope_96_v01.png" mode="aspectFit"></image>
      </view>
    </view>

    <view wx:if="{{!composerVisible}}" class="scene-action-dock">
      <view class="scene-action-button" hover-class="scene-action-button--pressed" aria-role="button" aria-label="打开百宝箱" bindtap="onToggleToolbox">
        <image class="scene-action-icon-image" src="/assets/ui/3d-scene-actions/runtime/ui_3d_scene_toolbox_closed_chest_96_v01.png" mode="aspectFit"></image>
      </view>
      <view wx:if="{{!currentState.atHome}}" class="scene-action-button" hover-class="scene-action-button--pressed" aria-role="button" aria-label="给蛋宝宝写信" bindtap="onContextActionTap">
        <view class="scene-action-icon icon-letter"><view class="icon-letter__paper"></view><view class="icon-letter__flap"></view><view class="icon-letter__seal"></view><view class="scene-icon-shine"></view></view>
      </view>
    </view>
  </block>

  <daily-window-detail
    id="dailyWindowDetail"
    visible="{{dailyWindowVisible}}"
    image="{{dailyWindowEnvironment.windowImage}}"
    weather="{{dailyWindowEnvironment.weather}}"
    season="{{dailyWindowEnvironment.season}}"
    period="{{dailyWindowEnvironment.period}}"
    light-phase="{{dailyWindowEnvironment.lightPhase}}"
    weather-label="{{dailyWindowWeatherLabel}}"
    period-label="{{dailyWindowPeriodLabel}}"
    origin-style="{{dailyWindowOriginStyle}}"
    magic-enabled="{{true}}"
    bindclose="onDailyWindowClosed"
    bindretry="onDailyWindowRetry"
    bindmagic="onOpenMagicWindow"
  ></daily-window-detail>

  <view
    wx:if="{{magicWindowVisible}}"
    class="magic-window {{reducedMotion ? 'magic-window--reduced' : ''}}"
    catchtouchmove="onMagicTouchMove"
  >
    <image
      wx:if="{{magicWindowBase}}"
      class="magic-window__base"
      src="{{magicWindowBase}}"
      mode="aspectFill"
      bindload="onMagicWindowBaseLoad"
      binderror="onMagicWindowBaseError"
    ></image>
    <view wx:if="{{!magicWindowFailed}}" class="magic-window__atmosphere" aria-hidden="true">
      <image class="magic-window__clouds magic-window__clouds--near" src="{{magicWindowClouds}}" mode="widthFix"></image>
      <image class="magic-window__clouds magic-window__clouds--far" src="{{magicWindowClouds}}" mode="widthFix"></image>
      <view class="magic-window__water-shimmer"></view>
    </view>
    <view
      wx:if="{{!magicWindowLoading && !magicWindowFailed}}"
      class="magic-window__koi-track {{magicKoiReacting ? 'magic-window__koi-track--reacting' : ''}}"
      aria-role="button"
      aria-label="轻触锦鲤，看它跳起来"
      catchtap="onMagicKoiTap"
    >
      <view class="magic-window__koi-shadow"></view>
      <view class="magic-window__koi-ripple magic-window__koi-ripple--one"></view>
      <view class="magic-window__koi-ripple magic-window__koi-ripple--two"></view>
      <image class="magic-window__koi" src="{{magicWindowKoi}}" mode="widthFix"></image>
    </view>
    <text wx:if="{{!magicWindowLoading && !magicWindowFailed}}" class="magic-window__hint">轻触锦鲤</text>

    <view wx:if="{{magicWindowLoading && !magicWindowFailed}}" class="magic-window__state">
      <view class="magic-window__loader"></view>
      <text>正在推开东京的窗…</text>
    </view>
    <view wx:elif="{{magicWindowFailed}}" class="magic-window__state magic-window__state--error">
      <text class="magic-window__state-title">东京窗景没有加载好</text>
      <view class="magic-window__retry" aria-role="button" bindtap="onMagicWindowRetry">重新看看</view>
    </view>

    <view class="magic-window__topbar" style="padding-top:{{statusBarHeight}}px;">
      <view class="magic-window__back" aria-role="button" aria-label="返回上海窗外" bindtap="onCloseMagicWindow"><view class="magic-window__back-icon"></view></view>
      <view class="magic-window__meta"><text>东京 · 雨后</text></view>
    </view>
  </view>

  <view wx:if="{{isExiting}}" class="scene-exit-backdrop"></view>
  <view wx:if="{{isExiting}}" class="scene-exit-overlay" style="{{exitTransitionStyle}}"><image class="scene-exit-image" src="{{panoramaFallback}}" mode="aspectFill"></image></view>
</view>
