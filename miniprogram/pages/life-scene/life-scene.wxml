<view class="page {{loading ? 'page--loading' : ''}} {{reducedMotion ? 'page--reduced' : ''}}">
  <!-- DEV-ONLY：默认只显示一个验收入口，正式版本 isDemo=false 时不会渲染。 -->
  <view wx:if="{{isDemo && currentState && sceneBackgroundReady}}" class="stage-tester" style="top:{{acceptanceTesterTopPx}}px;">
    <view class="stage-tester-button {{acceptanceToolsOpen ? 'stage-tester-button--open' : ''}}" aria-role="button" aria-label="{{acceptanceToolsOpen ? '收起验收工具' : '展开验收工具'}}" catchtap="onAcceptanceToolsToggle">
      <text class="stage-tester-tag">验收</text><text>工具</text><text class="stage-tester-chevron">{{acceptanceToolsOpen ? '⌃' : '⌄'}}</text>
    </view>
  </view>

  <view wx:if="{{isDemo && acceptanceToolsOpen && currentState && sceneBackgroundReady}}" class="scene-tester scene-tester--post-hatch" style="top:{{sceneTesterTopPx}}px;">
    <view class="scene-tester-button {{sceneTesterOpen ? 'scene-tester-button--open' : ''}} {{sceneTesterBusy ? 'scene-tester-button--busy' : ''}}" aria-role="button" aria-label="测试场景，当前{{sceneTesterLabel}}" bindtap="onSceneTesterToggle">
      <text class="scene-tester-tag">场景</text><text class="scene-tester-current">{{sceneTesterBusy ? '切换中…' : sceneTesterLabel}}</text><text class="scene-tester-chevron">⌄</text>
    </view>
    <scroll-view wx:if="{{sceneTesterOpen}}" class="scene-tester-menu" scroll-y="true">
      <view wx:for="{{sceneTesterOptions}}" wx:key="key" class="scene-tester-option {{sceneTesterKey === item.key ? 'scene-tester-option--active' : ''}}" data-scene="{{item.key}}" aria-role="button" bindtap="onSceneTesterSelect">
        <view class="scene-tester-option-copy"><text>{{item.label}}</text></view>
        <text wx:if="{{sceneTesterKey === item.key}}">✓</text>
      </view>
    </scroll-view>
  </view>

  <!-- DEV-ONLY：与破壳前首页共享阶段验收器；release/trial 下 isDemo=false，不会渲染。 -->
  <view wx:if="{{isDemo && acceptanceToolsOpen && currentState && sceneBackgroundReady}}" class="stage-tester" style="top:{{stageTesterTopPx}}px;">
    <view class="stage-tester-button {{stageTesterOpen ? 'stage-tester-button--open' : ''}} {{stageTesterBusy ? 'stage-tester-button--busy' : ''}}" aria-role="button" aria-label="测试阶段，当前{{stageTesterLabel}}" catchtap="onStageTesterToggle">
      <text class="stage-tester-tag">测试</text><text>{{stageTesterBusy ? '切换中…' : stageTesterLabel}}</text><text class="stage-tester-chevron">⌄</text>
    </view>
    <view wx:if="{{stageTesterOpen}}" class="stage-tester-menu">
      <view wx:for="{{stageTesterOptions}}" wx:key="key" class="stage-tester-option {{stageTesterKey === item.key ? 'stage-tester-option--active' : ''}}" data-stage="{{item.key}}" aria-role="button" aria-label="切换到{{item.label}}" catchtap="onStageTesterSelect"><text>{{item.label}}</text><text wx:if="{{stageTesterKey === item.key}}">✓</text></view>
    </view>
  </view>

  <view wx:if="{{isDemo && acceptanceToolsOpen && currentState && sceneBackgroundReady}}" class="companion-state-tester" style="top:{{companionStateTesterTopPx}}px;">
    <view class="companion-state-tester-button {{companionStateTesterOpen ? 'companion-state-tester-button--open' : ''}}" aria-role="button" aria-label="测试陪伴状态，当前{{companionStateTesterLabel}}" bindtap="onCompanionStateTesterToggle">
      <text class="companion-state-tester-tag">状态</text><text class="companion-state-tester-current">{{companionStateTesterLabel}}</text><text class="companion-state-tester-chevron">⌄</text>
    </view>
    <view wx:if="{{companionStateTesterOpen}}" class="companion-state-tester-menu">
      <view wx:for="{{companionStateTesterOptions}}" wx:key="key" class="companion-state-tester-option {{companionStateTesterKey === item.key ? 'companion-state-tester-option--active' : ''}} {{!item.available ? 'companion-state-tester-option--missing' : ''}}" data-companion-state="{{item.key}}" aria-role="button" aria-disabled="{{!item.available}}" bindtap="onCompanionStateTesterSelect"><text>{{item.label}}</text><text wx:if="{{!item.available}}" class="companion-state-tester-missing">缺图片</text><text wx:elif="{{companionStateTesterKey === item.key}}">✓</text></view>
    </view>
  </view>

  <view wx:if="{{isDemo && acceptanceToolsOpen && currentState && sceneBackgroundReady}}" class="prototype-tester" style="top:{{prototypeTesterTopPx}}px;">
    <view class="prototype-tester-button {{prototypeTesterOpen ? 'prototype-tester-button--open' : ''}} {{prototypeTesterBusy ? 'prototype-tester-button--busy' : ''}}" aria-role="button" aria-label="测试角色，当前{{prototypeTesterLabel}}" bindtap="onPrototypeTesterToggle">
      <text class="prototype-tester-tag">角色</text><text>{{prototypeTesterBusy ? '切换中…' : prototypeTesterLabel}}</text><text class="prototype-tester-chevron">⌄</text>
    </view>
    <view wx:if="{{prototypeTesterOpen}}" class="prototype-tester-menu">
      <view wx:for="{{prototypeTesterOptions}}" wx:key="key" class="prototype-tester-option {{prototypeTesterKey === item.key ? 'prototype-tester-option--active' : ''}}" data-prototype="{{item.key}}" aria-role="button" aria-label="切换到{{item.label}}" bindtap="onPrototypeTesterSelect"><text>{{item.label}}</text><text wx:if="{{prototypeTesterKey === item.key}}">✓</text></view>
    </view>
  </view>

  <!-- DEV-ONLY：心情 Mock 只在当前页内存中切换；release/trial 下不渲染。 -->
  <view wx:if="{{isDemo && acceptanceToolsOpen && currentState && sceneBackgroundReady}}" class="mood-tester" style="top:{{moodTesterTopPx}}px;">
    <view class="mood-tester-button {{moodTesterOpen ? 'mood-tester-button--open' : ''}}" aria-role="button" aria-label="测试每日心情，当前{{moodTesterLabel}}" bindtap="onMoodTesterToggle">
      <text class="mood-tester-tag">心情</text><text>{{moodTesterLabel}}</text><text class="mood-tester-chevron">⌄</text>
    </view>
    <scroll-view wx:if="{{moodTesterOpen}}" class="mood-tester-menu" scroll-y="true">
      <view wx:for="{{moodPreviewOptions}}" wx:key="key" class="mood-tester-option {{moodTesterKey === item.key ? 'mood-tester-option--active' : ''}}" data-mood="{{item.key}}" aria-role="button" aria-label="切换到{{item.label}}" bindtap="onMoodTesterSelect"><text>{{item.label}}</text><text wx:if="{{moodTesterKey === item.key}}">✓</text></view>
    </scroll-view>
  </view>
  <view wx:if="{{(!sceneEntered || !initialViewportReady) && !error}}" class="state-layer">
    <view class="loading-orbit"></view><text>{{loading ? '正在确认 ta 此刻状态…' : '正在加载房间…'}}</text>
  </view>
  <view wx:if="{{!loading && error}}" class="state-layer state-layer--error">
    <text class="state-error-title">暂时没看见 ta 此刻的状态</text><text>{{error}}</text>
    <view class="state-action" bindtap="onRetry">重新看看</view><view class="state-secondary" bindtap="onBack">返回主页</view>
  </view>

  <scene-feedback-stack
    text="{{sceneFeedbackText}}"
    variant="{{sceneFeedbackVariant}}"
    tone="{{sceneFeedbackTone}}"
    visible="{{sceneFeedbackVisible}}"
    system-behind="{{sceneFeedbackSystemBehind}}"
    promoting="{{sceneFeedbackPromoting}}"
    reduced-motion="{{reducedMotion}}"
  ></scene-feedback-stack>

  <view wx:if="{{pet}}" class="life-status-stack" style="top:{{moodTabTopPx}}px;">
    <view class="pet-mood-anchor">
      <pet-mood-tab
        id="petMoodTab"
        pet-name="{{pet.name || '蛋宝宝'}}"
        mood="{{dailyMood}}"
        intro-ready="{{sceneEntered && initialViewportReady && sceneBackgroundReady && !error}}"
        reduced-motion="{{reducedMotion}}"
      ></pet-mood-tab>
    </view>
    <view
      class="room-clock room-clock--{{clockMode}}"
      aria-role="button"
      aria-label="{{clockMode === 'analog' ? '当前时间 ' + clockTimeText + '，点击显示数字时间' : '当前时间 ' + clockTimeText + '，点击显示指针时钟'}}"
      catchtap="onClockTap"
    >
      <view wx:if="{{clockMode === 'analog'}}" class="clock-face">
        <text class="clock-number clock-number--twelve">12</text>
        <text class="clock-number clock-number--three">3</text>
        <text class="clock-number clock-number--six">6</text>
        <text class="clock-number clock-number--nine">9</text>
        <view class="clock-hand clock-hand--hour" style="{{clockHourStyle}}"></view>
        <view class="clock-hand clock-hand--minute" style="{{clockMinuteStyle}}"></view>
        <view class="clock-hand clock-hand--second" style="{{clockSecondStyle}}"></view>
        <view class="clock-pin"></view>
      </view>
      <view wx:else class="clock-digital">
        <text class="clock-time">{{clockTimeText}}</text>
        <text class="clock-date">{{clockDateText}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{currentState && !error}}">
    <view class="scene-stage {{sceneEntered && initialViewportReady ? 'scene-stage--entered' : ''}}">
    <scroll-view class="world-scroll" scroll-x enhanced paging-enabled show-scrollbar="{{false}}" scroll-left="{{scrollLeft}}" bindscroll="onScroll">
      <view class="world-track">
        <image wx:if="{{previousPanoramaImage}}" class="world-panorama-bg world-panorama-bg--previous {{sceneCrossfadeActive ? 'world-panorama-bg--previous-fading' : ''}}" src="{{previousPanoramaImage}}" data-panorama-url="{{previousPanoramaImage}}" mode="aspectFill" bindanimationend="onPreviousPanoramaAnimationEnd"></image>
        <image class="world-panorama-bg" src="{{panoramaImage}}" mode="aspectFill" bindload="onSceneBackgroundLoad" binderror="onSceneBackgroundError"></image>
        <image wx:if="{{pendingPanoramaImage}}" class="world-panorama-preload" src="{{pendingPanoramaImage}}" data-panorama-url="{{pendingPanoramaImage}}" mode="aspectFill" bindload="onPendingPanoramaLoad" binderror="onPendingPanoramaError"></image>
        <view id="world-panel-0" class="world-panel world-panel--living">
          <view wx:for="{{windowHotspots[0]}}" wx:key="id" class="daily-window-hotspot daily-window-hotspot--panel-0 daily-window-hotspot--{{item.id}}" style="{{item.style}}" data-window-panel="{{item.panel}}" data-window-hotspot="{{item.id}}" aria-role="button" aria-label="查看窗外景色" bindtouchstart="onDailyWindowTouchStart" bindtouchmove="onDailyWindowTouchMove" bindtouchend="onDailyWindowTouchEnd" bindtouchcancel="onDailyWindowTouchCancel"></view>
          <view wx:if="{{characterPanel === 0}}" class="scene-character-hotspot" style="{{characterStyle}}" aria-role="button" aria-label="轻触蛋宝宝" bindtap="onCharacterTap" bindtouchstart="onCharacterTouchStart" bindtouchend="onCharacterTouchEnd" bindtouchcancel="onCharacterTouchEnd"></view>
          <view wx:if="{{currentState.action && actionPanel === 0 && !currentState.actionDone}}" class="action-glow action-glow--{{currentState.action.kind}}" style="{{actionStyle}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
        </view>
        <view id="world-panel-1" class="world-panel world-panel--desk">
          <view wx:for="{{windowHotspots[1]}}" wx:key="id" class="daily-window-hotspot daily-window-hotspot--panel-1 daily-window-hotspot--{{item.id}}" style="{{item.style}}" data-window-panel="{{item.panel}}" data-window-hotspot="{{item.id}}" aria-role="button" aria-label="查看窗外景色" bindtouchstart="onDailyWindowTouchStart" bindtouchmove="onDailyWindowTouchMove" bindtouchend="onDailyWindowTouchEnd" bindtouchcancel="onDailyWindowTouchCancel"></view>
          <view wx:if="{{characterPanel === 1}}" class="scene-character-hotspot" style="{{characterStyle}}" aria-role="button" aria-label="轻触蛋宝宝" bindtap="onCharacterTap" bindtouchstart="onCharacterTouchStart" bindtouchend="onCharacterTouchEnd" bindtouchcancel="onCharacterTouchEnd"></view>
          <view wx:if="{{currentState.action && actionPanel === 1 && !currentState.actionDone}}" class="action-glow action-glow--{{currentState.action.kind}}" style="{{actionStyle}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
        </view>
        <view id="world-panel-2" class="world-panel world-panel--decor">
          <view wx:if="{{characterPanel === 2}}" class="scene-character-hotspot" style="{{characterStyle}}" aria-role="button" aria-label="轻触蛋宝宝" bindtap="onCharacterTap" bindtouchstart="onCharacterTouchStart" bindtouchend="onCharacterTouchEnd" bindtouchcancel="onCharacterTouchEnd"></view>
          <view wx:for="{{windowHotspots[2]}}" wx:key="id" class="daily-window-hotspot daily-window-hotspot--panel-2 daily-window-hotspot--{{item.id}}" style="{{item.style}}" data-window-panel="{{item.panel}}" data-window-hotspot="{{item.id}}" aria-role="button" aria-label="查看窗外景色" bindtouchstart="onDailyWindowTouchStart" bindtouchmove="onDailyWindowTouchMove" bindtouchend="onDailyWindowTouchEnd" bindtouchcancel="onDailyWindowTouchCancel"></view>
          <view wx:if="{{currentState.action && actionPanel === 2 && !currentState.actionDone && currentState.action.kind !== 'window'}}" class="action-glow action-glow--{{currentState.action.kind}}" style="{{actionStyle}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{sceneBackgroundError || sceneTransitionError}}" class="scene-background-error" bindtap="onRetrySceneBackground">{{sceneTransitionError ? '房间背景更新失败 · 轻触重试' : '房间背景没有加载好 · 轻触重试'}}</view>

    <view class="screen-dots"><view wx:for="{{screens}}" wx:key="*this" class="screen-dot {{currentScreen === item ? 'screen-dot--active' : ''}}"></view></view>
    <view wx:if="{{currentState}}" class="scene-context-entry">
      <view wx:if="{{currentState.atHome}}" class="scene-action-button {{contextActionDisabled ? 'scene-action-button--unavailable' : ''}}" hover-class="scene-action-button--pressed" aria-role="button" aria-label="{{contextActionLabel}}" bindtap="onContextActionTap">
        <image class="scene-action-icon-image scene-action-icon-image--companion" src="{{contextActionIcon}}" mode="aspectFill"></image>
        <view wx:if="{{contextActionBadge}}" class="scene-action-unavailable-badge">{{contextActionBadge}}</view>
      </view>
      <view wx:else class="away-status-pill" aria-role="button" aria-label="蛋宝宝外出中，轻触查看提示" bindtap="onContextActionTap">外出中</view>
    </view>

    <view class="scene-action-dock">
      <view class="scene-action-button" hover-class="scene-action-button--pressed" aria-role="button" aria-label="打开我的和设置" bindtap="onOpenMySettings">
        <image class="scene-action-icon-image" src="{{mySettingsIcon}}" mode="aspectFit"></image>
      </view>
    </view>
    </view>
  </block>

  <daily-window-detail
    id="dailyWindowDetail"
    visible="{{dailyWindowVisible}}"
    image="{{dailyWindowEnvironment.windowImage}}"
    weather="{{dailyWindowEnvironment.weather}}"
    season="{{dailyWindowEnvironment.season}}"
    period="{{dailyWindowEnvironment.period}}"
    light-phase="{{dailyWindowEnvironment.lightPhase}}"
    weather-label="{{dailyWindowWeatherLabel}}"
    period-label="{{dailyWindowPeriodLabel}}"
    origin-style="{{dailyWindowOriginStyle}}"
    magic-enabled="{{magicWindowEnabled}}"
    bindclose="onDailyWindowClosed"
    bindretry="onDailyWindowRetry"
    bindmagic="onOpenMagicWindow"
  ></daily-window-detail>

  <view
    wx:if="{{magicWindowVisible}}"
    class="magic-window {{reducedMotion ? 'magic-window--reduced' : ''}}"
    catchtouchmove="onMagicTouchMove"
  >
    <image
      wx:if="{{magicWindowBase}}"
      class="magic-window__base"
      src="{{magicWindowBase}}"
      mode="aspectFill"
      bindload="onMagicWindowBaseLoad"
      binderror="onMagicWindowBaseError"
    ></image>
    <view wx:if="{{!magicWindowFailed}}" class="magic-window__atmosphere" aria-hidden="true">
      <image class="magic-window__clouds magic-window__clouds--near" src="{{magicWindowClouds}}" mode="widthFix"></image>
      <image class="magic-window__clouds magic-window__clouds--far" src="{{magicWindowClouds}}" mode="widthFix"></image>
      <view class="magic-window__water-shimmer"></view>
    </view>
    <view
      wx:if="{{!magicWindowLoading && !magicWindowFailed}}"
      class="magic-window__koi-track {{magicKoiReacting ? 'magic-window__koi-track--reacting' : ''}}"
      aria-role="button"
      aria-label="轻触锦鲤，看它跳起来"
      catchtap="onMagicKoiTap"
    >
      <view class="magic-window__koi-shadow"></view>
      <view class="magic-window__koi-ripple magic-window__koi-ripple--one"></view>
      <view class="magic-window__koi-ripple magic-window__koi-ripple--two"></view>
      <image class="magic-window__koi" src="{{magicWindowKoi}}" mode="widthFix"></image>
    </view>
    <text wx:if="{{!magicWindowLoading && !magicWindowFailed}}" class="magic-window__hint">轻触锦鲤</text>

    <view wx:if="{{magicWindowLoading && !magicWindowFailed}}" class="magic-window__state">
      <view class="magic-window__loader"></view>
      <text>正在推开{{magicWindowLabel}}的窗…</text>
    </view>
    <view wx:elif="{{magicWindowFailed}}" class="magic-window__state magic-window__state--error">
      <text class="magic-window__state-title">{{magicWindowLabel}}窗景没有加载好</text>
      <view class="magic-window__retry" aria-role="button" bindtap="onMagicWindowRetry">重新看看</view>
    </view>

    <view class="magic-window__topbar" style="padding-top:{{statusBarHeight}}px;">
      <view class="magic-window__back" aria-role="button" aria-label="返回上海窗外" bindtap="onCloseMagicWindow"><view class="magic-window__back-icon"></view></view>
      <view class="magic-window__meta"><text>{{magicWindowLabel}}</text></view>
    </view>
  </view>

  <view wx:if="{{isExiting}}" class="scene-exit-backdrop"></view>
  <view wx:if="{{isExiting}}" class="scene-exit-overlay" style="{{exitTransitionStyle}}"><image class="scene-exit-image" src="{{panoramaImage}}" mode="aspectFill"></image></view>
</view>
