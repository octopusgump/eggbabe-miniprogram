<view class="page {{loading ? 'page--loading' : ''}} {{reducedMotion ? 'page--reduced' : ''}}">
  <view wx:if="{{isDemo && currentState && sceneBackgroundReady}}" class="scene-tester scene-tester--post-hatch" style="top:{{sceneTesterTopPx}}px;">
    <view class="scene-tester-button {{sceneTesterOpen ? 'scene-tester-button--open' : ''}} {{sceneTesterBusy ? 'scene-tester-button--busy' : ''}}" aria-role="button" aria-label="测试场景，当前{{sceneTesterLabel}}" bindtap="onSceneTesterToggle">
      <text class="scene-tester-tag">场景</text><text class="scene-tester-current">{{sceneTesterBusy ? '切换中…' : sceneTesterLabel}}</text><text class="scene-tester-chevron">⌄</text>
    </view>
    <scroll-view wx:if="{{sceneTesterOpen}}" class="scene-tester-menu" scroll-y="true">
      <view wx:for="{{sceneTesterOptions}}" wx:key="key" class="scene-tester-option {{sceneTesterKey === item.key ? 'scene-tester-option--active' : ''}}" data-scene="{{item.key}}" aria-role="button" bindtap="onSceneTesterSelect">
        <view class="scene-tester-option-copy"><text class="scene-tester-season">{{item.seasonLabel || '自动'}}</text><text>{{item.label}}</text></view>
        <text wx:if="{{sceneTesterKey === item.key}}">✓</text>
      </view>
    </scroll-view>
  </view>

  <!-- DEV-ONLY：与破壳前首页共享阶段验收器；release/trial 下 isDemo=false，不会渲染。 -->
  <view wx:if="{{isDemo && currentState && sceneBackgroundReady}}" class="stage-tester" style="top:{{stageTesterTopPx}}px;">
    <view class="stage-tester-button {{stageTesterOpen ? 'stage-tester-button--open' : ''}} {{stageTesterBusy ? 'stage-tester-button--busy' : ''}}" aria-role="button" aria-label="测试阶段，当前{{stageTesterLabel}}" catchtap="onStageTesterToggle">
      <text class="stage-tester-tag">测试</text><text>{{stageTesterBusy ? '切换中…' : stageTesterLabel}}</text><text class="stage-tester-chevron">⌄</text>
    </view>
    <view wx:if="{{stageTesterOpen}}" class="stage-tester-menu">
      <view wx:for="{{stageTesterOptions}}" wx:key="key" class="stage-tester-option {{stageTesterKey === item.key ? 'stage-tester-option--active' : ''}}" data-stage="{{item.key}}" aria-role="button" aria-label="切换到{{item.label}}" catchtap="onStageTesterSelect"><text>{{item.label}}</text><text wx:if="{{stageTesterKey === item.key}}">✓</text></view>
    </view>
  </view>

  <view wx:if="{{isDemo && currentState && sceneBackgroundReady}}" class="companion-state-tester" style="top:{{companionStateTesterTopPx}}px;">
    <view class="companion-state-tester-button {{companionStateTesterOpen ? 'companion-state-tester-button--open' : ''}}" aria-role="button" aria-label="测试陪伴状态，当前{{companionStateTesterLabel}}" bindtap="onCompanionStateTesterToggle">
      <text class="companion-state-tester-tag">状态</text><text class="companion-state-tester-current">{{companionStateTesterLabel}}</text><text class="companion-state-tester-chevron">⌄</text>
    </view>
    <view wx:if="{{companionStateTesterOpen}}" class="companion-state-tester-menu">
      <view wx:for="{{companionStateTesterOptions}}" wx:key="key" class="companion-state-tester-option {{companionStateTesterKey === item.key ? 'companion-state-tester-option--active' : ''}} {{!item.available ? 'companion-state-tester-option--missing' : ''}}" data-companion-state="{{item.key}}" aria-role="button" aria-disabled="{{!item.available}}" bindtap="onCompanionStateTesterSelect"><text>{{item.label}}</text><text wx:if="{{!item.available}}" class="companion-state-tester-missing">缺图片</text><text wx:elif="{{companionStateTesterKey === item.key}}">✓</text></view>
    </view>
  </view>
  <view wx:if="{{(!sceneEntered || !initialViewportReady) && !error}}" class="state-layer">
    <view class="loading-orbit"></view><text>{{loading ? '正在确认 ta 此刻状态…' : '正在加载房间…'}}</text>
  </view>
  <view wx:if="{{!loading && error}}" class="state-layer state-layer--error">
    <text class="state-error-title">暂时没看见 ta 此刻的状态</text><text>{{error}}</text>
    <view class="state-action" bindtap="onRetry">重新看看</view><view class="state-secondary" bindtap="onBack">返回主页</view>
  </view>

  <block wx:if="{{currentState && !error}}">
    <view class="scene-stage {{sceneEntered && initialViewportReady ? 'scene-stage--entered' : ''}}">
    <scroll-view class="world-scroll" scroll-x enhanced paging-enabled show-scrollbar="{{false}}" scroll-left="{{scrollLeft}}" bindscroll="onScroll">
      <view class="world-track">
        <image wx:if="{{previousPanoramaImage}}" class="world-panorama-bg world-panorama-bg--previous {{sceneCrossfadeActive ? 'world-panorama-bg--previous-fading' : ''}}" src="{{previousPanoramaImage}}" data-panorama-url="{{previousPanoramaImage}}" mode="aspectFill" bindanimationend="onPreviousPanoramaAnimationEnd"></image>
        <image class="world-panorama-bg" src="{{panoramaImage}}" mode="aspectFill" bindload="onSceneBackgroundLoad" binderror="onSceneBackgroundError"></image>
        <image wx:if="{{pendingPanoramaImage}}" class="world-panorama-preload" src="{{pendingPanoramaImage}}" data-panorama-url="{{pendingPanoramaImage}}" mode="aspectFill" bindload="onPendingPanoramaLoad" binderror="onPendingPanoramaError"></image>
        <view id="world-panel-0" class="world-panel world-panel--living">
          <view wx:if="{{!sceneUsesBakedAction}}" class="panel-tone" style="{{playedActionKind === 'lamp' ? 'background:rgba(23,29,38,.5);' : ''}}"></view>
          <view wx:for="{{windowHotspots[0]}}" wx:key="id" class="daily-window-hotspot daily-window-hotspot--panel-0 daily-window-hotspot--{{item.id}}" style="{{item.style}}" data-window-panel="{{item.panel}}" data-window-hotspot="{{item.id}}" aria-role="button" aria-label="查看窗外景色" bindtouchstart="onDailyWindowTouchStart" bindtouchmove="onDailyWindowTouchMove" bindtouchend="onDailyWindowTouchEnd" bindtouchcancel="onDailyWindowTouchCancel"></view>
          <view wx:if="{{showSceneCharacter && sceneCharacterScreen === 0}}" class="scene-character scene-character--{{sceneCharacterPose}} {{characterWarming ? 'scene-character--warming' : ''}}" aria-role="button" aria-label="轻触蛋宝宝" bindtap="onCharacterTap" bindtouchstart="onCharacterTouchStart" bindtouchend="onCharacterTouchEnd" bindtouchcancel="onCharacterTouchEnd">
            <view class="scene-character__floor-shadow" aria-hidden="true"></view>
            <image class="scene-character__pose-image" src="{{sceneCharacterImage}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{currentState.atHome && !currentState.actionDone && currentState.action.screen === 0}}" class="action-glow action-glow--{{currentState.action.kind}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
          <view wx:if="{{homeFocusVisible && currentState.atHome && currentState.action.screen === 0}}" class="home-locator-focus home-locator-focus--0" aria-hidden="true"></view>
          <view wx:if="{{homeTalkNudgeVisible && currentState.atHome && currentState.canTalk && currentState.action.screen === 0}}" class="scene-talk-nudge scene-talk-nudge--0" aria-role="button" aria-label="和蛋宝宝说话" bindtap="onOpenTalkComposer"><view class="scene-talk-nudge__dot"></view><view class="scene-talk-nudge__dot"></view><view class="scene-talk-nudge__dot"></view></view>
        </view>
        <view id="world-panel-1" class="world-panel world-panel--desk">
          <view wx:if="{{!sceneUsesBakedAction}}" class="panel-tone"></view>
          <view wx:for="{{windowHotspots[1]}}" wx:key="id" class="daily-window-hotspot daily-window-hotspot--panel-1 daily-window-hotspot--{{item.id}}" style="{{item.style}}" data-window-panel="{{item.panel}}" data-window-hotspot="{{item.id}}" aria-role="button" aria-label="查看窗外景色" bindtouchstart="onDailyWindowTouchStart" bindtouchmove="onDailyWindowTouchMove" bindtouchend="onDailyWindowTouchEnd" bindtouchcancel="onDailyWindowTouchCancel"></view>
          <view wx:if="{{showSceneCharacter && sceneCharacterScreen === 1}}" class="scene-character scene-character--{{sceneCharacterPose}} {{characterWarming ? 'scene-character--warming' : ''}}" aria-role="button" aria-label="轻触蛋宝宝" bindtap="onCharacterTap" bindtouchstart="onCharacterTouchStart" bindtouchend="onCharacterTouchEnd" bindtouchcancel="onCharacterTouchEnd">
            <view class="scene-character__floor-shadow" aria-hidden="true"></view>
            <image class="scene-character__pose-image" src="{{sceneCharacterImage}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{!sceneUsesBakedAction && currentState.action.kind === 'cup'}}" style="position:absolute;z-index:4;right:16%;bottom:29%;width:54rpx;height:48rpx;border:7rpx solid #F4EEE2;border-radius:8rpx 8rpx 18rpx 18rpx;background:#A8BEA0;transform:{{playedActionKind === 'cup' ? 'translateX(-34rpx)' : 'none'}};transition:transform .35s ease;"></view>
          <view wx:if="{{!sceneUsesBakedAction && currentState.action.kind === 'paper'}}" style="position:absolute;z-index:4;left:39%;bottom:20%;width:132rpx;height:86rpx;border-radius:8rpx;background:{{playedActionKind === 'paper' ? '#FFF9D8' : '#F6F4EB'}};box-shadow:0 8rpx 20rpx rgba(56,45,35,.16);transform:{{playedActionKind === 'paper' ? 'rotate(-8deg) scale(1.08)' : 'rotate(5deg)'}};transition:transform .35s ease;"></view>
          <view wx:if="{{!sceneUsesBakedAction && currentState.action.kind === 'screen'}}" style="position:absolute;z-index:4;left:24%;bottom:27%;width:116rpx;height:74rpx;border:10rpx solid #534C45;border-radius:14rpx;background:{{playedActionKind === 'screen' ? '#D9F0AD' : '#879586'}};box-shadow:{{playedActionKind === 'screen' ? '0 0 34rpx rgba(220,244,159,.8)' : 'none'}};transition:all .25s ease;"></view>
          <view wx:if="{{currentState.atHome && !currentState.actionDone && currentState.action.screen === 1}}" class="action-glow action-glow--{{currentState.action.kind}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
          <view wx:if="{{homeFocusVisible && currentState.atHome && currentState.action.screen === 1}}" class="home-locator-focus home-locator-focus--1" aria-hidden="true"></view>
          <view wx:if="{{homeTalkNudgeVisible && currentState.atHome && currentState.canTalk && currentState.action.screen === 1}}" class="scene-talk-nudge scene-talk-nudge--1" aria-role="button" aria-label="和蛋宝宝说话" bindtap="onOpenTalkComposer"><view class="scene-talk-nudge__dot"></view><view class="scene-talk-nudge__dot"></view><view class="scene-talk-nudge__dot"></view></view>
          <view wx:if="{{!currentState.atHome}}" class="away-note"><text class="away-kicker">{{currentState.majorLabel}} · {{currentState.label}}</text><text class="away-line">{{currentState.line}}</text></view>
        </view>
        <view id="world-panel-2" class="world-panel world-panel--decor">
          <view wx:if="{{!sceneUsesBakedAction}}" class="panel-tone"></view>
          <view wx:for="{{windowHotspots[2]}}" wx:key="id" class="daily-window-hotspot daily-window-hotspot--panel-2 daily-window-hotspot--{{item.id}}" style="{{item.style}}" data-window-panel="{{item.panel}}" data-window-hotspot="{{item.id}}" aria-role="button" aria-label="查看窗外景色" bindtouchstart="onDailyWindowTouchStart" bindtouchmove="onDailyWindowTouchMove" bindtouchend="onDailyWindowTouchEnd" bindtouchcancel="onDailyWindowTouchCancel"></view>
          <view wx:if="{{currentState.atHome && !currentState.actionDone && currentState.action.screen === 2 && currentState.action.kind !== 'window'}}" class="action-glow action-glow--{{currentState.action.kind}}" aria-role="button" aria-label="回应 ta 此刻的动作" bindtap="onSceneAction"></view>
          <view wx:if="{{homeFocusVisible && currentState.atHome && currentState.action.screen === 2}}" class="home-locator-focus home-locator-focus--2" aria-hidden="true"></view>
          <view wx:if="{{homeTalkNudgeVisible && currentState.atHome && currentState.canTalk && currentState.action.screen === 2}}" class="scene-talk-nudge scene-talk-nudge--2" aria-role="button" aria-label="和蛋宝宝说话" bindtap="onOpenTalkComposer"><view class="scene-talk-nudge__dot"></view><view class="scene-talk-nudge__dot"></view><view class="scene-talk-nudge__dot"></view></view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{sceneBackgroundError || sceneTransitionError}}" class="scene-background-error" bindtap="onRetrySceneBackground">{{sceneTransitionError ? '房间背景更新失败 · 轻触重试' : '房间背景没有加载好 · 轻触重试'}}</view>

    <view class="screen-dots"><view wx:for="{{screens}}" wx:key="*this" class="screen-dot {{currentScreen === item ? 'screen-dot--active' : ''}}"></view></view>
    <view wx:if="{{statusBubble && !feedback}}" class="scene-status-bubble {{statusBubbleVisible ? 'scene-status-bubble--visible' : ''}} {{isDemo ? 'scene-bubble--demo-safe' : ''}}">{{statusBubble}}</view>
    <view wx:if="{{feedback}}" class="feedback-bubble {{isDemo ? 'scene-bubble--demo-safe' : ''}}">{{feedback}}</view>

    <view wx:if="{{composerVisible && currentState.atHome && currentState.canTalk}}" class="scene-composer">
      <view class="composer-close" aria-role="button" aria-label="收起对话输入" bindtap="onCloseComposer">×</view>
      <text wx:if="{{talkReply}}" class="inline-reply">{{talkReply}}</text><text wx:if="{{talkError}}" class="composer-error">{{talkError}}</text>
      <view class="composer-row"><input class="composer-input" value="{{talkDraft}}" maxlength="120" focus="{{composerVisible}}" placeholder="在这里说一句…" bindinput="onTalkInput" bindconfirm="onSendTalk" confirm-type="send" /><view class="composer-send {{talkBusy ? 'composer-send--busy' : ''}}" bindtap="onSendTalk">{{talkBusy ? '…' : '说'}}</view></view>
    </view>
    <view wx:elif="{{composerVisible && !currentState.atHome}}" class="scene-composer scene-composer--letter {{letterKeyboardHeight > 0 ? 'scene-composer--keyboard' : ''}}" style="top:{{letterComposerTopPx}}px;">
      <view class="composer-close" aria-role="button" aria-label="收起写信输入" bindtap="onCloseComposer">×</view>
      <text wx:if="{{letterError}}" class="composer-error">{{letterError}}</text>
      <view wx:if="{{currentState.letterSent}}" class="letter-sent">信已经在路上了</view>
      <view wx:else class="composer-row"><input class="composer-input" value="{{letterDraft}}" maxlength="120" focus="{{composerVisible}}" adjust-position="{{false}}" hold-keyboard="{{true}}" cursor-spacing="24" placeholder="给远方的 ta 写一句…" bindinput="onLetterInput" bindconfirm="onSendLetter" bindkeyboardheightchange="onLetterKeyboardHeightChange" confirm-type="send" /><view class="composer-send composer-send--paper-plane {{letterBusy ? 'composer-send--busy' : ''}}" aria-role="button" aria-label="{{letterBusy ? '正在寄出' : '寄出这封信'}}" bindtap="onSendLetter"><view wx:if="{{letterBusy}}" class="composer-send-spinner"></view><view wx:else class="composer-paper-plane"><view class="composer-paper-plane__fold"></view></view></view></view>
    </view>

    <view wx:if="{{toolboxVisible}}" class="toolbox-mask" catchtap="onCloseToolbox" catchtouchmove="noop"></view>
    <view wx:if="{{toolboxVisible}}" class="toolbox-sheet">
      <text class="toolbox-title">百宝箱</text>
      <view class="toolbox-grid">
        <view class="toolbox-item" data-target="my" bindtap="onToolboxItemTap">
          <image class="toolbox-item-icon" src="/assets/ui/3d-actions/runtime/ui_3d_tabbar_interaction_gear_flat_96_v04.png" mode="aspectFit"></image>
          <text>我的 / 设置</text>
        </view>
        <view class="toolbox-item" data-target="card" bindtap="onToolboxItemTap"><image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_collection_card_front_96_v03.webp" mode="aspectFit"></image><text>收藏卡</text></view>
        <view class="toolbox-item" data-target="postcards" bindtap="onToolboxItemTap"><image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_postcard_vintage_front_96_v03.webp" mode="aspectFit"></image><text>明信片</text></view>
        <view class="toolbox-item" data-target="keepsakes" bindtap="onToolboxItemTap"><image class="toolbox-item-icon" src="/assets/ui/3d-toolbox/runtime/ui_3d_toolbox_keepsake_box_96_v01.png" mode="aspectFit"></image><text>ta 带回来的东西</text></view>
      </view>
    </view>

    <view wx:if="{{!composerVisible}}" class="scene-context-entry">
      <view class="scene-action-button {{contextActionShowTalkBadge ? 'scene-action-button--talkable' : ''}}" hover-class="scene-action-button--pressed" aria-role="button" aria-label="{{contextActionLabel}}" bindtap="onContextActionTap">
        <image class="scene-action-icon-image" src="{{contextActionIcon}}" mode="aspectFit"></image>
        <view wx:if="{{contextActionShowTalkBadge}}" class="scene-action-talk-badge" aria-hidden="true"><view class="scene-action-talk-badge__dot"></view><view class="scene-action-talk-badge__dot"></view><view class="scene-action-talk-badge__dot"></view></view>
        <view wx:if="{{contextActionHasNewMessage}}" class="scene-action-unread-dot" aria-hidden="true"></view>
      </view>
    </view>

    <view wx:if="{{!composerVisible}}" class="scene-action-dock">
      <view class="scene-action-button" hover-class="scene-action-button--pressed" aria-role="button" aria-label="打开百宝箱" bindtap="onToggleToolbox">
        <image class="scene-action-icon-image" src="{{toolboxIcon}}" mode="aspectFit"></image>
      </view>
    </view>
    </view>
  </block>

  <daily-window-detail
    id="dailyWindowDetail"
    visible="{{dailyWindowVisible}}"
    image="{{dailyWindowEnvironment.windowImage}}"
    weather="{{dailyWindowEnvironment.weather}}"
    season="{{dailyWindowEnvironment.season}}"
    period="{{dailyWindowEnvironment.period}}"
    light-phase="{{dailyWindowEnvironment.lightPhase}}"
    weather-label="{{dailyWindowWeatherLabel}}"
    period-label="{{dailyWindowPeriodLabel}}"
    origin-style="{{dailyWindowOriginStyle}}"
    magic-enabled="{{magicWindowEnabled}}"
    bindclose="onDailyWindowClosed"
    bindretry="onDailyWindowRetry"
    bindmagic="onOpenMagicWindow"
  ></daily-window-detail>

  <view
    wx:if="{{magicWindowVisible}}"
    class="magic-window {{reducedMotion ? 'magic-window--reduced' : ''}}"
    catchtouchmove="onMagicTouchMove"
  >
    <image
      wx:if="{{magicWindowBase}}"
      class="magic-window__base"
      src="{{magicWindowBase}}"
      mode="aspectFill"
      bindload="onMagicWindowBaseLoad"
      binderror="onMagicWindowBaseError"
    ></image>
    <view wx:if="{{!magicWindowFailed}}" class="magic-window__atmosphere" aria-hidden="true">
      <image class="magic-window__clouds magic-window__clouds--near" src="{{magicWindowClouds}}" mode="widthFix"></image>
      <image class="magic-window__clouds magic-window__clouds--far" src="{{magicWindowClouds}}" mode="widthFix"></image>
      <view class="magic-window__water-shimmer"></view>
    </view>
    <view
      wx:if="{{!magicWindowLoading && !magicWindowFailed}}"
      class="magic-window__koi-track {{magicKoiReacting ? 'magic-window__koi-track--reacting' : ''}}"
      aria-role="button"
      aria-label="轻触锦鲤，看它跳起来"
      catchtap="onMagicKoiTap"
    >
      <view class="magic-window__koi-shadow"></view>
      <view class="magic-window__koi-ripple magic-window__koi-ripple--one"></view>
      <view class="magic-window__koi-ripple magic-window__koi-ripple--two"></view>
      <image class="magic-window__koi" src="{{magicWindowKoi}}" mode="widthFix"></image>
    </view>
    <text wx:if="{{!magicWindowLoading && !magicWindowFailed}}" class="magic-window__hint">轻触锦鲤</text>

    <view wx:if="{{magicWindowLoading && !magicWindowFailed}}" class="magic-window__state">
      <view class="magic-window__loader"></view>
      <text>正在推开{{magicWindowLabel}}的窗…</text>
    </view>
    <view wx:elif="{{magicWindowFailed}}" class="magic-window__state magic-window__state--error">
      <text class="magic-window__state-title">{{magicWindowLabel}}窗景没有加载好</text>
      <view class="magic-window__retry" aria-role="button" bindtap="onMagicWindowRetry">重新看看</view>
    </view>

    <view class="magic-window__topbar" style="padding-top:{{statusBarHeight}}px;">
      <view class="magic-window__back" aria-role="button" aria-label="返回上海窗外" bindtap="onCloseMagicWindow"><view class="magic-window__back-icon"></view></view>
      <view class="magic-window__meta"><text>{{magicWindowLabel}}</text></view>
    </view>
  </view>

  <view wx:if="{{isExiting}}" class="scene-exit-backdrop"></view>
  <view wx:if="{{isExiting}}" class="scene-exit-overlay" style="{{exitTransitionStyle}}"><image class="scene-exit-image" src="{{panoramaImage}}" mode="aspectFill"></image></view>
</view>
