.page{position:relative;width:100vw;height:100vh;overflow:hidden;background:#EEE8DB;color:#28332B}
.stage-tester{position:fixed;z-index:92;right:28rpx;width:210rpx}
.stage-tester-button{min-height:64rpx;display:flex;align-items:center;justify-content:center;gap:9rpx;padding:0 14rpx;box-sizing:border-box;border:1rpx solid rgba(225,229,215,.95);border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 9rpx 26rpx rgba(44,54,39,.14);color:#3F5543;font-size:21rpx;font-weight:600;backdrop-filter:blur(10rpx)}
.stage-tester-button--open{border-color:rgba(133,157,102,.82)}
.stage-tester-button--busy{opacity:.66}
.stage-tester-tag{padding:5rpx 8rpx;border-radius:9rpx;background:#EDF2E3;color:#71834F;font-size:15rpx;letter-spacing:1rpx}
.stage-tester-chevron{margin-top:-5rpx;color:#829073;font-size:22rpx}
.stage-tester-menu{overflow:hidden;margin-top:10rpx;padding:7rpx;border:1rpx solid rgba(225,229,215,.96);border-radius:22rpx;background:rgba(255,253,247,.97);box-shadow:0 15rpx 38rpx rgba(44,54,39,.18);backdrop-filter:blur(12rpx)}
.stage-tester-option{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;padding:0 17rpx;border-radius:999rpx;color:#586458;font-size:20rpx}
.stage-tester-option--active{background:#EEF3E5;color:#36513C;font-weight:600}
.scene-tester{position:fixed;z-index:90;right:28rpx;width:270rpx}
.scene-tester-button{min-height:64rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;padding:0 12rpx;box-sizing:border-box;border:1rpx solid rgba(225,229,215,.95);border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 9rpx 26rpx rgba(44,54,39,.14);color:#3F5543;font-size:19rpx;font-weight:600;backdrop-filter:blur(10rpx)}
.scene-tester-button--open{border-color:rgba(133,157,102,.82)}
.scene-tester-button--busy{opacity:.68}
.scene-tester-tag{flex:none;padding:5rpx 8rpx;border-radius:9rpx;background:#EDF2E3;color:#71834F;font-size:15rpx;letter-spacing:1rpx}
.scene-tester-current{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.scene-tester-chevron{flex:none;margin-top:-5rpx;color:#829073;font-size:22rpx}
.scene-tester-menu{width:320rpx;max-height:700rpx;margin-top:10rpx;margin-left:-50rpx;padding:7rpx;box-sizing:border-box;border:1rpx solid rgba(225,229,215,.96);border-radius:22rpx;background:rgba(255,253,247,.97);box-shadow:0 15rpx 38rpx rgba(44,54,39,.18);backdrop-filter:blur(12rpx)}
.scene-tester-option{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;padding:0 15rpx;border-radius:999rpx;color:#586458;font-size:19rpx}
.scene-tester-option--active{background:#EEF3E5;color:#36513C;font-weight:600}
.scene-tester-option-copy{display:flex;align-items:center;gap:10rpx}
.scene-tester-season{min-width:54rpx;color:#80906C;font-size:17rpx}
.companion-state-tester{position:fixed;z-index:89;right:28rpx;width:270rpx}
.companion-state-tester-button{min-height:64rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;padding:0 12rpx;box-sizing:border-box;border:1rpx solid rgba(225,229,215,.95);border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 9rpx 26rpx rgba(44,54,39,.14);color:#3F5543;font-size:19rpx;font-weight:600;backdrop-filter:blur(10rpx)}
.companion-state-tester-button--open{border-color:rgba(133,157,102,.82)}
.companion-state-tester-tag{flex:none;padding:5rpx 8rpx;border-radius:9rpx;background:#EDF2E3;color:#71834F;font-size:15rpx;letter-spacing:1rpx}
.companion-state-tester-current{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.companion-state-tester-chevron{flex:none;margin-top:-5rpx;color:#829073;font-size:22rpx}
.companion-state-tester-menu{overflow:hidden;margin-top:10rpx;padding:7rpx;border:1rpx solid rgba(225,229,215,.96);border-radius:22rpx;background:rgba(255,253,247,.97);box-shadow:0 15rpx 38rpx rgba(44,54,39,.18);backdrop-filter:blur(12rpx)}
.companion-state-tester-option{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;padding:0 15rpx;border-radius:999rpx;color:#586458;font-size:19rpx}
.companion-state-tester-option--active{background:#EEF3E5;color:#36513C;font-weight:600}
.state-layer{position:absolute;z-index:80;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;padding:80rpx;background:linear-gradient(160deg,#F7EEDC,#D9C7A8);color:#697268;font-size:24rpx;text-align:center}
.state-layer--error{background:#F6F4ED}
.state-error-title{color:#344136;font-size:32rpx;font-weight:600}
.loading-orbit{width:52rpx;height:52rpx;border:5rpx solid #D8DFC5;border-top-color:#6F8449;border-radius:50%;animation:loading-spin .8s linear infinite}
.state-action{min-width:180rpx;height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 28rpx;border-radius:999rpx;background:#3F5A47;color:#FFF}
.state-secondary{padding:14rpx 24rpx;color:#6D766D}
.scene-stage{position:absolute;inset:0;opacity:0;transition:opacity .34s ease;pointer-events:none}
.scene-stage--entered{opacity:1;pointer-events:auto}
.world-scroll{width:100vw;height:100vh;white-space:nowrap}
.world-track{position:relative;width:300vw;height:100vh;display:flex;background:linear-gradient(160deg,#F7EEDC,#D9C7A8)}
.world-panorama-bg{position:absolute;z-index:0;left:0;top:0;width:300vw;height:100vh;display:block}
.world-panorama-bg--previous{z-index:1;pointer-events:none;animation:environment-crossfade-out .52s ease-out both}
.world-panel{position:relative;z-index:1;width:100vw;height:100vh;flex:0 0 100vw;overflow:hidden;background:transparent}
.panel-tone{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(62,44,28,.18))}
.daily-window-hotspot{position:absolute;z-index:7;box-sizing:border-box}
.daily-window-hotspot:active{background:rgba(255,255,255,.025)}
.scene-character{position:absolute;z-index:5;filter:drop-shadow(0 16rpx 18rpx rgba(67,45,26,.2));animation:character-breathe 4.2s ease-in-out infinite}
.scene-character--warming{filter:drop-shadow(0 0 28rpx rgba(255,235,157,.82)) drop-shadow(0 16rpx 18rpx rgba(67,45,26,.2))}
.scene-character--sleep{left:15.5%;bottom:22%;width:380rpx;height:380rpx;filter:none}
.scene-character--sleep.scene-character--warming{filter:drop-shadow(0 0 28rpx rgba(255,235,157,.82))}
.scene-character--stare{left:26%;bottom:19%;width:340rpx;height:510rpx;filter:none}
.scene-character--stare.scene-character--warming{filter:drop-shadow(0 0 28rpx rgba(255,235,157,.82))}
.scene-character__floor-shadow{position:absolute;z-index:0;left:16%;right:14%;bottom:6.5%;height:26rpx;border-radius:50%;background:rgba(63,42,25,.3);filter:blur(11rpx);transform:rotate(-3deg) scaleY(.72);pointer-events:none}
.scene-character__pose-image{position:absolute;z-index:1;inset:0;width:100%;height:100%;filter:drop-shadow(0 8rpx 9rpx rgba(58,39,25,.13));pointer-events:none}
.action-glow{position:absolute;z-index:8;width:92rpx;height:92rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,248,181,.7),rgba(255,248,181,.12) 50%,transparent 72%);animation:action-breathe 2.6s ease-in-out infinite}
.action-glow--lamp{left:69%;bottom:34%}
.action-glow--blanket{left:35%;bottom:31%}
.action-glow--pet{left:44%;bottom:34%;pointer-events:none}
.action-glow--cup{right:15%;bottom:31%}
.action-glow--paper{left:54%;bottom:19%}
.action-glow--screen{left:28%;bottom:28%}
.action-glow--window{right:18%;top:24%}
.away-note{position:absolute;z-index:6;left:10%;right:10%;top:34%;padding:30rpx;border-radius:30rpx;background:rgba(255,253,247,.9);box-shadow:0 18rpx 50rpx rgba(45,37,27,.12);white-space:normal}
.away-kicker,.away-line{display:block}
.away-kicker{color:#7C8D58;font-size:19rpx;letter-spacing:2rpx}
.away-line{margin-top:14rpx;color:#344036;font-size:28rpx;line-height:1.65}
.screen-dots{position:absolute;z-index:12;left:50%;top:calc(118rpx + env(safe-area-inset-top));display:flex;gap:10rpx;transform:translateX(-50%);pointer-events:none}
.screen-dot{width:9rpx;height:9rpx;border-radius:50%;background:rgba(255,255,255,.5);box-shadow:0 2rpx 5rpx rgba(0,0,0,.14)}
.screen-dot--active{width:28rpx;border-radius:999rpx;background:#FFF}
.scene-status-bubble{position:absolute;z-index:22;left:50%;top:calc(154rpx + env(safe-area-inset-top));max-width:500rpx;padding:16rpx 24rpx;border-radius:26rpx 26rpx 26rpx 8rpx;background:rgba(255,253,247,.84);box-shadow:0 10rpx 28rpx rgba(42,49,37,.14);color:#3D4930;font-size:23rpx;line-height:1.45;opacity:0;transform:translate(-50%,8rpx);transition:opacity .22s ease,transform .22s ease;pointer-events:none}
.scene-status-bubble--visible{opacity:1;transform:translate(-50%,0)}
.feedback-bubble{position:absolute;z-index:22;left:50%;top:24%;max-width:520rpx;padding:20rpx 28rpx;border-radius:28rpx 28rpx 28rpx 8rpx;background:rgba(255,255,255,.80);box-shadow:0 12rpx 36rpx rgba(0,41,0,.12);color:#3D4930;font-size:24rpx;line-height:1.5;white-space:pre-line;transform:translateX(-50%);animation:bubble-in .22s ease-out;pointer-events:none}
.scene-background-error{position:absolute;z-index:24;left:50%;top:calc(168rpx + env(safe-area-inset-top));padding:14rpx 22rpx;border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 8rpx 24rpx rgba(45,37,27,.14);color:#6F5745;font-size:20rpx;transform:translateX(-50%)}
.scene-composer{position:absolute;z-index:27;left:28rpx;right:28rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));padding:46rpx 14rpx 14rpx;border-radius:34rpx;background:rgba(255,255,255,.94);box-shadow:0 12rpx 42rpx rgba(36,45,37,.18);backdrop-filter:blur(14rpx)}
.scene-composer--letter{position:fixed;bottom:auto;transition:top .2s ease}
.scene-composer--keyboard{transition-duration:.12s}
.composer-close{position:absolute;right:14rpx;top:8rpx;width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#EEF1E8;color:#687467;font-size:31rpx;line-height:1}
.composer-row{display:flex;align-items:center;gap:12rpx}
.composer-input{height:112rpx;flex:1;padding:0 24rpx;border-radius:999rpx;background:#F5F6F0;color:#28332B;font-size:24rpx}
.composer-send{width:112rpx;height:112rpx;flex:0 0 112rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#3F5A47;color:#FFF;font-size:22rpx}
.composer-send--paper-plane{position:relative;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.9);background:linear-gradient(145deg,#FFFDF8 0%,#EEF2EA 65%,#DDE6DA 100%);box-shadow:0 10rpx 22rpx rgba(34,45,36,.2),inset 0 4rpx 5rpx rgba(255,255,255,.95),inset 0 -6rpx 10rpx rgba(88,111,88,.13)}
.composer-send--paper-plane:active{transform:translateY(2rpx) scale(.96);box-shadow:0 5rpx 12rpx rgba(34,45,36,.16),inset 0 3rpx 6rpx rgba(88,111,88,.13)}
.composer-paper-plane{position:relative;width:72rpx;height:60rpx;filter:drop-shadow(0 7rpx 5rpx rgba(20,91,164,.28));transform:rotate(-7deg)}
.composer-paper-plane::before{position:absolute;inset:0;content:"";background:linear-gradient(145deg,#91DCFF 0%,#45B8F4 38%,#1685E5 72%,#075ABD 100%);-webkit-clip-path:polygon(2% 46%,100% 0,73% 100%,51% 68%,30% 88%);clip-path:polygon(2% 46%,100% 0,73% 100%,51% 68%,30% 88%)}
.composer-paper-plane::after{position:absolute;left:29%;top:41%;width:47%;height:49%;content:"";background:linear-gradient(135deg,rgba(13,101,203,.98),rgba(74,181,244,.88));-webkit-clip-path:polygon(0 17%,100% 0,45% 100%);clip-path:polygon(0 17%,100% 0,45% 100%)}
.composer-paper-plane__fold{position:absolute;z-index:2;left:37%;top:38%;width:43%;height:15%;background:linear-gradient(90deg,rgba(217,246,255,.86),rgba(67,175,240,.2));-webkit-clip-path:polygon(0 0,100% 48%,0 100%);clip-path:polygon(0 0,100% 48%,0 100%)}
.composer-send-spinner{width:32rpx;height:32rpx;border:5rpx solid rgba(31,133,218,.2);border-top-color:#1685E5;border-radius:50%;animation:loading-spin .75s linear infinite}
.composer-send--busy{opacity:.72}
.inline-reply,.composer-error{display:block;padding:4rpx 12rpx 12rpx;font-size:21rpx;line-height:1.5}
.inline-reply{color:#435B43}
.composer-error{color:#B34A43}
.letter-sent{height:112rpx;display:flex;align-items:center;justify-content:center;color:#60705B;font-size:23rpx}
.toolbox-mask{position:fixed;z-index:23;inset:0;background:rgba(22,29,24,.12)}
.toolbox-sheet{position:absolute;z-index:25;right:24rpx;bottom:calc(152rpx + env(safe-area-inset-bottom));width:430rpx;padding:24rpx;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.72);border-radius:36rpx;background:rgba(255,253,247,.94);box-shadow:0 18rpx 54rpx rgba(36,45,37,.2),inset 0 1rpx 0 rgba(255,255,255,.84);backdrop-filter:blur(18rpx)}
.toolbox-title{display:block;margin:0 0 18rpx 4rpx;color:#405044;font-size:23rpx;font-weight:650;letter-spacing:2rpx}
.toolbox-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx}
.toolbox-item{min-height:126rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;padding:12rpx 8rpx;box-sizing:border-box;border:1rpx solid rgba(221,225,213,.9);border-radius:25rpx;background:linear-gradient(145deg,#FFFDF8,#EFF1E9);box-shadow:0 7rpx 14rpx rgba(53,64,53,.08);color:#4A594D;font-size:19rpx;text-align:center}
.toolbox-item:active{transform:scale(.97)}
.toolbox-item-icon{display:block;width:64rpx;height:64rpx;flex:0 0 64rpx}
.scene-context-entry{position:absolute;z-index:26;left:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom))}
.scene-action-dock{position:absolute;z-index:26;right:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:16rpx}
.scene-action-button{position:relative;width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.78);border-radius:50%;background:linear-gradient(145deg,rgba(255,254,249,.97),rgba(230,235,224,.96));box-shadow:0 11rpx 25rpx rgba(34,45,36,.18),inset 0 3rpx 4rpx rgba(255,255,255,.94),inset 0 -4rpx 8rpx rgba(96,112,91,.1);transition:transform .16s ease,box-shadow .16s ease}
.scene-action-button--talkable{border-color:rgba(241,236,154,.96);box-shadow:0 0 0 4rpx rgba(251,249,225,.78),0 11rpx 25rpx rgba(34,45,36,.18),inset 0 3rpx 4rpx rgba(255,255,255,.94),inset 0 -4rpx 8rpx rgba(96,112,91,.1)}
.scene-action-button--pressed{transform:translateY(2rpx) scale(.96);box-shadow:0 5rpx 12rpx rgba(34,45,36,.15),inset 0 3rpx 6rpx rgba(96,112,91,.12)}
.scene-action-icon-image{display:block;width:72rpx;height:72rpx;filter:drop-shadow(0 5rpx 5rpx rgba(57,65,50,.16))}
.scene-action-talk-badge{position:absolute;right:-8rpx;top:-7rpx;width:42rpx;height:34rpx;display:flex;align-items:center;justify-content:center;gap:4rpx;border:2rpx solid rgba(255,255,255,.96);border-radius:18rpx 18rpx 18rpx 7rpx;background:#F1EC9A;box-shadow:0 5rpx 12rpx rgba(66,59,28,.2);pointer-events:none}
.scene-action-talk-badge__dot{width:5rpx;height:5rpx;border-radius:50%;background:#26362B}
.scene-action-unread-dot{position:absolute;z-index:2;top:30rpx;right:16rpx;width:18rpx;height:18rpx;box-sizing:border-box;border:3rpx solid rgba(255,253,247,.98);border-radius:50%;background:#D9463C;box-shadow:0 3rpx 8rpx rgba(99,43,37,.24);pointer-events:none}
.home-locator-focus{position:absolute;z-index:9;width:246rpx;height:246rpx;border:2rpx solid rgba(255,248,184,.72);border-radius:50%;background:radial-gradient(circle,rgba(255,247,181,.34),rgba(255,247,181,.08) 52%,transparent 72%);box-shadow:0 0 42rpx rgba(255,239,151,.54);animation:home-locator-pulse 1.12s ease-out both;pointer-events:none}
.home-locator-focus--0{left:18%;bottom:20%}
.home-locator-focus--1{left:37%;bottom:20%}
.home-locator-focus--2{right:12%;top:18%}
.scene-talk-nudge{position:absolute;z-index:16;width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;gap:7rpx;border:1rpx solid rgba(255,255,255,.88);border-radius:50%;background:rgba(255,253,247,.94);box-shadow:0 8rpx 20rpx rgba(42,53,41,.19),inset 0 2rpx 2rpx rgba(255,255,255,.82);animation:talk-nudge-in .2s ease-out both}
.scene-talk-nudge__dot{width:8rpx;height:8rpx;border-radius:50%;background:#718563}
.scene-talk-nudge--0{left:52%;bottom:48%}
.scene-talk-nudge--1{left:54%;bottom:44%}
.scene-talk-nudge--2{right:22%;top:32%}
.magic-window{position:fixed;z-index:360;inset:0;overflow:hidden;background:#D8C5B2;color:#FFF;animation:magic-window-enter .32s ease-out both}
.magic-window__base{position:absolute;z-index:0;inset:0;width:100%;height:100%;display:block}
.magic-window__atmosphere{position:absolute;z-index:1;inset:0;overflow:hidden;pointer-events:none}
.magic-window__clouds{position:absolute;height:auto;opacity:.62;filter:blur(.35rpx);will-change:transform}
.magic-window__clouds--near{top:8%;left:-78%;width:210%;animation:magic-window-cloud-near 34s linear infinite}
.magic-window__clouds--far{top:22%;left:-42%;width:166%;opacity:.32;transform:scale(.78);animation:magic-window-cloud-far 48s linear infinite}
.magic-window__water-shimmer{position:absolute;left:22%;right:9%;top:52%;height:12%;border-radius:50%;opacity:.35;background:repeating-linear-gradient(174deg,transparent 0,transparent 12rpx,rgba(255,236,191,.42) 15rpx,transparent 19rpx);filter:blur(2rpx);transform:skewX(-12deg);animation:magic-window-water 5.2s ease-in-out infinite}
.magic-window__koi-track{position:absolute;z-index:5;left:3%;bottom:12%;width:48%;height:260rpx;animation:magic-window-koi-walk 8.5s ease-in-out infinite alternate;transform-origin:50% 100%}
.magic-window__koi{position:absolute;z-index:2;left:0;bottom:18rpx;width:100%;height:auto;filter:drop-shadow(0 15rpx 12rpx rgba(48,30,18,.26));transform-origin:50% 88%}
.magic-window__koi-shadow{position:absolute;z-index:1;left:20%;right:13%;bottom:14rpx;height:24rpx;border-radius:50%;background:rgba(24,28,28,.25);filter:blur(8rpx);transform-origin:center}
.magic-window__koi-ripple{position:absolute;z-index:0;left:49%;bottom:5rpx;width:70%;height:28rpx;border:3rpx solid rgba(255,238,195,.55);border-radius:50%;opacity:0;transform:translateX(-50%) scale(.4)}
.magic-window__koi-ripple--two{width:92%;animation-delay:.15s!important}
.magic-window__koi-track--reacting .magic-window__koi{animation:magic-window-koi-jump 1s cubic-bezier(.22,.7,.35,1) both}
.magic-window__koi-track--reacting .magic-window__koi-shadow{animation:magic-window-koi-shadow 1s ease-out both}
.magic-window__koi-track--reacting .magic-window__koi-ripple{animation:magic-window-koi-ripple .85s ease-out both}
.magic-window__hint{position:absolute;z-index:6;left:50%;bottom:calc(42rpx + env(safe-area-inset-bottom));padding:10rpx 19rpx;border:1rpx solid rgba(255,255,255,.38);border-radius:999rpx;background:rgba(27,38,36,.34);box-shadow:0 8rpx 24rpx rgba(20,28,27,.13);font-size:18rpx;letter-spacing:3rpx;transform:translateX(-50%);backdrop-filter:blur(8rpx)}
.magic-window__topbar{position:absolute;z-index:12;left:24rpx;right:24rpx;top:0;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box;pointer-events:none}
.magic-window__back,.magic-window__meta{margin-top:16rpx;pointer-events:auto;backdrop-filter:blur(12rpx)}
.magic-window__back{width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(25,35,31,.46);box-shadow:0 8rpx 22rpx rgba(13,22,20,.14)}
.magic-window__back:active{transform:scale(.95)}
.magic-window__back-icon{width:19rpx;height:19rpx;margin-left:7rpx;border-left:4rpx solid #FFF;border-bottom:4rpx solid #FFF;transform:rotate(45deg)}
.magic-window__meta{padding:14rpx 22rpx;border-radius:999rpx;background:rgba(255,253,247,.84);color:#415047;font-size:20rpx;letter-spacing:1rpx}
.magic-window__state{position:absolute;z-index:10;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:90rpx;box-sizing:border-box;background:linear-gradient(165deg,rgba(231,236,229,.96),rgba(185,203,194,.96));color:#536158;font-size:23rpx;text-align:center}
.magic-window__state--error{background:linear-gradient(165deg,#EEF1EA,#CCD8D0)}
.magic-window__state-title{color:#35443A;font-size:31rpx;font-weight:600}
.magic-window__loader{width:50rpx;height:50rpx;border:5rpx solid rgba(255,255,255,.62);border-top-color:#667E6E;border-radius:50%;animation:loading-spin .8s linear infinite}
.magic-window__retry{min-width:180rpx;height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 28rpx;border-radius:999rpx;background:#3F5A47;color:#FFF;font-size:22rpx}
.scene-exit-backdrop{position:fixed;z-index:90;inset:0;background:#FAFAF8}
.scene-exit-overlay{position:fixed;z-index:91;left:0;top:0;width:100vw;height:100vh;overflow:hidden;background:#DCE5CE;animation:scene-collapse-to-card var(--scene-exit-duration,560ms) cubic-bezier(.22,.61,.36,1) forwards}
.scene-exit-image{display:block;width:100%;height:100%}
@keyframes loading-spin{to{transform:rotate(360deg)}
}
@keyframes character-breathe{0%,100%{transform:translateY(0)}
50%{transform:translateY(4rpx) scale(1.01,.985)}
}
.scene-character--desk{animation-name:character-breathe-desk}
@keyframes character-breathe-desk{0%,100%{transform:translateX(-50%) translateY(0)}
50%{transform:translateX(-50%) translateY(4rpx) scale(1.01,.985)}
}
@keyframes action-breathe{0%,100%{opacity:.34;transform:scale(.88)}
50%{opacity:.76;transform:scale(1.05)}
}
@keyframes home-locator-pulse{0%{opacity:0;transform:scale(.7)}45%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.12)}}
@keyframes talk-nudge-in{from{opacity:0;transform:translateY(10rpx) scale(.86)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes bubble-in{from{opacity:0;transform:translate(-50%,8rpx)}
to{opacity:1;transform:translate(-50%,0)}
}
@keyframes magic-window-enter{from{opacity:0;transform:scale(1.018)}to{opacity:1;transform:scale(1)}}
@keyframes magic-window-cloud-near{from{transform:translateX(-2%)}to{transform:translateX(36%)}}
@keyframes magic-window-cloud-far{from{transform:translateX(5%) scale(.78)}to{transform:translateX(-30%) scale(.78)}}
@keyframes magic-window-water{0%,100%{opacity:.2;transform:translateX(-7rpx) skewX(-12deg) scaleX(.96)}50%{opacity:.48;transform:translateX(10rpx) skewX(-12deg) scaleX(1.04)}}
@keyframes magic-window-koi-walk{0%{transform:translateX(-4rpx) rotate(-1deg)}100%{transform:translateX(90vw) rotate(1deg)}}
@keyframes magic-window-koi-jump{0%,100%{transform:translateY(0) rotate(0) scale(1)}20%{transform:translateY(8rpx) rotate(-3deg) scale(1.03,.96)}48%{transform:translateY(-118rpx) rotate(8deg) scale(.98,1.04)}68%{transform:translateY(-54rpx) rotate(-5deg) scale(1.01)}84%{transform:translateY(5rpx) rotate(2deg) scale(1.04,.94)}}
@keyframes magic-window-koi-shadow{0%,100%{opacity:1;transform:scale(1)}48%{opacity:.22;transform:scale(.55)}84%{opacity:.7;transform:scale(1.12)}}
@keyframes magic-window-koi-ripple{0%{opacity:.72;transform:translateX(-50%) scale(.35)}100%{opacity:0;transform:translateX(-50%) scale(1.4)}}
@keyframes scene-collapse-to-card{from{left:0;top:0;width:100vw;height:100vh;border-radius:0}
to{left:var(--scene-origin-left,0);top:var(--scene-origin-top,0);width:var(--scene-origin-width,100vw);height:var(--scene-origin-height,100vh);border-radius:42rpx}
}
@keyframes environment-crossfade-out{from{opacity:1}to{opacity:0}}
@media (prefers-reduced-motion:reduce){.scene-character,.action-glow,.home-locator-focus,.scene-talk-nudge,.loading-orbit,.magic-window__clouds,.magic-window__water-shimmer,.magic-window__koi-track,.magic-window__loader{animation:none}
.scene-action-button,.scene-status-bubble{transition:none}.scene-action-button--pressed{transform:none}
.scene-exit-overlay{animation-duration:20ms}
.world-panorama-bg--previous{animation-duration:20ms}
}
.page--reduced .scene-character,.page--reduced .action-glow,.page--reduced .home-locator-focus,.page--reduced .scene-talk-nudge,.page--reduced .loading-orbit,.page--reduced .magic-window__clouds,.page--reduced .magic-window__water-shimmer,.page--reduced .magic-window__koi-track,.page--reduced .magic-window__loader{animation:none}
.page--reduced .scene-status-bubble{transition:none}
