.companion-state-tester-option{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;padding:0 15rpx;border-radius:999rpx;color:#586458;font-size:20rpx}
.companion-state-tester-option--active{background:#EEF3E5;color:#36513C;font-weight:600}
.companion-state-tester-option--missing{color:#A6AAA2;opacity:.58;pointer-events:none}
.companion-state-tester-missing{padding:3rpx 9rpx;border-radius:999rpx;background:#ECEDE9;color:#92978F;font-size:20rpx;font-weight:500}
.prototype-tester{position:fixed;z-index:88;right:28rpx;width:210rpx}
.prototype-tester-button{min-height:64rpx;display:flex;align-items:center;justify-content:center;gap:9rpx;padding:0 14rpx;box-sizing:border-box;border:1rpx solid rgba(225,229,215,.95);border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 9rpx 26rpx rgba(44,54,39,.14);color:#3F5543;font-size:21rpx;font-weight:600;backdrop-filter:blur(10rpx)}
.prototype-tester-button--open{border-color:rgba(133,157,102,.82)}
.prototype-tester-button--busy{opacity:.66}
.prototype-tester-tag{padding:5rpx 8rpx;border-radius:9rpx;background:#EDF2E3;color:#71834F;font-size:20rpx;letter-spacing:1rpx}
.prototype-tester-chevron{margin-top:-5rpx;color:#829073;font-size:22rpx}
.prototype-tester-menu{overflow:hidden;margin-top:10rpx;padding:7rpx;border:1rpx solid rgba(225,229,215,.96);border-radius:22rpx;background:rgba(255,253,247,.97);box-shadow:0 15rpx 38rpx rgba(44,54,39,.18);backdrop-filter:blur(12rpx)}
.prototype-tester-option{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;padding:0 17rpx;border-radius:999rpx;color:#586458;font-size:20rpx}
.prototype-tester-option--active{background:#EEF3E5;color:#36513C;font-weight:600}
.mood-tester{position:fixed;z-index:87;right:28rpx;width:210rpx}
.mood-tester-button{min-height:64rpx;display:flex;align-items:center;justify-content:center;gap:9rpx;padding:0 14rpx;box-sizing:border-box;border:1rpx solid rgba(225,229,215,.95);border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 9rpx 26rpx rgba(44,54,39,.14);color:#3F5543;font-size:21rpx;font-weight:600;backdrop-filter:blur(10rpx)}
.mood-tester-button--open{border-color:rgba(133,157,102,.82)}
.mood-tester-tag{padding:5rpx 8rpx;border-radius:9rpx;background:#EDF2E3;color:#71834F;font-size:20rpx;letter-spacing:1rpx}
.mood-tester-chevron{margin-top:-5rpx;color:#829073;font-size:22rpx}
.mood-tester-menu{max-height:470rpx;overflow:hidden;margin-top:10rpx;padding:7rpx;border:1rpx solid rgba(225,229,215,.96);border-radius:22rpx;background:rgba(255,253,247,.97);box-shadow:0 15rpx 38rpx rgba(44,54,39,.18);backdrop-filter:blur(12rpx)}
.mood-tester-option{min-height:58rpx;display:flex;align-items:center;justify-content:space-between;padding:0 17rpx;border-radius:999rpx;color:#586458;font-size:20rpx}
.mood-tester-option--active{background:#EEF3E5;color:#36513C;font-weight:600}
.state-layer{position:absolute;z-index:80;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;padding:80rpx;background:linear-gradient(160deg,#F7EEDC,#D9C7A8);color:#697268;font-size:24rpx;text-align:center}
.state-layer--error{background:#F6F4ED}
.state-error-title{color:#344136;font-size:32rpx;font-weight:600}
.loading-orbit{width:52rpx;height:52rpx;border:5rpx solid #D8DFC5;border-top-color:#6F8449;border-radius:50%;animation:loading-spin .8s linear infinite}
.state-action{min-width:180rpx;height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 28rpx;border-radius:999rpx;background:#002900;color:#FFF}
.state-secondary{padding:14rpx 24rpx;color:#6D766D}
.scene-stage{position:absolute;inset:0;opacity:0;transition:opacity .5s ease;pointer-events:none}
.scene-stage--entered{opacity:1;pointer-events:auto}
.world-scroll{width:100vw;height:100vh;white-space:nowrap}
.world-track{position:relative;width:300vw;height:100vh;display:flex;background:linear-gradient(160deg,#F7EEDC,#D9C7A8)}
.world-panorama-bg{position:absolute;z-index:0;left:0;top:0;width:300vw;height:100vh;display:block}
.world-panorama-bg--previous{z-index:1;pointer-events:none}
.world-panorama-bg--previous-fading{animation:environment-crossfade-out .52s ease-out both}
.world-panorama-preload{position:absolute;z-index:0;left:0;top:0;width:300vw;height:100vh;opacity:0;pointer-events:none}
.world-panel{position:relative;z-index:1;width:100vw;height:100vh;flex:0 0 100vw;overflow:hidden;background:transparent}
.daily-window-hotspot{position:absolute;z-index:7;box-sizing:border-box}
.daily-window-hotspot:active{background:rgba(255,255,255,.025)}
/* 以下四类提示的位置全部来自 post-hatch-assets.js 的母图锚点（2823×1672 像素），
   由 mapPanoramaPoints 换算成本机坐标后经 style 注入；这里只保留尺寸与外观。
   translate(-50%,-50%) 把元素中心对到锚点上。 */
.scene-character-hotspot{position:absolute;z-index:6;width:360rpx;height:440rpx;background:transparent;transform:translate(-50%,-50%)}
.action-glow{position:absolute;z-index:8;width:92rpx;height:92rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,248,181,.7),rgba(255,248,181,.12) 50%,transparent 72%);transform:translate(-50%,-50%);animation:action-breathe 2.6s ease-in-out infinite}
.action-glow--pet{pointer-events:none}
.screen-dots{position:absolute;z-index:12;left:50%;top:calc(118rpx + env(safe-area-inset-top));display:flex;gap:10rpx;transform:translateX(-50%);pointer-events:none}
.screen-dot{width:9rpx;height:9rpx;border-radius:50%;background:rgba(255,255,255,.5);box-shadow:0 2rpx 5rpx rgba(0,0,0,.14)}
.screen-dot--active{width:28rpx;border-radius:999rpx;background:#FFF}
.life-status-stack{position:fixed;z-index:84;left:24rpx;display:flex;max-width:calc(100vw - 48rpx);flex-direction:column;align-items:flex-start;gap:28rpx;pointer-events:none}
.pet-mood-anchor{max-width:100%;pointer-events:auto}
.room-clock{position:relative;z-index:18;width:176rpx;height:116rpx;display:flex;align-items:center;justify-content:flex-start;box-sizing:border-box;transform-origin:50% 50%;transition:transform .16s ease;pointer-events:auto}
.room-clock:active{transform:scale(.98)}
.clock-face{position:relative;width:112rpx;height:112rpx;box-sizing:border-box;border:5rpx solid rgba(107,86,59,.72);border-radius:50%;background:rgba(250,246,231,.93);box-shadow:0 9rpx 22rpx rgba(43,32,21,.18),inset 0 0 0 3rpx rgba(255,255,255,.66);color:#5A513F}
.clock-number{position:absolute;color:rgba(82,73,56,.75);font-size:20rpx;font-weight:600;line-height:1}
.clock-number--twelve{top:8rpx;left:50%;transform:translateX(-50%)}
.clock-number--three{top:50%;right:8rpx;transform:translateY(-50%)}
.clock-number--six{bottom:7rpx;left:50%;transform:translateX(-50%)}
.clock-number--nine{top:50%;left:8rpx;transform:translateY(-50%)}
.clock-hand{position:absolute;z-index:2;left:50%;bottom:50%;border-radius:999rpx;transform-origin:50% 100%}
.clock-hand--hour{width:5rpx;height:27rpx;margin-left:-2.5rpx;background:#4D493D}
.clock-hand--minute{width:4rpx;height:36rpx;margin-left:-2rpx;background:#4D493D}
.clock-hand--second{width:2rpx;height:39rpx;margin-left:-1rpx;background:#819A54}
.clock-pin{position:absolute;z-index:3;left:50%;top:50%;width:9rpx;height:9rpx;margin:-4.5rpx 0 0 -4.5rpx;border-radius:50%;background:#819A54;box-shadow:0 0 0 2rpx rgba(255,255,255,.85)}
.clock-digital{width:176rpx;height:92rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;border:2rpx solid rgba(107,86,59,.42);border-radius:22rpx;background:rgba(250,246,231,.93);box-shadow:0 9rpx 22rpx rgba(43,32,21,.16),inset 0 0 0 2rpx rgba(255,255,255,.55);color:#4D493D}
.clock-time{font-size:34rpx;font-weight:600;font-variant-numeric:tabular-nums;line-height:1.1;letter-spacing:1rpx}
.clock-date{margin-top:7rpx;color:rgba(82,73,56,.72);font-size:20rpx;line-height:1}
.scene-background-error{position:absolute;z-index:24;left:50%;top:calc(168rpx + env(safe-area-inset-top));padding:14rpx 22rpx;border-radius:999rpx;background:rgba(255,253,247,.92);box-shadow:0 8rpx 24rpx rgba(45,37,27,.14);color:#6F5745;font-size:20rpx;transform:translateX(-50%)}
.scene-context-entry{position:absolute;z-index:26;left:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom))}
.away-status-pill{min-width:116rpx;height:58rpx;display:flex;align-items:center;justify-content:center;padding:0 18rpx;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.48);border-radius:999rpx;background:rgba(74,82,75,.68);box-shadow:0 7rpx 18rpx rgba(34,45,36,.14);color:rgba(255,255,255,.88);font-size:21rpx;font-weight:600;letter-spacing:1rpx;-webkit-backdrop-filter:blur(8rpx);backdrop-filter:blur(8rpx)}
.scene-action-dock{position:absolute;z-index:26;right:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:16rpx}
.scene-action-button{position:relative;width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.78);border-radius:50%;background:linear-gradient(145deg,rgba(255,254,249,.97),rgba(230,235,224,.96));box-shadow:0 11rpx 25rpx rgba(34,45,36,.18),inset 0 3rpx 4rpx rgba(255,255,255,.94),inset 0 -4rpx 8rpx rgba(96,112,91,.1);transition:transform .16s ease,box-shadow .16s ease}
.scene-action-button--pressed{transform:scale(.98);box-shadow:0 5rpx 12rpx rgba(34,45,36,.15),inset 0 3rpx 6rpx rgba(96,112,91,.12)}
.scene-action-button--unavailable{width:88rpx;height:88rpx;border-color:rgba(255,255,255,.46);background:rgba(78,84,75,.62);box-shadow:0 7rpx 18rpx rgba(34,45,36,.14)}
.scene-action-icon-image{display:block;width:72rpx;height:72rpx;filter:drop-shadow(0 5rpx 5rpx rgba(57,65,50,.16))}
.scene-action-icon-image--companion{width:112rpx;height:112rpx;border-radius:50%;filter:none}
.scene-action-button--unavailable .scene-action-icon-image--companion{width:80rpx;height:80rpx;filter:grayscale(1) brightness(.78) contrast(.86);opacity:.78}
.scene-action-unavailable-badge{position:absolute;right:-12rpx;bottom:-14rpx;min-width:52rpx;padding:5rpx 8rpx;border:2rpx solid rgba(255,255,255,.9);border-radius:999rpx;background:#697267;color:#FFF;font-size:16rpx;font-weight:600;line-height:1.2;text-align:center;white-space:nowrap;box-shadow:0 4rpx 10rpx rgba(34,45,36,.16)}
.magic-window{position:fixed;z-index:360;inset:0;overflow:hidden;background:#D8C5B2;color:#FFF;animation:magic-window-enter .32s ease-out both}
.magic-window__base{position:absolute;z-index:0;inset:0;width:100%;height:100%;display:block}
.magic-window__atmosphere{position:absolute;z-index:1;inset:0;overflow:hidden;pointer-events:none}
.magic-window__clouds{position:absolute;height:auto;opacity:.62;filter:blur(.35rpx);will-change:transform}
.magic-window__clouds--near{top:8%;left:-78%;width:210%;animation:magic-window-cloud-near 34s linear infinite}
.magic-window__clouds--far{top:22%;left:-42%;width:166%;opacity:.32;transform:scale(.78);animation:magic-window-cloud-far 48s linear infinite}
.magic-window__water-shimmer{position:absolute;left:22%;right:9%;top:52%;height:12%;border-radius:50%;opacity:.35;background:repeating-linear-gradient(174deg,transparent 0,transparent 12rpx,rgba(255,236,191,.42) 15rpx,transparent 19rpx);filter:blur(2rpx);transform:skewX(-12deg);animation:magic-window-water 5.2s ease-in-out infinite}
.magic-window__koi-track{position:absolute;z-index:5;left:3%;bottom:12%;width:48%;height:260rpx;animation:magic-window-koi-walk 8.5s ease-in-out infinite alternate;transform-origin:50% 100%}
.magic-window__koi{position:absolute;z-index:2;left:0;bottom:18rpx;width:100%;height:auto;filter:drop-shadow(0 15rpx 12rpx rgba(48,30,18,.26));transform-origin:50% 88%}
.magic-window__koi-shadow{position:absolute;z-index:1;left:20%;right:13%;bottom:14rpx;height:24rpx;border-radius:50%;background:rgba(24,28,28,.25);filter:blur(8rpx);transform-origin:center}
.magic-window__koi-ripple{position:absolute;z-index:0;left:49%;bottom:5rpx;width:70%;height:28rpx;border:3rpx solid rgba(255,238,195,.55);border-radius:50%;opacity:0;transform:translateX(-50%) scale(.4)}
.magic-window__koi-ripple--two{width:92%;animation-delay:.15s!important}
.magic-window__koi-track--reacting .magic-window__koi{animation:magic-window-koi-jump 1s cubic-bezier(.22,.7,.35,1) both}
.magic-window__koi-track--reacting .magic-window__koi-shadow{animation:magic-window-koi-shadow 1s ease-out both}
.magic-window__koi-track--reacting .magic-window__koi-ripple{animation:magic-window-koi-ripple .85s ease-out both}
.magic-window__hint{position:absolute;z-index:6;left:50%;bottom:calc(42rpx + env(safe-area-inset-bottom));padding:10rpx 19rpx;border:1rpx solid rgba(255,255,255,.38);border-radius:999rpx;background:rgba(27,38,36,.34);box-shadow:0 8rpx 24rpx rgba(20,28,27,.13);font-size:20rpx;letter-spacing:3rpx;transform:translateX(-50%);backdrop-filter:blur(8rpx)}
.magic-window__topbar{position:absolute;z-index:12;left:24rpx;right:24rpx;top:0;display:flex;align-items:flex-end;justify-content:space-between;box-sizing:border-box;pointer-events:none}
.magic-window__back,.magic-window__meta{margin-top:16rpx;pointer-events:auto;backdrop-filter:blur(12rpx)}
.magic-window__back{width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(25,35,31,.46);box-shadow:0 8rpx 22rpx rgba(13,22,20,.14)}
.magic-window__back:active{transform:scale(.98)}
.magic-window__back-icon{width:19rpx;height:19rpx;margin-left:7rpx;border-left:4rpx solid #FFF;border-bottom:4rpx solid #FFF;transform:rotate(45deg)}
.magic-window__meta{padding:14rpx 22rpx;border-radius:999rpx;background:rgba(255,253,247,.84);color:#415047;font-size:20rpx;letter-spacing:1rpx}
.magic-window__state{position:absolute;z-index:10;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:90rpx;box-sizing:border-box;background:linear-gradient(165deg,rgba(231,236,229,.96),rgba(185,203,194,.96));color:#536158;font-size:23rpx;text-align:center}
.magic-window__state--error{background:linear-gradient(165deg,#EEF1EA,#CCD8D0)}
.magic-window__state-title{color:#35443A;font-size:31rpx;font-weight:600}
.magic-window__loader{width:50rpx;height:50rpx;border:5rpx solid rgba(255,255,255,.62);border-top-color:#667E6E;border-radius:50%;animation:loading-spin .8s linear infinite}
.magic-window__retry{min-width:180rpx;height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 28rpx;border-radius:999rpx;background:#002900;color:#FFF;font-size:22rpx}
.scene-exit-backdrop{position:fixed;z-index:90;inset:0;background:#FAFAF8}
.scene-exit-overlay{position:fixed;z-index:91;left:0;top:0;width:100vw;height:100vh;overflow:hidden;background:#DCE5CE;animation:scene-collapse-to-card var(--scene-exit-duration,560ms) cubic-bezier(.22,.61,.36,1) forwards}
.scene-exit-image{display:block;width:100%;height:100%}
@keyframes loading-spin{to{transform:rotate(360deg)}
}
@keyframes action-breathe{0%,100%{opacity:.34;transform:translate(-50%,-50%) scale(.88)}
50%{opacity:.76;transform:translate(-50%,-50%) scale(1.05)}
}
@keyframes home-locator-pulse{0%{opacity:0;transform:translate(-50%,-50%) scale(.7)}45%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.12)}}
@keyframes talk-nudge-in{from{opacity:0;transform:translate(-50%,calc(-50% + 10rpx)) scale(.86)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
@keyframes magic-window-enter{from{opacity:0;transform:scale(1.018)}to{opacity:1;transform:scale(1)}}
@keyframes magic-window-cloud-near{from{transform:translateX(-2%)}to{transform:translateX(36%)}}
@keyframes magic-window-cloud-far{from{transform:translateX(5%) scale(.78)}to{transform:translateX(-30%) scale(.78)}}
@keyframes magic-window-water{0%,100%{opacity:.2;transform:translateX(-7rpx) skewX(-12deg) scaleX(.96)}50%{opacity:.48;transform:translateX(10rpx) skewX(-12deg) scaleX(1.04)}}
@keyframes magic-window-koi-walk{0%{transform:translateX(-4rpx) rotate(-1deg)}100%{transform:translateX(90vw) rotate(1deg)}}
@keyframes magic-window-koi-jump{0%,100%{transform:translateY(0) rotate(0) scale(1)}20%{transform:translateY(8rpx) rotate(-3deg) scale(1.03,.96)}48%{transform:translateY(-118rpx) rotate(8deg) scale(.98,1.04)}68%{transform:translateY(-54rpx) rotate(-5deg) scale(1.01)}84%{transform:translateY(5rpx) rotate(2deg) scale(1.04,.94)}}
@keyframes magic-window-koi-shadow{0%,100%{opacity:1;transform:scale(1)}48%{opacity:.22;transform:scale(.55)}84%{opacity:.7;transform:scale(1.12)}}
@keyframes magic-window-koi-ripple{0%{opacity:.72;transform:translateX(-50%) scale(.35)}100%{opacity:0;transform:translateX(-50%) scale(1.4)}}
@keyframes scene-collapse-to-card{from{left:0;top:0;width:100vw;height:100vh;border-radius:0}
to{left:var(--scene-origin-left,0);top:var(--scene-origin-top,0);width:var(--scene-origin-width,100vw);height:var(--scene-origin-height,100vh);border-radius:42rpx}
}
@keyframes environment-crossfade-out{from{opacity:1}to{opacity:0}}
@media (prefers-reduced-motion:reduce){.action-glow,.loading-orbit,.magic-window__clouds,.magic-window__water-shimmer,.magic-window__koi-track,.magic-window__loader{animation:none}
.scene-stage,.scene-action-button{transition:none}.scene-action-button--pressed{transform:none}
.scene-exit-overlay{animation-duration:20ms}
.world-panorama-bg--previous{animation-duration:20ms}
}
.page--reduced .action-glow,.page--reduced .loading-orbit,.page--reduced .magic-window__clouds,.page--reduced .magic-window__water-shimmer,.page--reduced .magic-window__koi-track,.page--reduced .magic-window__loader{animation:none}
.page--reduced .scene-stage{transition:none}
