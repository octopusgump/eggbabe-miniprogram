.page{position:relative;width:100vw;height:100vh;overflow:hidden;background:#EEE8DB;color:#28332B}
.topbar{position:absolute;z-index:30;left:24rpx;right:24rpx;top:0;display:flex;align-items:center;justify-content:space-between;pointer-events:none}
.round-btn,.state-pill,.demo-scene-badge{margin-top:16rpx;pointer-events:auto;backdrop-filter:blur(12rpx)}
.round-btn{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(33,42,34,.46)}
.back-icon{width:18rpx;height:18rpx;margin-left:6rpx;border-left:4rpx solid #FFF;border-bottom:4rpx solid #FFF;transform:rotate(45deg)}
.state-pill{max-width:360rpx;padding:14rpx 24rpx;border-radius:999rpx;background:rgba(255,253,247,.88);color:#435045;font-size:20rpx}
.demo-scene-badge{padding:8rpx 14rpx;border-radius:999rpx;background:rgba(238,242,227,.9);color:#53643A;font-size:17rpx;font-weight:600;letter-spacing:1rpx}
.state-layer{position:absolute;z-index:10;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;padding:80rpx;color:#697268;font-size:24rpx;text-align:center}
.state-layer--error{background:#F6F4ED}
.state-error-title{color:#344136;font-size:32rpx;font-weight:600}
.loading-orbit{width:52rpx;height:52rpx;border:5rpx solid #D8DFC5;border-top-color:#6F8449;border-radius:50%;animation:loading-spin .8s linear infinite}
.state-action{min-width:180rpx;padding:18rpx 28rpx;border-radius:999rpx;background:#3F5A47;color:#FFF}
.state-secondary{padding:14rpx 24rpx;color:#6D766D}
.world-scroll{width:100vw;height:100vh;white-space:nowrap}
.world-track{width:300vw;height:100vh;display:flex}
.world-panel{position:relative;width:100vw;height:100vh;flex:0 0 100vw;overflow:hidden;background:linear-gradient(160deg,#F7EEDC,#D9C7A8)}
.panel-bg{position:absolute;inset:0;width:100%;height:100%}
.panel-bg--panorama{width:300%;max-width:none}
.panel-bg--left{left:0;object-position:left center}
.panel-bg--center{left:-100%;object-position:center center}
.panel-bg--right{left:-200%;object-position:right center}
.panel-tone{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(62,44,28,.18))}
.bed-placeholder{position:absolute;left:9%;bottom:21%;width:60%;height:25%;border-radius:40rpx 40rpx 18rpx 18rpx;background:linear-gradient(145deg,#DDBF8D,#C99A62);box-shadow:0 22rpx 50rpx rgba(75,48,25,.18)}
.bed-pillow{position:absolute;left:10%;top:12%;width:34%;height:35%;border-radius:42%;background:#F4EEE2}
.bed-blanket{position:absolute;left:6%;right:5%;bottom:5%;height:58%;border-radius:42rpx 42rpx 16rpx 16rpx;background:linear-gradient(145deg,#DDE8EE,#B8CCD7)}
.lamp-placeholder{position:absolute;left:73%;bottom:29%;width:12rpx;height:100rpx;border-radius:999rpx;background:#8D6A45;box-shadow:0 -58rpx 0 22rpx #F0D7A4,0 -58rpx 55rpx 30rpx rgba(255,226,153,.48)}
.decor-placeholder{position:absolute;left:10%;right:10%;bottom:22%;height:22%;display:flex;align-items:center;justify-content:center;padding:28rpx;border:2rpx dashed rgba(69,91,67,.28);border-radius:32rpx;background:rgba(251,249,239,.62);color:#7A8478;font-size:22rpx;white-space:normal;text-align:center}
.decor-entry{position:absolute;right:30rpx;bottom:calc(180rpx + env(safe-area-inset-bottom));padding:16rpx 22rpx;border-radius:999rpx;background:rgba(63,90,71,.9);color:#FFF;font-size:20rpx}
.scene-character{position:absolute;z-index:5;filter:drop-shadow(0 16rpx 18rpx rgba(67,45,26,.2));animation:character-breathe 4.2s ease-in-out infinite}
.scene-character--living{left:29%;bottom:24%}
.scene-character--desk{left:50%;bottom:25%;transform:translateX(-50%)}
.scene-character--window{right:22%;bottom:27%}
.action-glow{position:absolute;z-index:8;width:92rpx;height:92rpx;border-radius:50%;background:radial-gradient(circle,rgba(255,248,181,.7),rgba(255,248,181,.12) 50%,transparent 72%);animation:action-breathe 2.6s ease-in-out infinite}
.action-glow--lamp{left:69%;bottom:34%}
.action-glow--blanket{left:35%;bottom:31%}
.action-glow--pet{left:44%;bottom:34%}
.action-glow--cup{right:15%;bottom:31%}
.action-glow--paper{left:54%;bottom:19%}
.action-glow--screen{left:28%;bottom:28%}
.action-glow--window{right:18%;top:24%}
.away-note{position:absolute;z-index:6;left:10%;right:10%;top:34%;padding:30rpx;border-radius:30rpx;background:rgba(255,253,247,.9);box-shadow:0 18rpx 50rpx rgba(45,37,27,.12);white-space:normal}
.away-kicker,.away-line{display:block}
.away-kicker{color:#7C8D58;font-size:19rpx;letter-spacing:2rpx}
.away-line{margin-top:14rpx;color:#344036;font-size:28rpx;line-height:1.65}
.screen-dots{position:absolute;z-index:12;left:50%;top:calc(118rpx + env(safe-area-inset-top));display:flex;gap:10rpx;transform:translateX(-50%)}
.screen-dot{width:9rpx;height:9rpx;border-radius:50%;background:rgba(255,255,255,.5);box-shadow:0 2rpx 5rpx rgba(0,0,0,.14)}
.screen-dot--active{width:28rpx;border-radius:999rpx;background:#FFF}
.scene-copy{position:absolute;z-index:12;left:34rpx;right:34rpx;bottom:calc(164rpx + env(safe-area-inset-bottom));pointer-events:none;text-shadow:0 2rpx 9rpx rgba(0,0,0,.28)}
.scene-kicker,.scene-line{display:block;color:#FFF}
.scene-kicker{font-size:20rpx;letter-spacing:2rpx}
.scene-line{margin-top:10rpx;font-size:28rpx;line-height:1.55}
.feedback-bubble{position:absolute;z-index:22;left:50%;top:24%;max-width:520rpx;padding:20rpx 28rpx;border-radius:28rpx 28rpx 28rpx 8rpx;background:rgba(255,255,255,.80);box-shadow:0 12rpx 36rpx rgba(0,41,0,.12);color:#3D4930;font-size:24rpx;line-height:1.5;transform:translateX(-50%);animation:bubble-in .22s ease-out}
.scene-composer{position:absolute;z-index:20;left:28rpx;right:28rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));padding:14rpx;border-radius:30rpx;background:rgba(255,255,255,.92);box-shadow:0 12rpx 42rpx rgba(36,45,37,.15);backdrop-filter:blur(14rpx)}
.composer-row{display:flex;align-items:center;gap:12rpx}
.composer-input{height:70rpx;flex:1;padding:0 24rpx;border-radius:999rpx;background:#F5F6F0;color:#28332B;font-size:24rpx}
.composer-send{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#3F5A47;color:#FFF;font-size:22rpx}
.composer-send--busy{opacity:.64}
.inline-reply,.composer-error{display:block;padding:4rpx 12rpx 12rpx;font-size:21rpx;line-height:1.5}
.inline-reply{color:#435B43}
.composer-error{color:#B34A43}
.letter-sent{height:70rpx;display:flex;align-items:center;justify-content:center;color:#60705B;font-size:23rpx}
.memory-rail{position:absolute;z-index:18;right:22rpx;top:calc(142rpx + env(safe-area-inset-top));display:flex;flex-direction:column;gap:12rpx}
.memory-rail view{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,253,247,.85);box-shadow:0 8rpx 24rpx rgba(35,43,35,.12);color:#52624E;font-size:18rpx}
.magic-window{position:absolute;z-index:60;inset:0;overflow:hidden;background:linear-gradient(165deg,#DCEADB,#A8C5C2)}
.magic-window-image{position:absolute;inset:0;width:100%;height:100%}
.magic-window-placeholder{position:absolute;inset:0;background:radial-gradient(circle at 50% 35%,rgba(255,247,180,.8),transparent 22%),linear-gradient(165deg,#CFE1DD,#8FB4B5)}
.magic-window-glow{position:absolute;inset:0;background:radial-gradient(circle,transparent 35%,rgba(255,247,205,.22) 68%,rgba(255,246,191,.5));animation:magic-glow 3.8s ease-in-out infinite}
.magic-back{position:absolute;left:28rpx;top:calc(24rpx + env(safe-area-inset-top));padding:16rpx 24rpx;border-radius:999rpx;background:rgba(255,253,247,.86);color:#425044;font-size:21rpx}
.magic-line{position:absolute;left:34rpx;right:34rpx;bottom:calc(42rpx + env(safe-area-inset-bottom));color:#FFF;font-size:30rpx;text-align:center;text-shadow:0 3rpx 12rpx rgba(0,0,0,.35)}
.scene-exit-backdrop{position:fixed;z-index:90;inset:0;background:#FAFAF8}
.scene-exit-overlay{position:fixed;z-index:91;left:0;top:0;width:100vw;height:100vh;overflow:hidden;background:#DCE5CE;animation:scene-collapse-to-card var(--scene-exit-duration,560ms) cubic-bezier(.22,.61,.36,1) forwards}
.scene-exit-image{display:block;width:100%;height:100%}
@keyframes loading-spin{to{transform:rotate(360deg)}
}
@keyframes character-breathe{0%,100%{transform:translateY(0)}
50%{transform:translateY(4rpx) scale(1.01,.985)}
}
.scene-character--desk{animation-name:character-breathe-desk}
@keyframes character-breathe-desk{0%,100%{transform:translateX(-50%) translateY(0)}
50%{transform:translateX(-50%) translateY(4rpx) scale(1.01,.985)}
}
@keyframes action-breathe{0%,100%{opacity:.34;transform:scale(.88)}
50%{opacity:.76;transform:scale(1.05)}
}
@keyframes bubble-in{from{opacity:0;transform:translate(-50%,8rpx)}
to{opacity:1;transform:translate(-50%,0)}
}
@keyframes magic-glow{0%,100%{opacity:.6}
50%{opacity:1}
}
@keyframes scene-collapse-to-card{from{left:0;top:0;width:100vw;height:100vh;border-radius:0}
to{left:var(--scene-origin-left,0);top:var(--scene-origin-top,0);width:var(--scene-origin-width,100vw);height:var(--scene-origin-height,100vh);border-radius:42rpx}
}
@media (prefers-reduced-motion:reduce){.scene-character,.action-glow,.loading-orbit,.magic-window-glow{animation:none}
.scene-exit-overlay{animation-duration:20ms}
}

/* Tokyo magic-window layered prototype. Background, clouds, character and feedback remain independent. */
.magic-window-entry{position:fixed;z-index:340;right:11vw;top:38vh;width:92rpx;height:92rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,rgba(255,244,184,.82) 0,rgba(255,239,154,.26) 40%,rgba(255,239,154,0) 72%);animation:magic-window-entry-breathe 3.2s ease-in-out infinite}
.magic-window-entry__core{width:20rpx;height:20rpx;border-radius:50%;background:rgba(255,252,218,.94);box-shadow:0 0 18rpx 8rpx rgba(255,240,153,.5)}
.magic-window--tokyo{position:fixed;z-index:360;inset:0;background:#D9DDE1;isolation:isolate}
.magic-window--tokyo .magic-window-image{z-index:1;display:block}
.magic-window-clouds{position:absolute;z-index:2;left:0;right:0;top:4vh;height:35vh;overflow:hidden;pointer-events:none;opacity:.52}
.magic-window-cloud-track{position:absolute;left:-20vw;top:0;width:300vw;height:100%;display:flex;animation:magic-window-cloud-drift 48s linear infinite;will-change:transform}
.magic-window-cloud-band{display:block;width:150vw;height:100%;flex:0 0 150vw}
.magic-window-water-shimmer{position:absolute;z-index:3;left:-12%;right:-12%;top:52%;bottom:-8%;pointer-events:none;opacity:.2;background:repeating-linear-gradient(104deg,transparent 0,transparent 52rpx,rgba(255,226,172,.24) 68rpx,transparent 84rpx);background-size:160% 100%;mix-blend-mode:screen;animation:magic-window-shimmer 7.5s ease-in-out infinite}
.magic-window-koi-track{position:absolute;z-index:4;left:0;bottom:2vh;width:68vw;height:36vh;animation:magic-koi-travel 14s linear infinite;will-change:transform}
.magic-window-koi{position:absolute;z-index:3;inset:0;width:100%;height:100%;display:block;filter:drop-shadow(0 12rpx 13rpx rgba(54,39,24,.19));transform-origin:50% 72%;animation:magic-koi-step .9s ease-in-out infinite}
.magic-window-koi--reacting{animation:magic-koi-hop .72s cubic-bezier(.2,.72,.3,1)}
.magic-window-koi-shadow{position:absolute;z-index:1;left:39%;bottom:17%;width:26%;height:8%;border-radius:50%;background:rgba(45,40,33,.22);filter:blur(5rpx);animation:magic-koi-shadow-step .9s ease-in-out infinite}
.magic-window-koi-ripple{position:absolute;z-index:2;left:42%;bottom:15%;width:22%;height:8%;border:2rpx solid rgba(255,236,196,.62);border-radius:50%;opacity:0;animation:magic-koi-ripple 1.8s ease-out infinite}
.magic-window-koi-ripple--two{animation-delay:.9s}
.magic-window-topbar{position:absolute;z-index:11;left:24rpx;right:24rpx;top:0;display:flex;align-items:flex-start;justify-content:space-between;pointer-events:none}
.magic-window-topbar .magic-back,.magic-window-place{margin-top:16rpx;pointer-events:auto;backdrop-filter:blur(12rpx);-webkit-backdrop-filter:blur(12rpx)}
.magic-window-topbar .magic-back{position:relative;left:auto;top:auto;width:76rpx;height:76rpx;padding:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(25,35,31,.46);box-sizing:border-box}
.magic-back-icon{width:19rpx;height:19rpx;margin-left:7rpx;border-left:4rpx solid #FFF;border-bottom:4rpx solid #FFF;transform:rotate(45deg)}
.magic-window-place{padding:14rpx 22rpx;border-radius:999rpx;background:rgba(255,253,247,.84);color:#415047;font-size:20rpx;letter-spacing:1rpx}
.magic-window-state{position:absolute;z-index:12;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;padding:90rpx;box-sizing:border-box;background:linear-gradient(165deg,#E7ECE5,#B9CBC2);color:#536158;font-size:23rpx;line-height:1.55;text-align:center}
.magic-window-state--error{background:linear-gradient(165deg,#EEF1EA,#CCD8D0)}
.magic-window-state__title{color:#35443A;font-size:31rpx;font-weight:600}
.magic-window-retry{min-width:180rpx;margin-top:8rpx;padding:18rpx 28rpx;border-radius:999rpx;background:#3F5A47;color:#FFF;font-size:22rpx}
.magic-window--reduced .magic-window-cloud-track,.magic-window--reduced .magic-window-water-shimmer,.magic-window--reduced .magic-window-koi,.magic-window--reduced .magic-window-koi-shadow,.magic-window--reduced .magic-window-koi-ripple{animation:none}
.magic-window--reduced .magic-window-cloud-track{transform:translateX(-55vw)}
.magic-window--reduced .magic-window-koi-track{animation:none;transform:translateX(22vw)}
.magic-window--reduced .magic-window-koi-ripple{opacity:.34;transform:scale(.72)}
@keyframes magic-window-entry-breathe{0%,100%{opacity:.48;transform:scale(.84)}50%{opacity:1;transform:scale(1.08)}}
@keyframes magic-window-cloud-drift{from{transform:translateX(0)}to{transform:translateX(-150vw)}}
@keyframes magic-window-shimmer{0%,100%{opacity:.12;background-position:0 0}50%{opacity:.24;background-position:32% 0}}
@keyframes magic-koi-travel{from{transform:translateX(96vw)}to{transform:translateX(-70vw)}}
@keyframes magic-koi-step{0%,100%{transform:translateY(0) rotate(-.4deg)}50%{transform:translateY(-7rpx) rotate(.7deg)}}
@keyframes magic-koi-hop{0%,100%{transform:translateY(0) rotate(0)}42%{transform:translateY(-34rpx) rotate(-3deg)}68%{transform:translateY(-9rpx) rotate(1.4deg)}}
@keyframes magic-koi-shadow-step{0%,100%{opacity:.5;transform:scaleX(1)}50%{opacity:.3;transform:scaleX(.84)}}
@keyframes magic-koi-ripple{0%{opacity:.52;transform:scale(.28)}72%,100%{opacity:0;transform:scale(1.2)}}
@media (prefers-reduced-motion:reduce){.magic-window-entry,.magic-window-cloud-track,.magic-window-water-shimmer,.magic-window-koi-track,.magic-window-koi,.magic-window-koi-shadow,.magic-window-koi-ripple{animation:none}}
