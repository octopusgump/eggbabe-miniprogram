<view class="page">
  <nav-bar title="{{detailTitle || '留在这里的回忆'}}"></nav-bar>

  <scroll-view wx:if="{{selectedKeepsake}}" class="detail-content" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="keepsake-detail">
      <view class="keepsake-detail__art">
        <image wx:if="{{selectedKeepsake.asset && !selectedKeepsake.imageFailed}}" class="keepsake-detail__image" src="{{selectedKeepsake.asset}}" mode="aspectFit" data-scope="keepsake-detail" binderror="onMemoryImageError"></image>
        <view wx:else class="memory-asset-error"><text>纪念物图片没有加载好</text><view class="memory-asset-retry" data-scope="keepsake-detail" aria-role="button" aria-label="重新加载纪念物图片" bindtap="onRetryMemoryImage">重新加载</view></view>
      </view>
      <text wx:if="{{selectedKeepsake.sourceScene}}" class="keepsake-detail__meta">来自：{{selectedKeepsake.sourceScene}}</text>
      <view class="keepsake-memory">
        <text class="keepsake-memory__eyebrow">我还记得</text>
        <text class="keepsake-memory__story">{{selectedKeepsake.story}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:elif="{{selectedPostcard}}" class="postcard-detail-page">
    <swiper wx:if="{{selectedPostcardSlides.length}}" class="postcard-journey-swiper" current="{{selectedPostcardIndex}}" circular="{{false}}" bindchange="onPostcardSlideChange">
      <swiper-item wx:for="{{selectedPostcardSlides}}" wx:key="id">
        <scroll-view class="postcard-journey-slide" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="postcard-journey-slide__inner">
            <view class="postcard-journey-art postcard-journey-art--interactive" hover-class="postcard-journey-art--pressed" aria-role="button" aria-label="进入{{item.sceneLabel}}，{{item.actionLabel}}的旅途回放" data-index="{{index}}" bindtap="onOpenJourneyScene">
              <image wx:if="{{item.asset && !item.imageFailed}}" class="postcard-journey-image" src="{{item.asset}}" mode="aspectFit" aria-hidden="true" data-scope="postcard-slide" data-index="{{index}}" binderror="onMemoryImageError"></image>
              <view wx:else class="memory-asset-error"><text>旅途图片没有加载好</text><view class="memory-asset-retry" data-scope="postcard-slide" data-index="{{index}}" aria-role="button" aria-label="重新加载旅途图片" catchtap="onRetryMemoryImage">重新加载</view></view>
            </view>
            <text class="postcard-journey-scene">{{item.sceneLabel}}</text>
            <text class="postcard-journey-action">{{item.actionLabel}}</text>
            <text class="detail-story detail-story--postcard">{{item.line}}</text>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
    <scroll-view wx:else class="detail-content" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="postcard-detail">
        <image wx:if="{{selectedPostcard.asset && !selectedPostcard.imageFailed}}" class="postcard-detail__art" src="{{selectedPostcard.asset}}" mode="aspectFit" data-scope="postcard-detail" binderror="onMemoryImageError"></image>
        <view wx:else class="postcard-detail__art memory-asset-error"><text>明信片图片没有加载好</text><view class="memory-asset-retry" data-scope="postcard-detail" aria-role="button" aria-label="重新加载明信片图片" bindtap="onRetryMemoryImage">重新加载</view></view>
        <text wx:if="{{selectedPostcard.displayDate}}" class="detail-meta">{{selectedPostcard.displayDate}}</text>
        <text class="detail-story detail-story--postcard">{{selectedPostcard.line}}</text>
      </view>
    </scroll-view>
  </view>

  <block wx:else>
    <scroll-view class="content {{isDemo ? 'content--demo' : ''}}" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{loading}}" class="page-state"><view class="loading-orbit"></view><text>正在翻看回忆…</text></view>
      <view wx:elif="{{error}}" class="page-state"><text>{{error}}</text><view class="retry" bindtap="onRetry">重新加载</view></view>
      <block wx:elif="{{section === 'keepsakes'}}">
        <view wx:if="{{keepsakes.length}}" class="keepsake-grid">
          <view wx:for="{{keepsakes}}" wx:key="id" class="keepsake-grid-item" hover-class="keepsake-grid-item--pressed" hover-start-time="0" hover-stay-time="400" aria-role="button" aria-label="查看{{item.name}}" data-id="{{item.id}}" bindtap="onOpenKeepsake">
            <view class="keepsake-grid-art"><image wx:if="{{item.asset && !item.imageFailed}}" class="keepsake-grid-image" src="{{item.asset}}" mode="aspectFit" data-scope="keepsake-list" data-index="{{index}}" binderror="onMemoryImageError"></image><view wx:else class="memory-asset-error memory-asset-error--compact"><text>图片失败</text><view class="memory-asset-retry" data-scope="keepsake-list" data-index="{{index}}" aria-role="button" aria-label="重新加载{{item.name}}图片" catchtap="onRetryMemoryImage">重试</view></view><view class="memory-card-glare" aria-hidden="true"></view></view>
            <text class="keepsake-grid-name">{{item.name}}</text>
          </view>
        </view>
        <view wx:else class="empty-memory"><view class="empty-mark">小物</view><text class="empty-title">这里暂时安安静静的</text><text class="empty-copy">当你在场景里自然地回应 ta，一些东西会慢慢留在桌边。</text></view>
      </block>
      <block wx:elif="{{section === 'postcards'}}">
        <view wx:if="{{postcards.length}}" class="postcard-list">
          <view wx:for="{{postcards}}" wx:key="id" class="postcard-list-item" hover-class="postcard-list-item--pressed" hover-start-time="0" hover-stay-time="420" aria-role="button" aria-label="查看{{item.sceneLabel}}明信片" data-id="{{item.id}}" bindtap="onOpenPostcard">
            <view class="postcard-list-cover-frame">
              <image wx:if="{{item.asset && !item.imageFailed}}" class="postcard-list-cover" src="{{item.asset}}" mode="aspectFill" data-scope="postcard-list" data-index="{{index}}" binderror="onMemoryImageError"></image>
              <view wx:else class="postcard-list-cover memory-asset-error"><text>图片没有加载好</text><view class="memory-asset-retry" data-scope="postcard-list" data-index="{{index}}" aria-role="button" aria-label="重新加载{{item.sceneLabel}}明信片" catchtap="onRetryMemoryImage">重新加载</view></view>
              <view class="memory-card-glare" aria-hidden="true"></view>
            </view>
            <text class="postcard-list-title">{{item.sceneLabel || '远方的明信片'}}</text>
            <text wx:if="{{item.displayDate}}" class="postcard-list-date">{{item.displayDate}}</text>
          </view>
        </view>
        <view wx:else class="empty-memory"><view class="empty-mark">信</view><text class="empty-title">还没有远方的来信</text><text class="empty-copy">ta 外出时可以写一封信；下一次进入后，回信会安静地放在这里。</text></view>
      </block>
      <block wx:else>
        <view wx:if="{{cardRecommendation}}" class="recommend-card" hover-class="recommend-card--pressed" aria-role="button" bindtap="onOpenCard">
          <text class="recommend-kicker">今天想再看一次</text>
          <view class="collection-card-preview">
            <view class="collection-card-preview__header"><text class="collection-card-preview__name">{{cardPreview.name}}</text><text class="collection-card-preview__brand">eggbabe</text></view>
            <view class="collection-card-preview__art">
              <image wx:if="{{cardPreview.illustration && !cardPreview.imageFailed}}" class="collection-card-preview__image" src="{{cardPreview.illustration}}" mode="aspectFit" data-scope="card-preview" binderror="onMemoryImageError"></image>
              <view wx:else class="memory-asset-error"><text>收藏卡插画没有加载好</text><view class="memory-asset-retry" data-scope="card-preview" aria-role="button" aria-label="重新加载收藏卡插画" catchtap="onRetryMemoryImage">重新加载</view></view>
            </view>
            <text wx:if="{{cardPreview.style}}" class="collection-card-preview__style">{{cardPreview.style}}</text>
          </view>
          <text class="recommend-line">{{cardRecommendation.line}}</text><text class="recommend-open">查看收藏卡</text>
        </view>
        <view wx:else class="empty-memory"><view class="empty-mark">卡</view><text class="empty-title">收藏卡留在这里</text><text class="empty-copy">完成破壳承接后，这枚实体蛋唯一的收藏卡会保存在账号里。</text></view>
      </block>
    </scroll-view>
    <view wx:if="{{isDemo && !loading}}" class="memory-preview-switch" hover-class="memory-preview-switch--pressed" aria-role="button" aria-label="切换回忆页面预览" bindtap="onCycleMemoryPreview">
      <view class="memory-preview-switch__dots" aria-hidden="true">
        <view class="memory-preview-switch__dot {{demoPreviewIndex >= 1 ? 'memory-preview-switch__dot--active' : ''}}"></view>
        <view class="memory-preview-switch__dot {{demoPreviewIndex >= 2 ? 'memory-preview-switch__dot--active' : ''}}"></view>
        <view class="memory-preview-switch__dot {{demoPreviewIndex >= 2 ? 'memory-preview-switch__dot--active' : ''}}"></view>
      </view>
    </view>
  </block>
</view>
