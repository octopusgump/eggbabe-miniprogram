.page{position:relative;display:flex;flex-direction:column;height:100vh;background:#FAFAF8;color:#1A1A1A}
.section-tabs{height:96rpx;display:flex;gap:0;margin:18rpx 28rpx 0;padding:0;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:999rpx;background:#FFF}
.section-tab{position:relative;height:96rpx;flex:1;display:flex;align-items:center;justify-content:center;padding:0 14rpx;border-radius:0;background:#FAFAF8;color:#5C5C5C;font-size:24rpx;line-height:1.2;text-align:center;transition:opacity .16s ease-out,background-color .16s ease-out}
.section-tab + .section-tab{border-left:1rpx solid #E5E3DF}
.section-tab--active{background:#002900;color:#FFF;font-weight:600}
.section-tab--pressed,.memory-item--pressed{opacity:.82}
.content,.detail-content{flex:1;padding:28rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.content--demo{padding-bottom:calc(186rpx + env(safe-area-inset-bottom))}
.page-state,.empty-memory{min-height:720rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;color:#5C5C5C;font-size:24rpx;text-align:center}
.loading-orbit{width:46rpx;height:46rpx;border:4rpx solid #E5E3DF;border-top-color:#002900;border-radius:50%;animation:loading-spin .8s linear infinite}
.retry{height:96rpx;display:flex;align-items:center;justify-content:center;padding:0 32rpx;border-radius:999rpx;background:#002900;color:#FFF;font-size:24rpx}
.keepsake-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28rpx 18rpx;padding:8rpx 0 24rpx}
.keepsake-grid-item{min-width:0;transition:opacity .16s ease-out,transform .16s ease-out}
.keepsake-grid-art{height:202rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:24rpx;background:radial-gradient(circle at 50% 42%,#FFFDF7 0,#F5F8ED 72%,#EEF2E5 100%);box-shadow:0 8rpx 20rpx rgba(0,41,0,.05)}
.keepsake-grid-image{width:88%;height:88%;display:block;filter:drop-shadow(0 8rpx 9rpx rgba(45,37,27,.10))}
.keepsake-grid-name{display:block;min-height:58rpx;margin-top:10rpx;overflow:hidden;color:#1A1A1A;font-size:21rpx;line-height:1.35;text-align:center}
.postcard-list{display:flex;flex-direction:column;gap:28rpx;padding:8rpx 0 24rpx}
.postcard-list-item{padding:18rpx 18rpx 20rpx;border:1rpx solid #E5E3DF;border-radius:28rpx;background:#FFF;box-shadow:0 10rpx 26rpx rgba(54,48,37,.06);transition:opacity .16s ease-out,transform .16s ease-out}
.postcard-list-cover{width:100%;height:260rpx;display:block;overflow:hidden;border-radius:20rpx}
.postcard-list-title{display:block;margin-top:18rpx;color:#1A1A1A;font-size:27rpx;font-weight:600}
.postcard-list-date{display:block;margin-top:7rpx;color:#8C8C88;font-size:20rpx}
.postcard-paper{position:relative;overflow:hidden;background:linear-gradient(145deg,#FFFDF7,#F3EBDD)}
.postcard-paper::after{position:absolute;right:-62rpx;bottom:-68rpx;width:220rpx;height:220rpx;border:2rpx solid rgba(170,148,119,.24);border-radius:50%;content:""}
.postcard-paper__stamp{position:absolute;right:28rpx;top:24rpx;width:66rpx;height:80rpx;border:5rpx double #B7A88E;background:#F5F8ED}
.postcard-paper__lines{position:absolute;left:34rpx;right:128rpx;bottom:34rpx;display:flex;flex-direction:column;gap:18rpx}
.postcard-paper__lines view{height:2rpx;background:rgba(128,108,83,.30)}
.postcard-detail-page{position:relative;flex:1;min-height:0}
.postcard-journey-swiper{width:100%;height:100%}
.postcard-journey-slide{height:100%}
.postcard-journey-slide__inner{padding:28rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.postcard-journey-art{width:100%;height:386rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:28rpx;background:#EEE9DF;box-shadow:0 14rpx 38rpx rgba(54,48,37,.08)}
.postcard-journey-art--interactive{transition:transform .16s ease,opacity .16s ease}
.postcard-journey-art--pressed{opacity:.86;transform:scale(.985)}
.postcard-journey-image{width:100%;height:100%;display:block}
.postcard-journey-scene{display:block;margin-top:28rpx;color:#8C8C88;font-size:21rpx}
.postcard-journey-action{display:block;margin-top:8rpx;color:#1A1A1A;font-size:30rpx;font-weight:600}
.keepsake-detail,.postcard-detail{padding:8rpx 0 50rpx}
.keepsake-detail__art{height:650rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:32rpx;background:radial-gradient(circle at 50% 42%,#FFFDF7 0,#F5F8ED 72%,#EEF2E5 100%);box-shadow:0 14rpx 38rpx rgba(0,41,0,.07)}
.keepsake-detail__image{width:90%;height:90%;display:block;filter:drop-shadow(0 14rpx 16rpx rgba(45,37,27,.12))}
.postcard-detail{padding-top:8rpx}
.postcard-detail__art{width:100%;height:390rpx;display:block;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:28rpx;box-shadow:0 14rpx 38rpx rgba(54,48,37,.08)}
.detail-meta{display:block;margin-top:28rpx;color:#8C8C88;font-size:21rpx}
.detail-story{display:block;margin-top:18rpx;color:#1A1A1A;font-size:27rpx;line-height:1.85}
.detail-story--postcard{margin-top:22rpx;padding:28rpx;border:1rpx solid #E5E3DF;border-radius:28rpx;background:#FFFDF7}
.empty-mark{width:104rpx;height:104rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#F5F8ED;color:#54632C;font-size:22rpx}
.empty-title{font-size:30rpx;font-weight:600;color:#1A1A1A}
.empty-copy{max-width:510rpx;color:#5C5C5C;font-size:24rpx;line-height:1.7}
.recommend-card{min-height:760rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:42rpx 34rpx;border:1rpx solid #E5E3DF;border-radius:36rpx;background:#FFF;box-shadow:0 18rpx 50rpx rgba(0,41,0,.07);text-align:center;transition:opacity .16s ease-out,transform .16s ease-out}
.recommend-card--pressed{opacity:.9;transform:scale(.99)}
.recommend-kicker{margin-bottom:28rpx;color:#8C8C88;font-size:20rpx;letter-spacing:2rpx}
.collection-card-preview{width:100%;max-width:500rpx;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:28rpx;background:#FFFDF7;box-shadow:0 14rpx 36rpx rgba(44,55,45,.10);text-align:left}
.collection-card-preview__header{min-height:78rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:18rpx 22rpx}
.collection-card-preview__name{min-width:0;overflow:hidden;color:#1A1A1A;font-size:28rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.collection-card-preview__brand{flex:none;color:#8C8C88;font-size:18rpx;letter-spacing:2rpx}
.collection-card-preview__art{height:330rpx;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,#FFFBEF,#F5F8ED)}
.collection-card-preview__image{width:100%;height:100%;display:block}
.collection-card-preview__style{display:block;padding:18rpx 22rpx 20rpx;color:#5C5C5C;font-size:20rpx;text-align:center}
.recommend-line{max-width:520rpx;margin-top:28rpx;color:#5C5C5C;font-size:24rpx;line-height:1.7}
.recommend-open{height:96rpx;display:flex;align-items:center;justify-content:center;margin-top:30rpx;padding:0 34rpx;border-radius:999rpx;background:#002900;color:#FFF;font-size:24rpx;font-weight:600}
.memory-preview-switch{position:fixed;z-index:30;right:28rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #CFCBC4;border-radius:50%;background:rgba(255,255,255,.94);box-shadow:0 14rpx 34rpx rgba(0,41,0,.14);backdrop-filter:blur(10rpx);transition:opacity .16s ease-out,transform .16s ease-out}
.memory-preview-switch--pressed{opacity:.86;transform:scale(.96)}
.memory-preview-switch__dots{width:58rpx;display:flex;align-items:center;justify-content:space-between}
.memory-preview-switch__dot{width:14rpx;height:14rpx;border:2rpx solid #002900;border-radius:50%;background:#FFF}
.memory-preview-switch__dot--active{background:#002900}
@keyframes loading-spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.loading-orbit{animation:none}.section-tab,.keepsake-grid-item,.postcard-list-item,.recommend-card,.memory-preview-switch{transition:none}}
