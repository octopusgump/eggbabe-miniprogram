<view class="page">
  <nav-bar title="我的" show-back="{{false}}"></nav-bar>

  <view class="content">

    <view class="user-card" hover-class="user-card--pressed" bindtap="onTapUserCard">
      <egg-avatar size="{{56}}" gradient-from="#9DB65B" gradient-to="#EDE78E"></egg-avatar>
      <view class="user-info">
        <text class="user-name">{{userName}}</text>
        <text class="user-sub">{{isDemo ? '独立演示数据，不影响正式账户' : eggCount + ' 只蛋宝宝'}}</text>
      </view>
      <view wx:if="{{!isDemo}}" class="chevron"></view>
    </view>

    <view wx:if="{{isDemo}}" class="demo-note">展会模式只开放场景与卡册体验，激活码、资料、设置和账户功能已隐藏。</view>

    <view class="menu-panel">
      <list-row label="我的卡册" bind:rowtap="onNavAlbum"></list-row>
      <list-row wx:if="{{!isDemo}}" label="我的激活码" bind:rowtap="onNavCodes"></list-row>
      <list-row wx:if="{{!isDemo}}" label="系统设置" bind:rowtap="onNavSettings"></list-row>
      <list-row wx:if="{{!isDemo}}" label="账号" bind:rowtap="onNavAccount"></list-row>
      <list-row label="隐私协议" bind:rowtap="onNavPrivacy"></list-row>
      <list-row label="帮助中心" show-border="{{false}}" bind:rowtap="onNavHelp"></list-row>
    </view>

  </view>
</view>
