.page{height:100vh;display:flex;flex-direction:column;background:#FAFAF8}.content{flex:1;padding:54rpx 40rpx;box-sizing:border-box}.state,.document-card{padding:38rpx 32rpx;border:1rpx solid #E5E3DF;border-radius:30rpx;background:#FFF;color:#5C5C5C}.state{text-align:center;font-size:25rpx}.document-title,.meta,.error{display:block}.document-title{color:#1A1A1A;font-size:34rpx;font-weight:600}.meta{margin-top:18rpx;font-size:24rpx}.error{margin-top:30rpx;color:#C33F36;font-size:24rpx;line-height:1.55}.action{min-height:96rpx;margin-top:34rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#002900;color:#FFF;font-size:28rpx;font-weight:600}
