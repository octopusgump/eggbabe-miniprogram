<view class="page">
  <nav-bar title="个人信息"></nav-bar>
  <view class="system-notice-anchor">
    <inline-notice
      text="{{systemNoticeText}}"
      tone="{{systemNoticeTone}}"
      visible="{{systemNoticeVisible}}"
    ></inline-notice>
  </view>
  <scroll-view scroll-y class="content">
    <view class="avatar-section">
      <button class="avatar-btn" hover-class="button-press" aria-label="选择账号头像" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty"></view>
      </button>
      <view class="nickname-row" aria-role="button" aria-label="修改账号昵称，当前{{nickname}}" bindtap="onEditNickname"><text class="nickname-text">{{nickname}}</text><view class="chevron"></view></view>
      <text class="user-id">ID：{{publicId}}</text>
    </view>
    <card tint="tint-yellow" ext-class="hint-card"><text class="hint-text">头像和昵称只用于账号与陪伴页面展示，不用于建立兴趣或成长画像。</text></card>
  </scroll-view>
</view>
