<view class="page">
  <nav-bar title="个人信息"></nav-bar>
  <scroll-view scroll-y class="content">
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty"></view>
      </button>
      <view class="nickname-row" bindtap="onEditNickname"><text class="nickname-text">{{nickname}}</text><view class="chevron"></view></view>
      <text class="user-id">ID：{{publicId}}</text>
    </view>

    <view class="field-panel">
      <list-row label="性别" value="{{gender}}" bind:rowtap="onEditGender"></list-row>
      <picker mode="date" value="{{birthday}}" end="{{today}}" disabled="{{birthdayLocked}}" bindchange="onBirthdayChange">
        <list-row label="生日" value="{{birthday}}"></list-row>
      </picker>
      <list-row label="星座" value="{{zodiac}}" show-chevron="{{false}}"></list-row>
      <list-row label="常驻城市" value="{{city}}" bind:rowtap="onEditCity"></list-row>
      <view class="form-row">
        <text class="form-label">MBTI</text>
        <input class="mbti-input" value="{{mbtiDraft}}" maxlength="4" placeholder="请输入，如 INFP" confirm-type="done" bindinput="onMbtiInput" bindblur="onMbtiBlur" bindconfirm="onMbtiBlur" />
      </view>
    </view>

    <card tint="tint-yellow" ext-class="hint-card"><text class="hint-text">性别和生日设置后不可修改，请确认后再保存。</text></card>
  </scroll-view>
</view>
