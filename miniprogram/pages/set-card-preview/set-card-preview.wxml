<view class="page">
  <nav-bar title="完整卡面预览"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view class="demo-note">按 H5 规格还原 · 展会预览</view>
    <view wx:if="{{current}}" class="preview-heading">
      <view><text class="heading-kicker">{{current.setName}}</text><text class="heading-title">{{current.cardTitle}}</text></view>
    </view>

    <view wx:if="{{current}}" class="preview-card birth-card">
      <view class="card-title-section">
        <view class="card-avatar"><pet-avatar pet-type="{{current.prototype}}" size="{{40}}"></pet-avatar></view>
        <view class="title-copy"><text class="card-name">{{current.name}}</text><text class="prototype-name">{{current.prototypeLabel}}</text><text class="collect-context">{{current.setName}} · {{current.cardTitle}}</text></view>
        <text class="collect-badge">{{current.collectorLabel}}</text>
      </view>
      <view class="card-illustration-section"><image class="hero-image hero-figure" src="{{current.image}}" mode="aspectFill"></image></view>
      <view class="card-data card-data-section">
        <view class="stat-grid">
          <view class="stat-pair"><view><text>生日</text><text>{{current.birthdayLabel}}</text></view><view><text>星座</text><text>{{current.constellationLabel}}</text></view></view>
          <view class="stat-pair"><view><text>性别</text><text>{{current.genderSymbol}}</text></view><view><text>血型</text><text>{{current.bloodType}} 型</text></view></view>
          <view class="stat-mbti"><text>MBTI</text><text>{{current.mbti}}</text></view>
        </view>
        <text class="card-signature">“{{current.signature}}”</text>
      </view>
    </view>

    <view class="pager"><button class="pager-button" bindtap="onPrevious"><text class="button-label">上一张</text></button><button class="pager-button pager-button--primary" bindtap="onNext"><text class="button-label">下一张</text></button></view>
    <button class="album-button" bindtap="onOpenAlbum"><text class="button-label">返回我的收藏卡</text></button>
    <view class="safe-space"></view>
  </scroll-view>
</view>
