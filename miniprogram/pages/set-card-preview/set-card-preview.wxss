.page { height: 100vh; overflow: hidden; background: #F1F0EA; }
.content { height: calc(100vh - 180rpx); padding: 22rpx 36rpx 0; box-sizing: border-box; }
.demo-note { width: fit-content; margin: 0 auto 22rpx; padding: 10rpx 18rpx; border-radius: 999rpx; background: #FFF0C8; color: #69531D; font-size: 19rpx; letter-spacing: 1rpx; }
.preview-heading { width: 650rpx; margin: 0 auto 18rpx; }
.heading-kicker { display: block; font-size: 19rpx; color: #7A7C74; }
.heading-title { display: block; margin-top: 6rpx; font-size: 30rpx; font-weight: 600; color: #26372C; }
.preview-card { width: 675rpx; height: 1200rpx; margin: 0 auto; overflow: hidden; border: 16rpx solid rgba(255,255,255,.92); border-radius: 56rpx; box-sizing: border-box; background: #FFFDF7; box-shadow: 0 40rpx 120rpx rgba(25,34,27,.18); }
.card-hero { position: relative; height: 70%; overflow: hidden; background: #F7F3EA; }
.hero-image, .hero-depth { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-figure { z-index: 3; object-position: center; }
.hero-depth { z-index: 4; background: linear-gradient(to bottom, rgba(45,51,39,.18), transparent 22%, transparent 78%, rgba(45,51,39,.12)); }
.brand-lockup { position: absolute; z-index: 5; left: 44rpx; top: 44rpx; color: #FFF; }
.brand-name { display: block; font-size: 38rpx; font-weight: 600; line-height: 1; letter-spacing: .01em; }
.brand-type { display: block; margin-top: 6rpx; font-size: 18rpx; letter-spacing: .18em; color: rgba(255,255,255,.72); }
.collect-badge { position: absolute; z-index: 5; right: 40rpx; top: 44rpx; min-width: 104rpx; padding: 14rpx 20rpx; border-radius: 999rpx; box-sizing: border-box; background: rgba(255,255,255,.9); color: #263229; text-align: center; font-size: 24rpx; font-weight: 600; }
.card-data { height: 30%; min-height: 0; display: flex; flex-direction: column; padding: 18rpx 28rpx; box-sizing: border-box; background: #FFFDF7; }
.card-name { display: block; margin-left: 6rpx; font-size: 42rpx; line-height: 1.1; font-weight: 600; color: #172018; }
.stat-grid { overflow: hidden; margin-top: 14rpx; border: 3rpx solid #94AB61; border-radius: 24rpx; }
.stat-row { height: 72rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 24rpx 0 12rpx; box-sizing: border-box; }
.stat-row + .stat-row { border-top: 3rpx solid #A7B978; }
.stat-leading { display: flex; align-items: center; gap: 16rpx; }
.stat-icon { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid; border-radius: 50%; box-sizing: border-box; color: #172018; font-size: 22rpx; font-weight: 600; }
.stat-icon--mbti { border-color: #8DA85D; background: #DDE9B8; }
.stat-icon--constellation { border-color: #BD7796; background: #F2D2DF; }
.stat-icon--birthday { border-color: #8176B5; background: #DDD9F2; }
.stat-label { font-size: 24rpx; font-weight: 600; color: #172018; }
.stat-value { max-width: 290rpx; overflow: hidden; color: #172018; font-size: 24rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.pager { width: 650rpx; margin: 28rpx auto 0; display: flex; gap: 18rpx; }
.pager-button { flex: 1; height: 82rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #CDD2CC; border-radius: 999rpx; background: #FFF; color: #3F5A47; font-size: 25rpx; }
.pager-button::after, .album-button::after { border: 0; }
.pager-button--primary { border-color: #3F5A47; background: #3F5A47; color: #FFF; }
.album-button { width: 650rpx; height: 76rpx; margin: 14rpx auto 0; background: transparent; color: #687069; font-size: 22rpx; }
.safe-space { height: calc(60rpx + env(safe-area-inset-bottom)); }
