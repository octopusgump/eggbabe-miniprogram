<view class="page">
  <nav-bar title="系统设置"></nav-bar>

  <scroll-view scroll-y class="content">

    <text class="section-label">通知设置</text>

    <view class="panel">
      <switch-row
        title="破壳提醒"
        desc="破壳日与即将破壳时提醒你"
        checked="{{notifs.hatch}}"
        bind:change="onToggleHatch"
      ></switch-row>
      <switch-row
        title="节令上新"
        desc="节气、节日或限定内容开放时提醒你"
        checked="{{notifs.seasonal}}"
        show-border="{{false}}"
        bind:change="onToggleSeasonal"
      ></switch-row>
    </view>

    <view class="hint-box">
      <text class="hint-text">当前预览版会在本机保存你的通知设置。正式消息推送仍需接入微信订阅消息并由服务端发送。</text>
    </view>

  </scroll-view>
</view>
