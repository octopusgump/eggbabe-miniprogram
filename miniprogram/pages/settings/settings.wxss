.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

.content {
  flex: 1;
  padding: 16rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  background: #FAFAF8;
  box-sizing: border-box;
}

.section-label {
  display: block;
  padding: 32rpx 40rpx 16rpx;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 22rpx;
  font-weight: 600;
  color: #5C5C5C;
  letter-spacing: 1.6rpx;
}

.panel {
  margin: 0 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid #E5E3DF;
  box-shadow: 0rpx 2rpx 4rpx rgba(0, 41, 0, 0.06), 0rpx 4rpx 8rpx rgba(0, 41, 0, 0.04);
}

.settings-list{overflow:hidden}.settings-row{min-height:104rpx;display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:0 28rpx;border-bottom:1rpx solid #ECEBE7;box-sizing:border-box}.settings-row:last-child{border-bottom:0}.settings-row__title,.settings-row__desc{display:block}.settings-row__title{color:#1A1A1A;font-size:27rpx}.settings-row__desc{margin-top:6rpx;color:#8C8C88;font-size:22rpx}.settings-row__chevron{color:#8C8C88;font-size:42rpx;font-weight:300}
