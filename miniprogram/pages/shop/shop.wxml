<view class="page">
  <nav-bar title="露珠商店"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view class="wallet">
      <view><text class="wallet-label">我的露珠</text><text class="wallet-value">{{balance}}</text></view>
      <view class="bag-link" bindtap="onOpenBag">查看背包 ›</view>
    </view>
    <view wx:if="{{!isDemo && !serverReady}}" class="server-note">正式账户正在连接服务器账本；同步完成后才可兑换。</view>
    <view class="principle-note">露珠只来自互动与运营活动。所有道具都只负责可爱，不增加战力或数值。</view>
    <view class="item-list">
      <view wx:for="{{items}}" wx:key="id" class="item-card">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-copy"><text class="item-category">{{item.categoryLabel}}</text><text class="item-name">{{item.name}}</text><text class="item-desc">{{item.description}}</text></view>
        <button class="buy-button" data-id="{{item.id}}" bindtap="onPurchase"><text class="button-label">{{item.price}} 露珠</text></button>
      </view>
    </view>
    <view class="safe-space"></view>
  </scroll-view>
</view>
