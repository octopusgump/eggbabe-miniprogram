.page { height: 100vh; overflow: hidden; background: #FAFAF8; }
.content { height: calc(100vh - 170rpx); padding: 28rpx 40rpx 0; box-sizing: border-box; }
.wallet { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; border-radius: 30rpx; background: linear-gradient(145deg, #FFF9D9, #F2F4E8); box-shadow: 0 14rpx 34rpx rgba(53, 72, 48, .08); }
.wallet-label, .wallet-value { display: block; }
.wallet-label { color: #7D795D; font-size: 21rpx; }
.wallet-value { margin-top: 4rpx; color: #3F5A47; font-size: 48rpx; font-weight: 600; }
.bag-link { min-height: 72rpx; display: flex; align-items: center; color: #3F5A47; font-size: 23rpx; }
.server-note, .principle-note { margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 22rpx; font-size: 21rpx; line-height: 1.6; }
.server-note { background: #FFF2DE; color: #8A622D; }
.principle-note { background: #EEF2EA; color: #667068; }
.item-list { display: grid; gap: 22rpx; margin-top: 28rpx; }
.item-card { display: grid; grid-template-columns: 88rpx 1fr auto; align-items: center; gap: 20rpx; padding: 24rpx; border-radius: 28rpx; background: #FFF; box-shadow: 0 10rpx 28rpx rgba(45, 65, 50, .06); }
.item-icon { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 26rpx; background: #F5F1D8; color: #526044; font-size: 38rpx; }
.item-copy { min-width: 0; }
.item-category, .item-name, .item-desc { display: block; }
.item-category { color: #99A092; font-size: 17rpx; }
.item-name { margin-top: 4rpx; color: #25332A; font-size: 26rpx; font-weight: 600; }
.item-desc { max-width: 310rpx; margin-top: 7rpx; color: #7E817A; font-size: 19rpx; line-height: 1.45; }
.buy-button { min-width: 118rpx; height: 66rpx; margin: 0; padding: 0 18rpx; border: 0; border-radius: 999rpx; background: #3F5A47; color: #FFF; font-size: 20rpx; line-height: 66rpx; }
.buy-button::after { border: 0; }
.safe-space { height: calc(80rpx + env(safe-area-inset-bottom)); }
