<view class="tomorrow-page">
  <nav-bar title="留给明天"></nav-bar>
  <scroll-view class="tomorrow-scroll" scroll-y>
    <view wx:if="{{debugMode}}" class="debug-panel">
      <view class="debug-panel__head">
        <text>开发验收</text>
        <text class="debug-panel__source">local fixture</text>
      </view>
      <text class="debug-panel__label">固定场景</text>
      <scroll-view class="debug-tabs" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="debug-tabs__row">
          <view
            wx:for="{{dayTypeOptions}}"
            wx:key="dayType"
            class="debug-tab {{selectedDayType === item.dayType ? 'debug-tab--active' : ''}}"
            data-day-type="{{item.dayType}}"
            aria-role="button"
            bindtap="onDayTypeTap"
          >{{item.ratioLabel}} · {{item.label}}</view>
        </view>
      </scroll-view>
      <text class="debug-panel__label debug-panel__label--state">页面状态</text>
      <view class="debug-state-tabs">
        <view
          wx:for="{{viewStateOptions}}"
          wx:key="value"
          class="debug-state-tab {{selectedViewState === item.value ? 'debug-state-tab--active' : ''}}"
          data-state="{{item.value}}"
          aria-role="button"
          bindtap="onViewStateTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="tomorrow-state" aria-live="polite">
      <view class="tomorrow-loader"></view>
      <text class="tomorrow-state__title">正在看看今天留下了什么</text>
    </view>

    <view wx:elif="{{empty}}" class="tomorrow-state" aria-live="polite">
      <view class="tomorrow-state__moon">☾</view>
      <text class="tomorrow-state__title">今天没有留下新的线索</text>
      <text class="tomorrow-state__copy">先回房间看看，晚一点再来。</text>
      <button class="tomorrow-state__button" hover-class="button-press" bindtap="onRetry"><text class="button-label">再看一下</text></button>
    </view>

    <view wx:elif="{{failed}}" class="tomorrow-state tomorrow-state--error" aria-live="polite">
      <view class="tomorrow-state__moon">⌁</view>
      <text class="tomorrow-state__title">刚才没有看清</text>
      <text class="tomorrow-state__copy">可以再看一次。</text>
      <button class="tomorrow-state__button" hover-class="button-press" bindtap="onRetry"><text class="button-label">重新看看</text></button>
    </view>

    <view wx:elif="{{scenario}}" class="tomorrow-content">
      <view class="tomorrow-scene">
        <image class="tomorrow-scene__image" src="{{scenario.image}}" mode="aspectFill"></image>
        <view class="tomorrow-scene__shade"></view>
      </view>

      <view class="tomorrow-sheet">
        <view class="tomorrow-sheet__handle"></view>
        <text class="tomorrow-sheet__eyebrow">今天，玉兔</text>
        <text class="tomorrow-sheet__title">{{scenario.title}}</text>
        <text class="tomorrow-sheet__line">{{scenario.todayLine}}</text>

        <view class="tomorrow-hint">
          <view class="tomorrow-hint__moon">☾</view>
          <view class="tomorrow-hint__body">
            <text class="tomorrow-hint__label">明天再来看</text>
            <text class="tomorrow-hint__copy">{{scenario.tomorrowHint}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
