.tomorrow-page{height:100vh;background:#F4F1E9;color:#28372D}
.tomorrow-scroll{height:calc(100vh - 158rpx);box-sizing:border-box;padding-bottom:calc(52rpx + env(safe-area-inset-bottom))}
.debug-panel{margin:24rpx 28rpx 0;padding:24rpx;border:1rpx solid #DDDCD4;border-radius:28rpx;background:#FFF}
.debug-panel__head{display:flex;align-items:center;justify-content:space-between;color:#28372D;font-size:23rpx;font-weight:600}
.debug-panel__source{padding:7rpx 12rpx;border-radius:999rpx;background:#EDF0E7;color:#647064;font-size:17rpx;font-weight:500;letter-spacing:1rpx}
.debug-panel__label{display:block;margin:20rpx 0 12rpx;color:#7A827B;font-size:19rpx}
.debug-panel__label--state{margin-top:18rpx}
.debug-tabs{width:100%;white-space:nowrap}
.debug-tabs__row{display:inline-flex;gap:10rpx;padding-right:8rpx}
.debug-tab{min-height:68rpx;display:flex;align-items:center;box-sizing:border-box;padding:0 20rpx;border-radius:999rpx;background:#EEECE4;color:#687369;font-size:19rpx}
.debug-tab--active{background:#294736;color:#FFF}
.debug-state-tabs{display:flex;gap:8rpx}
.debug-state-tab{min-height:68rpx;display:flex;flex:1;align-items:center;justify-content:center;border-radius:999rpx;background:#EEECE4;color:#687369;font-size:19rpx}
.debug-state-tab--active{background:#294736;color:#FFF}
.tomorrow-state{min-height:calc(100vh - 158rpx);display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:60rpx;flex-direction:column;text-align:center}
.tomorrow-loader{width:48rpx;height:48rpx;border:4rpx solid #D9D7CE;border-top-color:#294736;border-radius:50%;animation:tomorrow-spin .8s linear infinite}
.tomorrow-state__moon{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#ECEDE0;color:#60705E;font-size:42rpx}
.tomorrow-state--error .tomorrow-state__moon{background:#EEE5DC;color:#846E5D}
.tomorrow-state__title{display:block;margin-top:26rpx;color:#304136;font-size:32rpx;font-weight:600;line-height:1.45}
.tomorrow-state__copy{display:block;max-width:500rpx;margin-top:12rpx;color:#778078;font-size:23rpx;line-height:1.65}
.tomorrow-state__button{min-width:248rpx;height:88rpx;margin:28rpx 0 0;padding:0 30rpx;border:0;border-radius:999rpx;background:#294736;color:#FFF;font-size:23rpx;font-weight:600}
.tomorrow-state__button::after{border:0}
.tomorrow-content{padding:28rpx 28rpx 0}
.tomorrow-scene{position:relative;height:650rpx;overflow:hidden;border-radius:38rpx;background:#D9D8CC;box-shadow:0 18rpx 48rpx rgba(40,55,45,.13)}
.tomorrow-scene__image{width:100%;height:100%;display:block}
.tomorrow-scene__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(247,244,234,.03) 44%,rgba(34,41,35,.22) 100%)}
.tomorrow-sheet{position:relative;margin:-62rpx 18rpx 0;padding:20rpx 30rpx 32rpx;border:1rpx solid rgba(255,255,255,.64);border-radius:34rpx;background:rgba(250,249,245,.96);box-shadow:0 18rpx 44rpx rgba(43,47,40,.13);backdrop-filter:blur(18rpx)}
.tomorrow-sheet__handle{width:68rpx;height:6rpx;margin:0 auto 22rpx;border-radius:999rpx;background:#D9D7CE}
.tomorrow-sheet__eyebrow,.tomorrow-sheet__title,.tomorrow-sheet__line,.tomorrow-hint__label,.tomorrow-hint__copy{display:block}
.tomorrow-sheet__eyebrow{color:#7D887E;font-size:20rpx;letter-spacing:2rpx}
.tomorrow-sheet__title{margin-top:8rpx;color:#28372D;font-size:36rpx;font-weight:600;line-height:1.35;overflow-wrap:anywhere}
.tomorrow-sheet__line{margin-top:14rpx;color:#58665D;font-size:25rpx;line-height:1.7;overflow-wrap:anywhere}
.tomorrow-hint{display:flex;align-items:flex-start;gap:18rpx;margin-top:26rpx;padding:22rpx;border:1rpx solid rgba(87,108,90,.11);border-radius:24rpx;background:#ECEDE0}
.tomorrow-hint__moon{width:52rpx;height:52rpx;display:flex;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#FFF;color:#60705E;font-size:30rpx;box-shadow:0 7rpx 16rpx rgba(64,75,63,.08)}
.tomorrow-hint__body{display:flex;min-width:0;flex:1;flex-direction:column}
.tomorrow-hint__label{color:#899287;font-size:18rpx;letter-spacing:2rpx}
.tomorrow-hint__copy{margin-top:6rpx;color:#526056;font-size:24rpx;line-height:1.6;overflow-wrap:anywhere}
@keyframes tomorrow-spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.tomorrow-loader{animation:none}}
