.tomorrow-review-page{height:100vh;background:#F6F5EF;color:#1A1A1A}
.tomorrow-review-scroll{height:calc(100vh - 158rpx);padding:28rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.tomorrow-review-intro,.tomorrow-review-section,.tomorrow-review-state,.tomorrow-review-card,.tomorrow-review-boundary{border:1rpx solid #E5E3DF;background:#FFF;border-radius:30rpx}
.tomorrow-review-intro{padding:32rpx}
.tomorrow-review-intro__kicker,.tomorrow-review-intro__title,.tomorrow-review-intro__copy,.tomorrow-review-notice__strong,.tomorrow-review-notice__copy,.tomorrow-review-section__label,.tomorrow-review-tab__ratio,.tomorrow-review-tab__name,.tomorrow-review-state__title,.tomorrow-review-state__copy,.tomorrow-review-scene__context,.tomorrow-review-scene__type,.tomorrow-review-card__eyebrow,.tomorrow-review-card__title,.tomorrow-review-card__line,.tomorrow-review-hint__label,.tomorrow-review-hint__copy,.tomorrow-review-guidance__label,.tomorrow-review-guidance__copy,.tomorrow-review-boundary__label,.tomorrow-review-boundary__source{display:block}
.tomorrow-review-intro__kicker{color:#8C8C88;font-size:18rpx;letter-spacing:2rpx}
.tomorrow-review-intro__title{margin-top:12rpx;color:#002900;font-size:40rpx;font-weight:600;line-height:1.25}
.tomorrow-review-intro__copy{margin-top:14rpx;color:#5C5C5C;font-size:23rpx;line-height:1.65}
.tomorrow-review-notice{margin-top:24rpx;padding:22rpx 24rpx;border-radius:22rpx;background:#FAFAEF}
.tomorrow-review-notice__strong{color:#6E6B35;font-size:22rpx;font-weight:600;line-height:1.5}
.tomorrow-review-notice__copy{margin-top:8rpx;color:#6E6B35;font-size:20rpx;line-height:1.6}
.tomorrow-review-section{margin-top:18rpx;padding:24rpx}
.tomorrow-review-section__label{margin-bottom:16rpx;color:#5C5C5C;font-size:20rpx;font-weight:600}
.tomorrow-review-tabs{width:100%;white-space:nowrap}
.tomorrow-review-tabs__row{display:inline-flex;gap:12rpx;padding-right:10rpx}
.tomorrow-review-tab{min-width:176rpx;min-height:96rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12rpx 18rpx;border:1rpx solid #E5E3DF;border-radius:999rpx;background:#FAFAF8;color:#5C5C5C}
.tomorrow-review-tab--active{border-color:#C9D8A2;background:#F5F8ED;color:#002900}
.tomorrow-review-tab__ratio{font-size:23rpx;font-weight:600;line-height:1.25}
.tomorrow-review-tab__name{margin-top:5rpx;font-size:18rpx;line-height:1.3}
.tomorrow-review-state-tabs{display:flex;gap:10rpx}
.tomorrow-review-state-tab{min-height:80rpx;display:flex;flex:1;align-items:center;justify-content:center;border:1rpx solid #E5E3DF;border-radius:999rpx;background:#FAFAF8;color:#5C5C5C;font-size:20rpx}
.tomorrow-review-state-tab--active{border-color:#002900;background:#002900;color:#FFF}
.tomorrow-review-state{min-height:430rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;margin-top:18rpx;padding:48rpx;text-align:center}
.tomorrow-review-loader{width:48rpx;height:48rpx;border:4rpx solid #E5E3DF;border-top-color:#002900;border-radius:50%;animation:tomorrow-review-spin .8s linear infinite}
.tomorrow-review-state__symbol{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#F5F8ED;color:#54632C;font-size:36rpx}
.tomorrow-review-state--error .tomorrow-review-state__symbol{background:#FDECEA;color:#D9463C}
.tomorrow-review-state__title{margin-top:24rpx;color:#1A1A1A;font-size:28rpx;font-weight:600;line-height:1.45}
.tomorrow-review-state__copy{max-width:500rpx;margin-top:12rpx;color:#5C5C5C;font-size:21rpx;line-height:1.65}
.tomorrow-review-state__button{min-width:280rpx;height:88rpx;margin:28rpx 0 0;padding:0 30rpx;border:0;border-radius:999rpx;background:#002900;color:#FFF;font-size:23rpx;font-weight:600}
.tomorrow-review-state__button::after{border:0}
.tomorrow-review-content{margin-top:18rpx}
.tomorrow-review-scene{position:relative;height:520rpx;overflow:hidden;border-radius:34rpx;background:#DDE5D9;box-shadow:0 18rpx 48rpx rgba(0,41,0,.12)}
.tomorrow-review-scene__image{width:100%;height:100%}
.tomorrow-review-scene__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,18,12,.04),rgba(8,18,12,.72))}
.tomorrow-review-scene__meta{position:absolute;left:28rpx;right:28rpx;bottom:26rpx}
.tomorrow-review-scene__context{color:#FFF;font-size:30rpx;font-weight:600;line-height:1.35}
.tomorrow-review-scene__type{margin-top:8rpx;color:rgba(255,255,255,.74);font-size:18rpx;line-height:1.4}
.tomorrow-review-card{margin-top:16rpx;padding:30rpx}
.tomorrow-review-card__eyebrow,.tomorrow-review-hint__label,.tomorrow-review-guidance__label{color:#8C8C88;font-size:18rpx;font-weight:600;letter-spacing:1rpx}
.tomorrow-review-card__title{margin-top:10rpx;color:#1A1A1A;font-size:32rpx;font-weight:600;line-height:1.4;overflow-wrap:anywhere}
.tomorrow-review-card__line{margin-top:14rpx;color:#5C5C5C;font-size:22rpx;line-height:1.7;overflow-wrap:anywhere}
.tomorrow-review-hint{margin-top:26rpx;padding:24rpx;border-radius:24rpx;background:#F5F8ED}
.tomorrow-review-hint__label{color:#54632C}
.tomorrow-review-hint__copy{margin-top:10rpx;color:#314227;font-size:24rpx;line-height:1.65;overflow-wrap:anywhere}
.tomorrow-review-guidance{margin-top:18rpx;padding-top:20rpx;border-top:1rpx solid #E5E3DF}
.tomorrow-review-guidance__copy{margin-top:9rpx;color:#5C5C5C;font-size:20rpx;line-height:1.6;overflow-wrap:anywhere}
.tomorrow-review-boundary{margin-top:16rpx;padding:26rpx}
.tomorrow-review-boundary__label{color:#5C5C5C;font-size:20rpx;font-weight:600}
.tomorrow-review-boundary__chips{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}
.tomorrow-review-boundary__chips text{padding:10rpx 16rpx;border-radius:999rpx;background:#FAFAEF;color:#6E6B35;font-size:18rpx;line-height:1.4}
.tomorrow-review-boundary__source{margin-top:20rpx;color:#8C8C88;font-size:18rpx;line-height:1.5}
@keyframes tomorrow-review-spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.tomorrow-review-loader{animation:none}}
